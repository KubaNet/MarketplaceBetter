@using MarketplaceBetter.Services.Domain.Sales.InputData.Interfaces;
@using MarketplaceBetter.Domain.Model.Sales.InputData;
@using MarketplaceBetter.Services.Domain.Sales.Invoicing.Interfaces;
@using MarketplaceBetter.Services.Model;
@using System.Threading

@page "/fulfilled-shipments"
<PageTitle>Fulfilled Shipments</PageTitle>

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IFulfilledShipmentService FulfilledShipmentService
@inject IInvoiceService InvoiceService

<MudText Typo="Typo.h4" Class="mt-2">Fulfilled Shipments</MudText>

<MainBody>
    <MudTable T="FulfilledShipmentModel" @ref="Table" ServerData="@(new Func<TableState, CancellationToken, Task<TableData<FulfilledShipmentModel>>>(Reload))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="Process" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ArrowForwardIos" Color="Color.Info" Disabled="NoneSelected" Class="ml-2">Process</MudButton>
            <MudButton OnClick="DownloadSalesReport" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Secondary" Class="ml-2">Download Sales Report</MudButton>
            <MudButton OnClick="AddFromFile" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add from file</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="FulfilledShipmentModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="invoice" T="FulfilledShipmentModel">Invoice</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="error" T="FulfilledShipmentModel">Error</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="amazon_order_id" T="FulfilledShipmentModel">Amazon Order Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="shipment_item_id" T="FulfilledShipmentModel">Shipment Item Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="amazon_order_item_id" T="FulfilledShipmentModel">Amazon Order Item Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="payments_date" T="FulfilledShipmentModel">Payments Date</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="merchant_sku" T="FulfilledShipmentModel">Merchant Sku</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="title" T="FulfilledShipmentModel">Title</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="dispatched_quantity" T="FulfilledShipmentModel">Dispatched Quantity</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="currency" T="FulfilledShipmentModel">Currency</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="item_price" T="FulfilledShipmentModel">Item Price</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="item_tax" T="FulfilledShipmentModel">Item Tax</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="delivery_price" T="FulfilledShipmentModel">Delivery Price</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="deliver_tax" T="FulfilledShipmentModel">Delivery Tax</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="gift_wrap_price" T="FulfilledShipmentModel">Gift Wrap Price</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="gift_wrapping_tax" T="FulfilledShipmentModel">Gift Wrapping Tax</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="item_promo_discount" T="FulfilledShipmentModel">Item Promo Discount</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="shipment_promo_discount" T="FulfilledShipmentModel">Shipment Promo Discount</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="recipient_name" T="FulfilledShipmentModel">Recipient Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="delivery_address_1" T="FulfilledShipmentModel">Delivery Address 1</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="delivery_address_2" T="FulfilledShipmentModel">Delivery Address 2</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="delivery_address_3" T="FulfilledShipmentModel">Delivery Address 3</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="delivery_city_town" T="FulfilledShipmentModel">Delivery City Town</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="delivery_county" T="FulfilledShipmentModel">Delivery County</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="delivery_postcode" T="FulfilledShipmentModel">Delivery Postcode</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="delivery_country" T="FulfilledShipmentModel">Delivery Country</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="fc" T="FulfilledShipmentModel">FC</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Invoice">
                @if (context.Invoice != null)
                {
                    <MudLink Href="@string.Concat("/invoices?SearchString=Id: ", context.Invoice.Id)" Underline="Underline.None" Color="Color.Info">Invoice Id: @context.Invoice.Id</MudLink>
                }
                else if (!context.IsInvoiceable)
                {
                    <MudAlert Severity="Severity.Info">Not invoiceable</MudAlert>
                }
            </MudTd>
            <MudTd DataLabel="Error">
                @if (context.Error != null)
                {
                    <MudAlert Severity="Severity.Error">@context.Error</MudAlert>                    
                }
            </MudTd>
            <MudTd DataLabel="Amazon Order Id">@context.AmazonOrderId</MudTd>
            <MudTd DataLabel="Shipment Item Id">@context.ShipmentItemId</MudTd>
            <MudTd DataLabel="Amazon Order Item Id">@context.AmazonOrderItemId</MudTd>
            <MudTd DataLabel="payments_date">@context.PaymentsDate</MudTd>
            <MudTd DataLabel="Merchant Sku">@context.MerchantSku</MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Dispatched Quantity">@context.DispatchedQuantity</MudTd>
            <MudTd DataLabel="Currency">@context.Currency.Name</MudTd>
            <MudTd DataLabel="Item Price">@context.ItemPrice</MudTd>
            <MudTd DataLabel="Item Tax">@context.ItemTax</MudTd>
            <MudTd DataLabel="Delivery Price">@context.DeliveryPrice</MudTd>
            <MudTd DataLabel="Delivery Tax">@context.DeliveryTax</MudTd>
            <MudTd DataLabel="Gift Wrap Price">@context.GiftWrapPrice</MudTd>
            <MudTd DataLabel="Gift Wrapping Tax">@context.GiftWrappingTax</MudTd>
            <MudTd DataLabel="Item Promo Discount">@context.ItemPromoDiscount</MudTd>
            <MudTd DataLabel="Shipment Promo Discount">@context.ShipmentPromoDiscount</MudTd>
            <MudTd DataLabel="Recipient Name">@context.RecipientName</MudTd>
            <MudTd DataLabel="Delivery Address 1">@context.DeliveryAddress1</MudTd>
            <MudTd DataLabel="Delivery Address 2">@context.DeliveryAddress2</MudTd>
            <MudTd DataLabel="Delivery Address 3">@context.DeliveryAddress3</MudTd>
            <MudTd DataLabel="Delivery City Town">@context.DeliveryCityTown</MudTd>
            <MudTd DataLabel="Delivery County">@context.DeliveryCounty</MudTd>
            <MudTd DataLabel="Delivery Postcode">@context.DeliveryPostcode</MudTd>
            <MudTd DataLabel="Delivery Country">@context.DeliveryCountry.Code</MudTd>
            <MudTd DataLabel="FC">@context.FC</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

    private MudTable<FulfilledShipmentModel> Table;
    private ListRequest ListRequest = new();

    private HashSet<FulfilledShipmentModel> SelectedShipments = new HashSet<FulfilledShipmentModel>();
    private bool NoneSelected = true;
    private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
    }

    private Task<TableData<FulfilledShipmentModel>> Reload(TableState state, CancellationToken token)
    {
        Table.SelectedItems = null;

        state.PopulateListRequest(ListRequest);

        IList<FulfilledShipmentModel> shipments = FulfilledShipmentService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<FulfilledShipmentModel>() { TotalItems = FulfilledShipmentService.CountForListRequest(ListRequest), Items = shipments });
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        CurrentRowsPerPageValue = rowsPerPage;
    }

    private void Filter(string searchString)
    {
        ListRequest.SearchString = searchString;

        string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
        Navigation.NavigateTo(newUrl, replace: true);

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddFromFile()
    {
        DialogResult result = await DialogService.Show<FulfilledShipmentsFromFileDialog>().Result;

        ProcessDialogResult(result);
    }

    private void DownloadSalesReport()
    {
        DialogService.Show<DownloadSalesReportDialog>();
    }

    private void ProcessDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }

    private void OnSelectedItemsChanged(HashSet<FulfilledShipmentModel> selectedShipments)
    {
        SelectedShipments = selectedShipments;

        if (SelectedShipments.Any())
        {
            NoneSelected = false;
        }
        else
        {
            NoneSelected = true;
        }
    }

    private void Process()
    {
        InvoiceService.Create(SelectedShipments.ToList());

        Snackbar.AddSuccess("Fulfilled Shipments were processed. See Invoice column to check if all invoices were created.");

        Table.ReloadServerData();
    }
}
