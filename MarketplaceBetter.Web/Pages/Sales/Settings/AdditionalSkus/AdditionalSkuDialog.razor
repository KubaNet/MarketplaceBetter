@using MarketplaceBetter.Domain.Model.Catalog.Products;
@using MarketplaceBetter.Domain.Model.Sales.Settings;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces;
@using MarketplaceBetter.Services.Domain.Sales.Settings.Interfaces;
@using MarketplaceBetter.Services.Validation.Sales.Settings.Interfaces;
@using System.Threading

@inject ISnackbar Snackbar
@inject IAdditionalSkuService AdditionalSkuService
@inject IAdditionalSkuValidator AdditionalSkuValidator
@inject IVariantService VariantService

<EditForm Model="AdditionalSku" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudAutocomplete T="VariantModel" Label="Variant" @bind-Value="AdditionalSku.Variant" For="() => AdditionalSku.Variant" ResetValueOnEmptyText="true" SearchFunc="SearchVariants" />
        <MudTextField Label="SKU" @bind-Value="AdditionalSku.Sku" For="() => AdditionalSku.Sku" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long AdditionalSkuId { get; set; }

    private CustomValidation CustomValidation = new();
    private AdditionalSkuModel AdditionalSku = new();

    private IList<VariantModel> Variants;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Variants = VariantService.GetAll();
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = AdditionalSkuValidator.Validate(AdditionalSku);

        if (result.IsValid)
        {
            AdditionalSkuService.Add(AdditionalSku);

            Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Additional SKU"));

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }

    private async Task<IEnumerable<VariantModel>> SearchVariants(string search, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return Variants;
        }

        string[] searchParts = search.Split(' ');

        IList<VariantModel> foundVariants = new List<VariantModel>(Variants);
        foreach (var searchPart in searchParts)
        {
            foundVariants = foundVariants.Where(v => v.Sku.Contains(searchPart, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        return foundVariants;
    }
}