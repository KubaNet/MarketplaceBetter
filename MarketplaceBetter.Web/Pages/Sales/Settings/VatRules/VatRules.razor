@using MarketplaceBetter.Domain.Model.Sales.Settings;
@using MarketplaceBetter.Services.Domain.Sales.Settings.Interfaces;
@using MarketplaceBetter.Services.Model
@using System.Threading

@page "/vat-rules"
<PageTitle>Vat Rules</PageTitle>

@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IVatRuleService VatRuleService

<MudText Typo="Typo.h4" Class="mt-2">Vat Rules</MudText>

<MainBody>
	<MudTable T="VatRuleModel" @ref="Table" ServerData="@(new Func<TableState, CancellationToken, Task<TableData<VatRuleModel>>>(Reload))" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
		<ToolBarContent>
			<MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
			<MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Vat Rule</MudButton>
		</ToolBarContent>
		<HeaderContent>
			<MudTh><MudTableSortLabel SortLabel="id" T="VatRuleModel">Id</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="country_from" T="VatRuleModel">Country From</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="country_to" T="VatRuleModel">Country To</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="vat_value" T="VatRuleModel">Vat Value</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="vat_number" T="VatRuleModel">Vat Number</MudTableSortLabel></MudTh>
			<MudTh Style="width: 100px;">Actions</MudTh>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="Id">@context.Id</MudTd>
			<MudTd DataLabel="Country From">@context.CountryFrom.Name (@context.CountryFrom.Code)</MudTd>
			<MudTd DataLabel="Country To">@context.CountryTo.Name (@context.CountryTo.Code)</MudTd>
			<MudTd DataLabel="Vat Value">@context.VatValue %</MudTd>
			<MudTd DataLabel="Vat Number">@context.VatNumber</MudTd>
			<MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Edit(context.Id))">Edit</MudButton></MudTd>
		</RowTemplate>
		<PagerContent>
			<MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
		</PagerContent>
	</MudTable>
</MainBody>

@code {
	[Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

	private MudTable<VatRuleModel> Table;
	private ListRequest ListRequest = new();

	private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		ProcessQueryParameters();		
	}

	private void ProcessQueryParameters()
	{
		if (!String.IsNullOrWhiteSpace(SearchString))
		{
			ListRequest.SearchString = SearchString;
		}
	}

	private Task<TableData<VatRuleModel>> Reload(TableState state, CancellationToken token)
	{
		Table.SelectedItems = null;

		state.PopulateListRequest(ListRequest);

		IList<VatRuleModel> rules = VatRuleService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<VatRuleModel>() { TotalItems = VatRuleService.CountForListRequest(ListRequest), Items = rules });
	}

	private void OnRowsPerPageChanged(int rowsPerPage)
	{
		CurrentRowsPerPageValue = rowsPerPage;
	}

	private void Filter(string searchString)
	{
		ListRequest.SearchString = searchString;

		string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
		Navigation.NavigateTo(newUrl, replace: true);

		Table.ReloadServerData();

		StateHasChanged();
	}

	private async void Add()
	{
		DialogResult result = await DialogService.Show<VatRuleDialog>(null, new DialogParameters { ["Title"] = "Add Vat Rule" }).Result;

		ProcessDialogResult(result);
	}

	private async void Edit(long id)
	{
		DialogResult result = await DialogService.Show<VatRuleDialog>(null, new DialogParameters { ["Title"] = "Edit Vat Rule", ["IsEdit"] = true, ["VatRuleId"] = id }).Result;

		ProcessDialogResult(result);
	}

	private void ProcessDialogResult(DialogResult result)
	{
		if (!result.Canceled)
		{
			Table.ReloadServerData();
		}
	}
}
