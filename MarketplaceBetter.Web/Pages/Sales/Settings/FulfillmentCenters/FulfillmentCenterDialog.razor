@using MarketplaceBetter.Domain.Model.Base;
@using MarketplaceBetter.Domain.Model.Sales.Settings;
@using MarketplaceBetter.Services.Domain.Base.Interfaces;
@using MarketplaceBetter.Services.Domain.Sales.Settings.Interfaces;
@using MarketplaceBetter.Services.Validation.Sales.Settings.Interfaces;

@inject ISnackbar Snackbar
@inject IFulfillmentCenterService FulfillmentCenterService
@inject IFulfillmentCenterValidator FulfillmentCenterValidator
@inject ICountryService CountryService

<EditForm Model="FulfillmentCenter" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudTextField Label="Code" @bind-Value="FulfillmentCenter.Code" For="() => FulfillmentCenter.Code" />
        <MudSelect Label="Country" T="CountryModel" @bind-Value="FulfillmentCenter.Country" For="() => FulfillmentCenter.Country">
            @foreach (var country in Countries)
            {
                <MudSelectItem Value="country">@country.Name (@country.Code)</MudSelectItem>
            }
        </MudSelect>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long FulfillmentCenterId { get; set; }

    private CustomValidation CustomValidation = new();
    private FulfillmentCenterModel FulfillmentCenter = new();

    private IList<CountryModel> Countries;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Countries = CountryService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        FulfillmentCenter = FulfillmentCenterService.Get(FulfillmentCenterId);
        FulfillmentCenter.Country = Countries.Single(b => b.Id == FulfillmentCenter.Country.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = FulfillmentCenterValidator.Validate(FulfillmentCenter);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                FulfillmentCenterService.Update(FulfillmentCenter);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Fulfillment Center"));
            }
            else
            {
                FulfillmentCenterService.Add(FulfillmentCenter);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Fulfillment Center"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}