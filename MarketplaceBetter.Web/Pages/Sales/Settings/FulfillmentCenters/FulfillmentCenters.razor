@using MarketplaceBetter.Domain.Model.Sales.Settings;
@using MarketplaceBetter.Services.Domain.Sales.Settings.Interfaces;
@using MarketplaceBetter.Services.Model

@page "/fulfillment-centers"

@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IFulfillmentCenterService FulfillmentCenterService

<MudText Typo="Typo.h4" Class="mt-2">Fulfillment Centers</MudText>

<MainBody>
	<MudTable T="FulfillmentCenterModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<FulfillmentCenterModel>>>(Reload))" MultiSelection="true" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
		<ToolBarContent>
			<MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
			<MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Fulfillment Center</MudButton>
		</ToolBarContent>
		<HeaderContent>
			<MudTh><MudTableSortLabel SortLabel="id" T="FulfillmentCenterModel">Id</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="code" T="FulfillmentCenterModel">Code</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="country" T="FulfillmentCenterModel">Country</MudTableSortLabel></MudTh>
			<MudTh Style="width: 100px;">Actions</MudTh>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="Id">@context.Id</MudTd>
			<MudTd DataLabel="Code">@context.Code</MudTd>
			<MudTd DataLabel="Country">@context.Country.Name</MudTd>
			<MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Edit(context.Id))">Edit</MudButton></MudTd>
		</RowTemplate>
		<PagerContent>
			<MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
		</PagerContent>
	</MudTable>
</MainBody>

@code {
	[Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

	private MudTable<FulfillmentCenterModel> Table;
	private ListRequest ListRequest = new();

	private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		ProcessQueryParameters();		
	}

	private void ProcessQueryParameters()
	{
		if (!String.IsNullOrWhiteSpace(SearchString))
		{
			ListRequest.SearchString = SearchString;
		}
	}

	private Task<TableData<FulfillmentCenterModel>> Reload(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<FulfillmentCenterModel> centers = FulfillmentCenterService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<FulfillmentCenterModel>() { TotalItems = FulfillmentCenterService.CountForListRequest(ListRequest), Items = centers });
	}

	private void OnRowsPerPageChanged(int rowsPerPage)
	{
		CurrentRowsPerPageValue = rowsPerPage;
	}

	private void Filter(string searchString)
	{
		ListRequest.SearchString = searchString;

		string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
		Navigation.NavigateTo(newUrl, replace: true);

		Table.ReloadServerData();

		StateHasChanged();
	}

	private async void Add()
	{
		DialogResult result = await DialogService.Show<FulfillmentCenterDialog>(null, new DialogParameters { ["Title"] = "Add Fulfillment Center" }).Result;

		ProcessDialogResult(result);
	}

	private async void Edit(long id)
	{
		DialogResult result = await DialogService.Show<FulfillmentCenterDialog>(null, new DialogParameters { ["Title"] = "Edit Fulfillment Center", ["IsEdit"] = true, ["FulfillmentCenterId"] = id }).Result;

		ProcessDialogResult(result);
	}

	private void ProcessDialogResult(DialogResult result)
	{
		if (!result.Canceled)
		{
			Table.ReloadServerData();
		}
	}
}
