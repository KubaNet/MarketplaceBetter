@using MarketplaceBetter.Domain.Model.Sales.Settings;
@using MarketplaceBetter.Services.Domain.Sales.Settings.Interfaces;
@using MarketplaceBetter.Services.Model

@page "/products-accounting-data"
<PageTitle>Products Accounting Data</PageTitle>

@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IProductAccountingDataService ProductAccountingDataService

<MudText Typo="Typo.h4" Class="mt-2">Products Accounting Data</MudText>

<MainBody>
	<MudTable T="ProductAccountingDataModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ProductAccountingDataModel>>>(Reload))" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
		<ToolBarContent>
			<MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
			<MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Accounting Data</MudButton>
		</ToolBarContent>
		<HeaderContent>
			<MudTh><MudTableSortLabel SortLabel="id" T="ProductAccountingDataModel">Id</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="product" T="ProductAccountingDataModel">Product</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="invoice_name" T="ProductAccountingDataModel">Invoice Name</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="commodity_code" T="ProductAccountingDataModel">Commodity Code</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="weight" T="ProductAccountingDataModel">Weight</MudTableSortLabel></MudTh>
			<MudTh>Costs</MudTh>
			<MudTh Style="width: 100px;">Actions</MudTh>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="Id">@context.Id</MudTd>
			<MudTd DataLabel="Product">@context.Product.Name</MudTd>
			<MudTd DataLabel="Invoice Name">@context.InvoiceName</MudTd>
			<MudTd DataLabel="Commodity Code">@context.CommodityCode</MudTd>
			<MudTd DataLabel="Weight">@context.Weight kg</MudTd>
			<MudTd DataLabel="Costs">
				@foreach (var cost in context.ProductionCosts)
				{
					<br />@string.Format("{0:N} {1}", cost.Cost, cost.Currency.Name)
				}
			</MudTd>
			<MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Edit(context.Id))">Edit</MudButton></MudTd>
		</RowTemplate>
		<PagerContent>
			<MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
		</PagerContent>
	</MudTable>
</MainBody>

@code {
	[Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

	private MudTable<ProductAccountingDataModel> Table;
	private ListRequest ListRequest = new();

	private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		ProcessQueryParameters();		
	}

	private void ProcessQueryParameters()
	{
		if (!String.IsNullOrWhiteSpace(SearchString))
		{
			ListRequest.SearchString = SearchString;
		}
	}

	private Task<TableData<ProductAccountingDataModel>> Reload(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<ProductAccountingDataModel> centers = ProductAccountingDataService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<ProductAccountingDataModel>() { TotalItems = ProductAccountingDataService.CountForListRequest(ListRequest), Items = centers });
	}

	private void OnRowsPerPageChanged(int rowsPerPage)
	{
		CurrentRowsPerPageValue = rowsPerPage;
	}

	private void Filter(string searchString)
	{
		ListRequest.SearchString = searchString;

		string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
		Navigation.NavigateTo(newUrl, replace: true);

		Table.ReloadServerData();

		StateHasChanged();
	}

	private async void Add()
	{
		DialogResult result = await DialogService.Show<ProductAccountingDataDialog>(null, new DialogParameters { ["Title"] = "Add Product Accounting Data" }).Result;

		ProcessDialogResult(result);
	}

	private async void Edit(long id)
	{
		DialogResult result = await DialogService.Show<ProductAccountingDataDialog>(null, new DialogParameters { ["Title"] = "Edit Product Accounting Data", ["IsEdit"] = true, ["ProductAccountingDataId"] = id }).Result;

		ProcessDialogResult(result);
	}

	private void ProcessDialogResult(DialogResult result)
	{
		if (!result.Canceled)
		{
			Table.ReloadServerData();
		}
	}
}
