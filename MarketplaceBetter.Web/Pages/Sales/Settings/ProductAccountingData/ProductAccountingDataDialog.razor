@using MarketplaceBetter.Domain.Model.Catalog.Products;
@using MarketplaceBetter.Domain.Model.Sales.Settings;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces;
@using MarketplaceBetter.Services.Domain.Sales.Settings.Interfaces;
@using MarketplaceBetter.Services.Validation.Catalog.Attributes.Interfaces;
@using MarketplaceBetter.Services.Validation.Sales.Settings.Interfaces;

@inject ISnackbar Snackbar
@inject IProductAccountingDataService ProductAccountingDataService
@inject IProductAccountingDataValidator ProductAccountingDataValidator
@inject IProductService ProductService

<EditForm Model="ProductAccountingData" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudSelect Label="Product" T="ProductModel" @bind-Value="ProductAccountingData.Product" For="() => ProductAccountingData.Product">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name (@product.Code)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Invoice Name" @bind-Value="ProductAccountingData.InvoiceName" For="() => ProductAccountingData.InvoiceName" />
        <MudTextField Label="Commodity Code" @bind-Value="ProductAccountingData.CommodityCode" For="() => ProductAccountingData.CommodityCode" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long ProductAccountingDataId { get; set; }

    private CustomValidation CustomValidation = new();
    private ProductAccountingDataModel ProductAccountingData = new();

    private IList<ProductModel> Products;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Products = ProductService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        ProductAccountingData = ProductAccountingDataService.Get(ProductAccountingDataId);
        ProductAccountingData.Product = Products.Single(b => b.Id == ProductAccountingData.Product.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ProductAccountingDataValidator.Validate(ProductAccountingData);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ProductAccountingDataService.Update(ProductAccountingData);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Product Accounting Data"));
            }
            else
            {
                ProductAccountingDataService.Add(ProductAccountingData);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Product Accounting Data"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}