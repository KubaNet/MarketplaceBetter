@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Validation.Catalog.Interfaces

@inject ISizeService SizeService
@inject ISizeGroupService GroupService
@inject ISizeValidator SizeValidator
@inject ISnackbar Snackbar

<EditForm Model="Size" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudTextField Label="Name" @bind-Value="Size.Name" For="() => Size.Name" />
        <MudTextField Label="Code" @bind-Value="Size.Code" For="() => Size.Code" />
        <MudSelect Label="Group" T="SizeGroupModel" @bind-Value="Size.Group" For="() => Size.Group">
            @foreach (var group in Groups)
            {
                <MudSelectItem Value="group">@group.Name</MudSelectItem>
            }
        </MudSelect>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long SizeId { get; set; }

    CustomValidation CustomValidation = new();
    SizeModel Size = new();
    IList<SizeGroupModel> Groups;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Groups = GroupService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        Size = SizeService.Get(SizeId);
        Size.Group = Groups.Single(g => g.Id == Size.Group.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = SizeValidator.Validate(Size);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                SizeService.Update(Size);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Size"));
            }
            else
            {
                SizeService.Add(Size);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Size"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}