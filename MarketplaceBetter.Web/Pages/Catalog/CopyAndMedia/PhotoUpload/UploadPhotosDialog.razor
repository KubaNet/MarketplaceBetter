@using System.IO;
@using MarketplaceBetter.Domain.Model.Catalog.CopyAndMedia;
@using MarketplaceBetter.Services.Domain.Catalog.CopyAndMedia.Interfaces;
@using MarketplaceBetter.Services.Model;
@using MarketplaceBetter.Specialized.Interfaces;

@inject IPhotoCloudService PhotoCloudService
@inject IPhotoUploadService PhotoUploadService
@inject ISnackbar Snackbar

<MudDialog Style="min-width: 800px;">
    <TitleContent>
        <MudText Typo="Typo.h6">Add photo files to upload</MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="@ProgressDisplayClass">
            <MudProgressLinear Value="CurrentProgressValue" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.body1" Class="ma-4" Align="Align.Center">Uploading file @CurrentFileName</MudText>
        </MudContainer>
        <MudContainer Class="@IncorrectFilesClass">
            <MudText Typo="Typo.body2" Color="Color.Error">There are files with incorrect type (not .jpg or .png). They will not be uploaded.</MudText>
        </MudContainer>
        <MudContainer Style="max-height: 550px; overflow-y: scroll">
            <MudStack Style="width: 100%;">
                <MudFileUpload @ref="MudFileUpload" T="IReadOnlyList<IBrowserFile>" OnFilesChanged="OnInputFileChanged" MaximumFileCount="500" Hidden="false" Class="flex-1" InputClass="absolute mud-width-full mud-height-full overflow-hidden z-20" InputStyle="opacity:0"
                               @ondragenter="SetDragClass" @ondragleave="ClearDragClass" @ondragend="ClearDragClass">
                    <ButtonTemplate>
                        <MudPaper MinHeight="400px" Outlined="true" Class="@DragClass">
                            <MudText Typo="Typo.h6">Drag and drop files here or click</MudText>
                            @foreach (var fileName in FileNames)
                            {
                                <MudChip Color="IsCorrectFileType(fileName) ? Color.Dark : Color.Error" Text="@fileName" />
                            }
                        </MudPaper>
                    </ButtonTemplate>
                </MudFileUpload>
            </MudStack>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="ButtonsDisabled">Cancel</MudButton>
        <MudButton OnClick="Upload" Disabled="ButtonsDisabled || !FileNames.Any()" Color="Color.Primary" Variant="Variant.Filled">Upload</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }

    private MudFileUpload<IReadOnlyList<IBrowserFile>> MudFileUpload;
    private const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mud-width-full mud-height-full z-10";
    private string DragClass = DefaultDragClass;
    private IList<string> FileNames = new List<string>();

    private bool ButtonsDisabled = false;
    private string ProgressDisplayClass = "d-none";
    private string IncorrectFilesClass = "d-none";
    private string CurrentFileName = string.Empty;
    private double CurrentProgressValue = 0;
    private double CorrectFileCount = 0;

    private void OnInputFileChanged(InputFileChangeEventArgs changeEvent)
    {
        ClearDragClass();

        var files = changeEvent.GetMultipleFiles(maximumFileCount: 500);
        foreach (var file in files)
        {
            FileNames.Add(file.Name);

            if (IsCorrectFileType(file.Name))
            {
                CorrectFileCount++;
            }
            else
            {
                IncorrectFilesClass = "d-block";
            }
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async void Upload()
    {
        double progressStep = 100 / CorrectFileCount;
        ButtonsDisabled = true;
        ProgressDisplayClass = "d-block";

        foreach (var file in MudFileUpload.Files)
        {
            if (!IsCorrectFileType(file.Name))
            {
                continue;
            }

            CurrentFileName = file.Name;
            CurrentProgressValue += progressStep;
            StateHasChanged();

            MemoryStream memoryStream = new MemoryStream();
            await file.OpenReadStream(Standard.UploadPhotoSizeLimit).CopyToAsync(memoryStream);
            memoryStream.Seek(0, SeekOrigin.Begin);

            PhotoUploadResult uploadResult = PhotoCloudService.PreUpload(memoryStream, file.Name);

            PhotoUploadModel photoUploadToAdd = new PhotoUploadModel()
            {
                FileName = file.Name,
                CloudId = uploadResult.CloudId,
                Url = uploadResult.Url,
                Height = uploadResult.Height,
                Width = uploadResult.Width
            };

            PhotoUploadService.Add(photoUploadToAdd);
        }

        MudDialog.Close();
    }

    private bool IsCorrectFileType(string fileName)
    {
        return fileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase);
    }

    private void SetDragClass()
    {
        DragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        DragClass = DefaultDragClass;
    }
}