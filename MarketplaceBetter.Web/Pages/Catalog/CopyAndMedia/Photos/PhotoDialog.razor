@using MarketplaceBetter.Domain.Constants
@using MarketplaceBetter.Domain.Model.Catalog.CopyAndMedia
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Catalog.CopyAndMedia.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Model
@using MarketplaceBetter.Services.Validation.Catalog.CopyAndMedia.Interfaces
@using System.IO
@using MarketplaceBetter.Specialized.Interfaces

@inject IPhotoService PhotoService
@inject IPhotoValidator PhotoValidator
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IVariantService VariantService
@inject IInstanceService InstanceService
@inject IPhotoTypeService PhotoTypeService
@inject IPhotoCloudService PhotoCloudService
@inject ISnackbar Snackbar

<EditForm Model="Photo" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <CascadingValue Value="FormButtonsDisabled">
        <FormDialog Title=@Title>
            <DataAnnotationsValidator />
            <ValidationSummary />
            <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
                @foreach (var brand in Brands)
                {
                    <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Label="Product" T="ProductModel" Value="Product" ValueChanged="HandleProductChanged" Disabled="ProductSelectDisabled">
                @foreach (var product in Products)
                {
                    <MudSelectItem Value="product">@product.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Label="Variant" T="VariantModel" @bind-Value="Photo.Variant" For="() => Photo.Variant" Disabled="VariantSelectDisabled">
                @foreach (var variant in Variants)
                {
                    <MudSelectItem Value="variant">@variant.Sku</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Label="Instance" T="InstanceModel" @bind-Value="Photo.Instance" For="() => Photo.Instance">
                @foreach (var instance in Instances)
                {
                    <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Label="Type" T="PhotoTypeModel" @bind-Value="Photo.Type" For="() => Photo.Type">
                @foreach (var type in Types)
                {
                    <MudSelectItem Value="type">@type.Name</MudSelectItem>
                }
            </MudSelect>
            <InputFile id="FileInput" OnChange="SetPhoto" hidden />
            <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Filled.CloudUpload" for="FileInput" Class="mt-4">
                Upload Photo
            </MudButton>
            @if (PhotoFile != null)
            {
                <MudList>
                    <MudListItem Icon="@Icons.Filled.AttachFile">
                        @PhotoFile.Name <code>@PhotoFile.Size bytes</code>
                    </MudListItem>
                </MudList>
            }
        </FormDialog>
    </CascadingValue>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool AddingSimilar { get; set; }
    [Parameter] public long PhotoId { get; set; }

    private CustomValidation CustomValidation = new();
    private PhotoModel Photo = new();
    private BrandModel Brand;
    private ProductModel Product;

    private IList<BrandModel> Brands;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<VariantModel> Variants = new List<VariantModel>();
    private IList<InstanceModel> Instances;
    private IList<PhotoTypeModel> Types;

    private bool ProductSelectDisabled = true;
    private bool VariantSelectDisabled = true;
    private bool FormButtonsDisabled = false;
    private IBrowserFile PhotoFile;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();
        Instances = InstanceService.GetAll();
        Types = PhotoTypeService.GetAll();

        if (IsEdit || AddingSimilar)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        Photo = PhotoService.Get(PhotoId);
        if (AddingSimilar)
        {
            Photo.Id = 0;
            Photo.Url = null;
        }

        ActivateProduct(Photo.Variant.Product.Brand.Id);
        ActivateVariant(Photo.Variant.Product.Id);

        Brand = Brands.Single(b => b.Id == Photo.Variant.Product.Brand.Id);
        Product = Products.Single(p => p.Id == Photo.Variant.Product.Id);
        Photo.Variant = Variants.Single(v => v.Id == Photo.Variant.Id);
        Photo.Instance = Photo.Instance != null ? Instances.Single(i => i.Id == Photo.Instance.Id) : null;
        Photo.Type = Types.Single(t => t.Id == Photo.Type.Id);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);
    }

    private void HandleProductChanged(ProductModel product)
    {
        Product = product;

        ResetVariant();
        ActivateVariant(product.Id);
    }

    private void ResetProduct()
    {
        Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ResetVariant()
    {
        Photo.Variant = null;
        VariantSelectDisabled = true;
        Variants = new List<VariantModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void ActivateVariant(long productId)
    {
        VariantSelectDisabled = false;
        Variants = VariantService.GetAllForProduct(productId);
    }

    private async void HandleValidSubmit()
    {
        ValidationResult validationResult = PhotoValidator.Validate(Photo);

        if (PhotoFile == null)
        {
            validationResult = new ValidationResult();
            validationResult.AddError("Please upload a photo");
        }

        if (validationResult.IsValid)
        {
            FormButtonsDisabled = true;

            MemoryStream memoryStream = new MemoryStream();
            await PhotoFile.OpenReadStream(Standard.UploadPhotoSizeLimit).CopyToAsync(memoryStream);
            memoryStream.Seek(0, SeekOrigin.Begin);

            string fileName = $"{Photo.Variant.Sku}_{Photo.Type.SystemName}";
            if (Photo.Instance != null)
            {
                fileName = $"{Photo.Variant.Sku}_{Photo.Type.SystemName}_{Photo.Instance.ShortName}";
            }

            PhotoUploadResult uploadResult = PhotoCloudService.Upload(memoryStream, fileName);

            if (uploadResult.WasSuccessful)
            {
                Photo.CloudId = uploadResult.CloudId;
                Photo.Url = uploadResult.Url;
                Photo.Height = uploadResult.Height;
                Photo.Width = uploadResult.Width;

                if (IsEdit)
                {
                    PhotoService.Update(Photo);
                    Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Photo"));
                }
                else
                {
                    PhotoService.Add(Photo);
                    Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Photo"));
                }

                MudDialog.Close();
            }
            else
            {
                FormButtonsDisabled = false;
                StateHasChanged();

                CustomValidation.DisplayError("There was an error uploading photo to cloud: " + uploadResult.Error);
            }
        }
        else
        {
            CustomValidation.DisplayErrors(validationResult.Errors);
        }
    }

    private void SetPhoto(InputFileChangeEventArgs e)
    {
        PhotoFile = e.File;
    }
}