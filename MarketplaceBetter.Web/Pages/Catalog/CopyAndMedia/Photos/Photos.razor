@using MarketplaceBetter.Domain.Model.Catalog.CopyAndMedia
@using MarketplaceBetter.Services.Domain.Catalog.CopyAndMedia.Interfaces
@using MarketplaceBetter.Services.Model
@using MarketplaceBetter.Specialized.Interfaces

@page "/photos"
@inject NavigationManager NavigationManager
@inject IPhotoService PhotoService
@inject IDialogService DialogService
@inject IPhotoCloudService PhotoCloudService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mt-2">Photos</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<PhotoModel>>>(ReloadPhotos))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
            <MudTextField Placeholder="Search" T="string" ValueChanged="FilterPhotos" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="UploadMultiple" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.FastForward" Color="Color.Info">Upload multiple</MudButton>
            <MudButton OnClick="AddPhoto" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Photo</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="PhotoModel">Id</MudTableSortLabel></MudTh>
            <MudTh>Photo</MudTh>
            <MudTh>Size</MudTh>
            <MudTh><MudTableSortLabel SortLabel="variant" T="PhotoModel">Variant</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="type" T="PhotoModel">Type</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="PhotoModel">Instance</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="width" T="PhotoModel">Width</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="height" T="PhotoModel">Height</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Photo"><MudImage Src="@PhotoCloudService.GetPhotoUrlForLists(context.CloudId)"></MudImage></MudTd>
            <MudTd>@context.Width<span>x</span>@context.Height</MudTd>
            <MudTd DataLabel="Variant">@context.Variant.Sku</MudTd>
            <MudTd DataLabel="Type">@context.Type.Name</MudTd>
            <MudTd DataLabel="Instance">@context.Instance?.Name</MudTd>
            <MudTd DataLabel="Width">@context.Width</MudTd>
            <MudTd DataLabel="Height">@context.Height</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => AddSimilarPhoto(context.Id))">Add</MudButton>
                <MudButton Class="mt-1" Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => DeletePhoto(context.Id, context.CloudId))">Delete</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<PhotoModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<PhotoModel>> ReloadPhotos(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<PhotoModel> photos = PhotoService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<PhotoModel>() { TotalItems = PhotoService.CountForListRequest(ListRequest), Items = photos });
    }

    private void FilterPhotos(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddPhoto()
    {
        var result = await DialogService.Show<PhotoDialog>(null, new DialogParameters { ["Title"] = "Add Photo" }).Result;

        ProcessPhotoDialogResult(result);
    }

    private void UploadMultiple()
    {
        NavigationManager.NavigateTo($"upload-photos");
    }

    private async void AddSimilarPhoto(long id)
    {
        var result = await DialogService.Show<PhotoDialog>(null, new DialogParameters { ["Title"] = "Add Photo", ["AddingSimilar"] = true, ["PhotoId"] = id }).Result;

        ProcessPhotoDialogResult(result);
    }

    private async void EditPhoto(long id)
    {
        var result = await DialogService.Show<PhotoDialog>(null, new DialogParameters { ["Title"] = "Edit Photo", ["IsEdit"] = true, ["PhotoId"] = id }).Result;

        ProcessPhotoDialogResult(result);
    }

    private async void DeletePhoto(long id, string photoId)
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = $"Are you sure you want to delete photo \"{photoId}\"?" }).Result;

        if (!result.Cancelled)
        {
            PhotoService.Delete(id);

            await Table.ReloadServerData();

            Snackbar.AddSuccess(OperationMessages.SuccessfullyDeleted("Photo"));
        }
    }

    private void ProcessPhotoDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
