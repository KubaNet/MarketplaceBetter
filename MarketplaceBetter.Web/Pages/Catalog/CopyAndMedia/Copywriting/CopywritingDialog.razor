@using MarketplaceBetter.Domain.Model.Catalog.CopyAndMedia
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Base
@using MarketplaceBetter.Services.Domain.Catalog.CopyAndMedia.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Base.Interfaces
@using MarketplaceBetter.Services.Specialized.Interfaces;
@using MarketplaceBetter.Services.Validation.Catalog.CopyAndMedia.Interfaces

@inject ISnackbar Snackbar
@inject ICopywritingService CopywritingService
@inject ICopywritingValidator CopywritingValidator
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IInstanceService InstanceService
@inject ICopywritingElementService CopywritingElementService
@inject ICurrentBrandService CurrentBrandService

<EditForm Model="Copywriting" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" @bind-Value="Copywriting.Product" For="() => Copywriting.Product" Disabled="ProductSelectDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Instance" T="InstanceModel" @bind-Value="Copywriting.Instance" For="() => Copywriting.Instance">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Element" T="CopywritingElementModel" @bind-Value="Copywriting.Element" For="() => Copywriting.Element">
            @foreach (var element in Elements)
            {
                <MudSelectItem Value="element">@element.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Value" @bind-Value="Copywriting.Value" For="() => Copywriting.Value" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool AddingSimilar { get; set; }
    [Parameter] public long CopywritingId { get; set; }

    private CustomValidation CustomValidation = new();
    private CopywritingModel Copywriting = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<InstanceModel> Instances;
    private IList<CopywritingElementModel> Elements;

    private bool ProductSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);
        Instances = InstanceService.GetAllNormal();
        Elements = CopywritingElementService.GetAll();

        if (IsEdit || AddingSimilar)
        {
            SetInitialValues();
        }
        else
        {
            if (CurrentBrandService.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }
        }
    }

    private void SetInitialValues()
    {
        Copywriting = CopywritingService.Get(CopywritingId);
        if (AddingSimilar)
        {
            Copywriting.Id = 0;
            Copywriting.Value = null;
        }

        ActivateProduct(Copywriting.Product.Brand.Id);

        Brand = Brands.Single(b => b.Id == Copywriting.Product.Brand.Id);
        Copywriting.Product = Products.Single(p => p.Id == Copywriting.Product.Id);
        Copywriting.Instance = Instances.Single(i => i.Id == Copywriting.Instance.Id);
        Copywriting.Element = Elements.Single(e => e.Id == Copywriting.Element.Id);
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == CurrentBrandService.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);
    }

    private void ResetProduct()
    {
        Copywriting.Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = CopywritingValidator.Validate(Copywriting);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                CopywritingService.Update(Copywriting);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Copywriting"));
            }
            else
            {
                CopywritingService.Add(Copywriting);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Copywriting"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}