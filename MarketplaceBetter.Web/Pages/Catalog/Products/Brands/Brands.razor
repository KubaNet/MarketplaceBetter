@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces

@page "/brands"
@inject IBrandService BrandService
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mt-2">Brands</MudText>

<MainBody>
    <MudTable Items="@BrandsData" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
            <MudSpacer />
            <MudButton OnClick="AddBrand" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Brand</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Code</MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Code">@context.Code</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditBrand(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private IList<BrandModel> BrandsData { get; set; }

    private async void AddBrand()
    {
        DialogResult result = await DialogService.Show<BrandDialog>(null, new DialogParameters { ["Title"] = "Add Brand" }).Result;

        ProcessBrandDialogResult(result);
    }

    private async void EditBrand(long id)
    {
        DialogResult result = await DialogService.Show<BrandDialog>(null, new DialogParameters { ["Title"] = "Edit Brand", ["IsEdit"] = true, ["BrandId"] = id }).Result;

        ProcessBrandDialogResult(result);
    }

    private void ProcessBrandDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            BrandsData = BrandService.GetAll(true);

            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        BrandsData = BrandService.GetAll();
    }
}
