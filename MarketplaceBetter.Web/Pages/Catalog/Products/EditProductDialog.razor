@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Validation.Catalog.Interfaces

@inject IProductService ProductService
@inject IProductValidator ProductValidator
@inject ISnackbar Snackbar

<EditForm Model="Product" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title="Edit product">
        <DataAnnotationsValidator />
        <MudTextField Label="Name" @bind-Value="Product.Name" For="() => Product.Name" />
        <MudTextField Label="Brand" @bind-Value="Product.BrandId" For="() => Product.BrandId" UserAttributes="@(new Dictionary<string, object>() { { "maxlength", "3" } })" />
    </FormDialog>
</EditForm>

@code {
    ProductModel Product;
    CustomValidation CustomValidation = new();

    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public long ProductId { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Product = ProductService.Get(ProductId);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ProductValidator.Validate(Product);

        if (result.IsValid)
        {
            ProductService.Update(Product);
            Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Product"));
            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}