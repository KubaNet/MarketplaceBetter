@using MarketplaceBetter.Domain.Model.Catalog.Products;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces;
@using MarketplaceBetter.Services.Validation.Catalog.Products.Interfaces;
@using TinyMCE.Blazor;

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IProductCommentValidator Validator
@inject IProductCommentService CommentService

<EditForm Model="Product" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <MudDialog Style="min-width: 1000px;">
        <TitleContent>
            <MudText Typo="Typo.h6">@Title</MudText>
        </TitleContent>
        <DialogContent>
            <DataAnnotationsValidator />

            <Editor @bind-Value="Product.Comment" Field="() => Product.Comment" Conf="EditorConfiguration" ScriptSrc="/lib/tinymce/tinymce.min.js" ClassName="mt-4" />
        </DialogContent>
        <DialogActions>
            @if (IsEdit)
            {
                <MudButton OnClick="Delete" Color="Color.Error" Class="mr-6">Delete</MudButton>
            }
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public ProductModel Product { get; set; }

    private CustomValidation CustomValidation = new();

    private Dictionary<string, object> EditorConfiguration = new Dictionary<string, object>{
        { "toolbar", "undo redo | bold italic underline | numlist bullist" },
        { "plugins", "lists" },
        { "menubar", false }
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private void Cancel() => MudDialog.Cancel();

    private void HandleValidSubmit()
    {
        ValidationResult result = Validator.Validate(Product.Comment);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                CommentService.Update(Product);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Comment"));
            }
            else
            {
                CommentService.Add(Product);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Comment"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }

    private async void Delete()
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = "Are you sure you want to delete this comment?" }).Result;

        if (!result.Canceled)
        {
            CommentService.Delete(Product);

            Snackbar.AddSuccess(OperationMessages.SuccessfullyDeleted("Comment"));

            MudDialog.Close();
        }
    }
}