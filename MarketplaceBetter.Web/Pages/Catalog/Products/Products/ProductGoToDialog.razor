@using MarketplaceBetter.Domain.Model.Catalog.Products

<MudDialog Style="min-width: 500px;">
    <TitleContent>
        <MudText Typo="Typo.h6">Go to and filter for <span class="mud-primary-text">@Product.Name</span></MudText>
    </TitleContent>
    <DialogContent>
        <MudList T="string" ReadOnly="false">
            <MudListItem Text="Catalog" Expanded="true">
                <NestedList>
                    <MudListItem Text="Product Colors" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@ProductColorsLink" />
                    <MudListItem Text="Variants" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@VariantsLink" />
                </NestedList>
            </MudListItem>
            <MudListItem Text="Amazon" Expanded="true">
                <NestedList>
                    <MudListItem Text="Parents" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@ParentsLink" />
                    <MudListItem Text="Childs" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@ChildsLink" />
                </NestedList>
            </MudListItem>
        </MudList>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public ProductModel Product { get; set; }

    private string ProductColorsLink;
    private string VariantsLink;
    private string ParentsLink;
    private string ChildsLink;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProductColorsLink = $"product-colors?productId={Product.Id}&showAll=true";
        VariantsLink = $"variants?productId={Product.Id}&showAll=true";
        ParentsLink = $"parents?productId={Product.Id}&showAll=true";
        ChildsLink = $"childs?productId={Product.Id}&showAll=true";
    }
}