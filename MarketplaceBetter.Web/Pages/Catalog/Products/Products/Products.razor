@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Model

@page "/products"
@inject NavigationManager Navigation
@inject IProductService ProductService
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mt-2">Products</MudText>

<MainBody>
	<MudTable T="ProductModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ProductModel>>>(Reload))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
		<ToolBarContent>
			<MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
			<MudButton OnClick="ChangeStatusOfSelected" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PublishedWithChanges" Color="Color.Info" Disabled="NoneSelected" Class="ml-2">Change Status</MudButton>
			<MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Product</MudButton>
		</ToolBarContent>
		<HeaderContent>
			<MudTh><MudTableSortLabel SortLabel="id" T="ProductModel">Id</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="name" T="ProductModel">Name</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="code" T="ProductModel">Code</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="status" T="ProductModel">Status</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="brand" T="ProductModel">Brand</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="collection" T="ProductModel">Collection</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="color_group" T="ProductModel">Color group</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="size_group" T="ProductModel">Size group</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="order" T="ProductModel">Order</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="comment" T="ProductModel">Comment</MudTableSortLabel></MudTh>
			<MudTh Style="width: 100px;">Actions</MudTh>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="Id">@context.Id</MudTd>
			<MudTd DataLabel="Name"><ProductDisplay Product="@context" /></MudTd>
			<MudTd DataLabel="Code">@context.Code</MudTd>
			<MudTd DataLabel="Status"><EntityStatusDisplay Status="@context.Status" /></MudTd>
			<MudTd DataLabel="Brand">@context.Brand.Name</MudTd>
			<MudTd DataLabel="Collection">@context.Collection.Name</MudTd>
			<MudTd DataLabel="Color group">@context.ColorGroup.Name</MudTd>
			<MudTd DataLabel="Size group">@context.SizeGroup.Name</MudTd>
			<MudTd DataLabel="Order">@context.Order</MudTd>
			<MudTd DataLabel="Comment"><ProductComment Product="context" /></MudTd>
			<MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Edit(context.Id))">Edit</MudButton></MudTd>
		</RowTemplate>
		<PagerContent>
			<MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
		</PagerContent>
	</MudTable>
</MainBody>

@code {
	[Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

	private MudTable<ProductModel> Table;
	private ListRequest ListRequest = new();

	private HashSet<ProductModel> SelectedProducts = new HashSet<ProductModel>();
	private bool NoneSelected = true;
	private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		ProcessQueryParameters();		
	}

	private void ProcessQueryParameters()
	{
		if (!String.IsNullOrWhiteSpace(SearchString))
		{
			ListRequest.SearchString = SearchString;
		}
	}

	private Task<TableData<ProductModel>> Reload(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<ProductModel> products = ProductService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<ProductModel>() { TotalItems = ProductService.CountForListRequest(ListRequest), Items = products });
	}

	private void OnRowsPerPageChanged(int rowsPerPage)
	{
		CurrentRowsPerPageValue = rowsPerPage;
	}

	private void Filter(string searchString)
	{
		ListRequest.SearchString = searchString;

		string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
		Navigation.NavigateTo(newUrl, replace: true);

		Table.ReloadServerData();

		StateHasChanged();
	}

	private async void Add()
	{
		var result = await DialogService.Show<ProductDialog>(null, new DialogParameters { ["Title"] = "Add Product" }).Result;

		ProcessDialogResult(result);
	}

	private async void Edit(long id)
	{
		var result = await DialogService.Show<ProductDialog>(null, new DialogParameters { ["Title"] = "Edit Product", ["IsEdit"] = true, ["ProductId"] = id }).Result;

		ProcessDialogResult(result);
	}

	private void ProcessDialogResult(DialogResult result)
	{
		if (!result.Canceled)
		{
			Table.ReloadServerData();
		}
	}

	private async void ChangeStatusOfSelected()
	{
		var result = await DialogService.Show<ProductsSetStatusDialog>(null, new DialogParameters { ["Products"] = SelectedProducts.ToList() }).Result;

		ProcessDialogResult(result);
	}

	private void OnSelectedItemsChanged(HashSet<ProductModel> selectedProducts)
	{
		SelectedProducts = selectedProducts;

		if (SelectedProducts.Any())
		{
			NoneSelected = false;
		}
		else
		{
			NoneSelected = true;
		}
	}
}
