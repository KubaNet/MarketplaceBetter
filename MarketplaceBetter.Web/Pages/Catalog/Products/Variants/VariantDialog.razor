@using MarketplaceBetter.Domain.Entities.Catalog.Products
@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Specialized.Interfaces;
@using MarketplaceBetter.Services.Validation.Catalog.Products.Interfaces

@inject ISnackbar Snackbar
@inject IVariantService VariantService
@inject IVariantValidator VariantValidator
@inject IBrandService BrandService
@inject IVariantStatusService StatusService
@inject IProductService ProductService
@inject IColorService ColorService
@inject ISizeService SizeService
@inject ICurrentBrandService CurrentBrandService

<EditForm Model="Variant" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="Variant.Product" For="() => Variant.Product" ValueChanged="HandleProductChanged" Disabled="ProductSelectDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Color" T="ColorModel" Value="Variant.Color" For="() => Variant.Color" ValueChanged="HandleColorChanged" Disabled="ColorSelectDisabled">
            @foreach (var color in Colors)
            {
                <MudSelectItem Value="color">@color.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Size" T="SizeModel" Value="Variant.Size" For="() => Variant.Size" ValueChanged="HandleSizeChanged" Disabled="SizeSelectDisabled">
            @foreach (var size in Sizes)
            {
                <MudSelectItem Value="size">@size.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Status" T="VariantStatusModel" @bind-Value="Variant.Status" For="() => Variant.Status">
            @foreach (var status in Statuses)
            {
                <MudSelectItem Value="status">@status.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="Variant.Sku" For="() => Variant.Sku" />
        <MudTextField Label="EAN" @bind-Value="Variant.Ean" For="() => Variant.Ean" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool AddingSimilar { get; set; }
    [Parameter] public long VariantId { get; set; }

    private CustomValidation CustomValidation = new();
    private VariantModel Variant = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<VariantStatusModel> Statuses = new List<VariantStatusModel>();
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<ColorModel> Colors = new List<ColorModel>();
    private IList<SizeModel> Sizes = new List<SizeModel>();

    private bool ProductSelectDisabled = true;
    private bool ColorSelectDisabled = true;
    private bool SizeSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);
        Statuses = StatusService.GetAll();

        Variant.Status = Statuses.Single(s => s.SystemName == VariantStatusEnum.Active);

        if (IsEdit || AddingSimilar)
        {
            SetInitialValues();
        }
        else
        {
            if (CurrentBrandService.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }
        }
    }

    private void SetInitialValues()
    {
        Variant = VariantService.Get(VariantId);
        if (AddingSimilar)
        {
            Variant.Id = 0;
        }

        ActivateProduct(Variant.Product.Brand.Id);
        ActivateColor(Variant.Product.ColorGroup.Id);
        ActivateSize(Variant.Product.SizeGroup.Id);

        Brand = Brands.Single(b => b.Id == Variant.Product.Brand.Id);
        Variant.Product = Products.Single(p => p.Id == Variant.Product.Id);
        Variant.Color = Colors.Single(c => c.Id == Variant.Color.Id);
        Variant.Size = Sizes.Single(s => s.Id == Variant.Size.Id);
        Variant.Status = Statuses.Single(s => s.Id == Variant.Status.Id);
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == CurrentBrandService.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ResetColor();
        ResetSize();

        ActivateProduct(brand.Id);

        SetVariantSku();
    }

    private void HandleProductChanged(ProductModel product)
    {
        Variant.Product = product;

        ResetColor();
        ResetSize();

        ActivateColor(product.ColorGroup.Id);
        ActivateSize(product.SizeGroup.Id);

        SetVariantSku();
    }

    private void HandleColorChanged(ColorModel color)
    {
        Variant.Color = color;

        SetVariantSku();
    }

    private void HandleSizeChanged(SizeModel size)
    {
        Variant.Size = size;

        SetVariantSku();
    }

    private void ResetProduct()
    {
        Variant.Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void ResetColor()
    {
        Variant.Color = null;
        ColorSelectDisabled = true;
        Colors = new List<ColorModel>();
    }

    private void ActivateColor(long colorGroupId)
    {
        ColorSelectDisabled = false;
        Colors = ColorService.GetAllForGroup(colorGroupId);
    }

    private void ResetSize()
    {
        Variant.Size = null;
        SizeSelectDisabled = true;
        Sizes = new List<SizeModel>();
    }

    private void ActivateSize(long sizeGroupId)
    {
        SizeSelectDisabled = false;
        Sizes = SizeService.GetAllForGroup(sizeGroupId);
    }

    private void SetVariantSku()
    {
        if (Brand != null)
        {
            Variant.Sku = Brand.Code.ToLower();

            if (Variant.Product != null)
            {
                Variant.Sku += $"_{Variant.Product.Code}";

                if (Variant.Color != null && Variant.Size != null)
                {
                    Variant.Sku += $"_{Variant.Size.Code}_{Variant.Color.Code}";
                }
                else if (Variant.Size != null)
                {
                    Variant.Sku += $"_{Variant.Size.Code}";
                }
                else if (Variant.Color != null)
                {
                    Variant.Sku += $"_{Variant.Color.Code}";
                }
            }
        }
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = VariantValidator.Validate(Variant);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                VariantService.Update(Variant);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Variant"));
            }
            else
            {
                VariantService.Add(Variant);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Variant"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}