@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Model;
@using System.Threading

@page "/variants"
<PageTitle>Variants</PageTitle>

@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IVariantService VariantService

<MudText Typo="Typo.h4" Class="mt-2">Variants</MudText>

<MainBody>
    <MudTable T="VariantModel" @ref="Table" ServerData="@(new Func<TableState, CancellationToken, Task<TableData<VariantModel>>>(Reload))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="ChangeStatusOfSelected" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PublishedWithChanges" Color="Color.Info" Disabled="NoneSelected" Class="ml-2">Change Status</MudButton>
            <MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Variant</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="VariantModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="sku" T="VariantModel">SKU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="status" T="VariantModel">Status</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product" T="VariantModel">Product</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product_code" T="VariantModel">Code</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="color" T="VariantModel">Color</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="size" T="VariantModel">Size</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="ean" T="VariantModel">EAN</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="asin" T="VariantModel">ASIN</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="VariantModel">Brand</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="comment" T="VariantModel">Comment</MudTableSortLabel></MudTh>
            <MudTh Style="width: 250px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Sku">@context.Sku</MudTd>
            <MudTd DataLabel="Status"><EntityStatusDisplay Status="@context.Status" /></MudTd>
            <MudTd DataLabel="Product">@context.Product.Name</MudTd>
            <MudTd DataLabel="ProductCode">@context.Product.Code</MudTd>
            <MudTd DataLabel="Color">@context.Color.Name</MudTd>
            <MudTd DataLabel="Size">@context.Size.Name</MudTd>
            <MudTd DataLabel="EAN">@context.Ean</MudTd>
            <MudTd DataLabel="ASIN">@context.Asin</MudTd>
            <MudTd DataLabel="Brand">@context.Product.Brand.Name</MudTd>
            <MudTd DataLabel="Comment"><VariantComment Variant="context" /></MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Id, context.Sku))">Delete</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" OnClick="@(() => AddSimilar(context.Id))">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" OnClick="@(() => Edit(context.Id))">Edit</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            @if (!ShowAll.HasValue || ShowAll == false)
            {
                <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
            }
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }
    [Parameter][SupplyParameterFromQuery] public long? ProductId { get; set; }
    [Parameter][SupplyParameterFromQuery] public bool? ShowAll { get; set; }

    private MudTable<VariantModel> Table;
    private ListRequest ListRequest = new();

    private HashSet<VariantModel> SelectedVariants = new HashSet<VariantModel>();
    private bool NoneSelected = true;
    private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
        else if (ProductId.HasValue)
        {
            ListRequest.SearchString = $"product_id: {ProductId.Value}";
        }

        if (ShowAll.HasValue)
        {
            ListRequest.ShowAll = ShowAll.Value;
        }
    }

    private Task<TableData<VariantModel>> Reload(TableState state, CancellationToken token)
    {
        state.PopulateListRequest(ListRequest);

        IList<VariantModel> variants = VariantService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<VariantModel>() { TotalItems = VariantService.CountForListRequest(ListRequest), Items = variants });
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        CurrentRowsPerPageValue = rowsPerPage;
    }

    private void Filter(string searchString)
    {
        ListRequest.SearchString = searchString;

        string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
        Navigation.NavigateTo(newUrl, replace: true);

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void Add()
    {
        DialogResult result = await DialogService.Show<VariantDialog>(null, new DialogParameters { ["Title"] = "Add Variant" }).Result;

        ProcessDialogResult(result);
    }

    private async void AddSimilar(long id)
    {
        DialogResult result = await DialogService.Show<VariantDialog>(null, new DialogParameters { ["Title"] = "Add Variant", ["AddingSimilar"] = true, ["VariantId"] = id }).Result;

        ProcessDialogResult(result);
    }

    private async void Edit(long id)
    {
        DialogResult result = await DialogService.Show<VariantDialog>(null, new DialogParameters { ["Title"] = "Edit Variant", ["IsEdit"] = true, ["VariantId"] = id }).Result;

        ProcessDialogResult(result);
    }

    private async void Delete(long id, string sku)
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = $"Are you sure you want to delete variant <b>{sku}</b> ? <br><br>All entities (child instances, photos etc.) associated with this variant will be also deleted." }).Result;

        if (!result.Canceled)
        {
            VariantService.Delete(id);

            await Table.ReloadServerData();

            Snackbar.AddSuccess(OperationMessages.SuccessfullyDeleted("Variant"));
        }
    }

    private void ProcessDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }

    private async void ChangeStatusOfSelected()
    {
        DialogResult result = await DialogService.Show<VariantsSetStatusDialog>(null, new DialogParameters { ["Variants"] = SelectedVariants.ToList() }).Result;

        ProcessDialogResult(result);
    }

    private void OnSelectedItemsChanged(HashSet<VariantModel> selectedVariants)
    {
        SelectedVariants = selectedVariants;

        if (SelectedVariants.Any())
        {
            NoneSelected = false;
        }
        else
        {
            NoneSelected = true;
        }
    }
}
