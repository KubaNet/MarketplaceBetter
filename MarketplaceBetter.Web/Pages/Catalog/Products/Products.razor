@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Model.ListRequests.Catalog

@page "/products"
@inject IProductService ProductService
@inject IDialogService DialogService
@inject IBrandService BrandService
@inject IColorGroupService ColorGroupService
@inject ISizeGroupService SizeGroupService

<MudText Typo="Typo.h3">Products</MudText>

<MainBody>
	<MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ProductModel>>>(ReloadProducts))" Dense="true" Hover="true">
		<ToolBarContent>
			<MudButton OnClick="AddProduct" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Product</MudButton>
			<MudSpacer />
			<MudTextField @bind-Value="SearchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
		</ToolBarContent>
		<HeaderContent>
			<MudTh><MudTableSortLabel SortLabel="id" T="ProductModel">Id</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="name" T="ProductModel">Name</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="code" T="ProductModel">Code</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="brand" T="ProductModel">Brand</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="collection" T="ProductModel">Collection</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="color_group" T="ProductModel">Color group</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="size_group" T="ProductModel">Size group</MudTableSortLabel></MudTh>
			<MudTh Style="width: 100px;">Actions</MudTh>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="Id">@context.Id</MudTd>
			<MudTd DataLabel="Name">@context.Name</MudTd>
			<MudTd DataLabel="Code">@context.Code</MudTd>
			<MudTd DataLabel="Brand">@context.Brand.Name</MudTd>
			<MudTd DataLabel="Brand">@context.Collection.Name</MudTd>
			<MudTd DataLabel="Color group">@context.ColorGroup.Name</MudTd>
			<MudTd DataLabel="Size group">@context.SizeGroup.Name</MudTd>
			<MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditProduct(context.Id))">Edit</MudButton></MudTd>
		</RowTemplate>
		<PagerContent>
			<MudTablePager />
		</PagerContent>
	</MudTable>
</MainBody>

@code {
	private MudTable<ProductModel> Table;
	private ProductListRequest ListRequest = new();

	private IList<BrandModel> Brands;
	private IList<ColorGroupModel> ColorGroups;
	private IList<SizeGroupModel> SizeGroups;

	private string SearchString;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		Brands = BrandService.GetAll();
		ColorGroups = ColorGroupService.GetAll();
		SizeGroups = SizeGroupService.GetAll();
	}

	private Task<TableData<ProductModel>> ReloadProducts(TableState state)
	{
		PupulateListRequest(state);

		IList<ProductModel> products = ProductService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<ProductModel>() { TotalItems = products.Count, Items = products });
	}

	private void PupulateListRequest(TableState state)
	{
		ListRequest.SortBy = state.SortLabel;
		ListRequest.SortDirection = state.SortDirection;
		ListRequest.Page = state.Page;
		ListRequest.PageSize = state.PageSize;
	}

	private void FilterProducts()
	{
		Table.ReloadServerData();

		StateHasChanged();
	}

	private async void AddProduct()
	{
		var result = await DialogService.Show<ProductDialog>(null, new DialogParameters { ["Title"] = "Add Product" }).Result;

		ProcessProductDialogResult(result);
	}

	private async void EditProduct(long id)
	{
		var result = await DialogService.Show<ProductDialog>(null, new DialogParameters { ["Title"] = "Edit Product", ["IsEdit"] = true, ["ProductId"] = id }).Result;

		ProcessProductDialogResult(result);
	}

	private void ProcessProductDialogResult(DialogResult result)
	{
		if (!result.Cancelled)
		{
			Table.ReloadServerData();
		}
	}
}
