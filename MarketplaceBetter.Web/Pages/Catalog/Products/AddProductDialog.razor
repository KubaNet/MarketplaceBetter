@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Validation.Catalog.Interfaces

@inject IProductService ProductService
@inject IBrandService BrandService
@inject IProductValidator ProductValidator
@inject ISnackbar Snackbar

<EditForm Model="Product" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title="Add product">
        <DataAnnotationsValidator />
        <MudTextField Label="Name" @bind-Value="Product.Name" For="() => Product.Name" />
        <MudTextField Label="Code" @bind-Value="Product.Code" For="() => Product.Code" />
        <MudSelect T="BrandModel" @bind-Value="Product.Brand" Label="Brand" For="() => Product.Brand">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
    </FormDialog>
</EditForm>

@code {
    ProductModel Product = new();
    IList<BrandModel> Brands;
    CustomValidation CustomValidation = new();

    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ProductValidator.Validate(Product);

        if (result.IsValid)
        {
            ProductService.Add(Product);
            Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Product"));
            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}