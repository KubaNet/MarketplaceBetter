@using MarketplaceBetter.Domain.Model.Catalog.Attributes;
@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes;
@using MarketplaceBetter.Domain.Model.Catalog.Products;
@using MarketplaceBetter.Services.Domain.Base.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.Attributes.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces;
@using MarketplaceBetter.Services.Validation.Catalog.Attributes.Interfaces;
@using System.Globalization;

@inject ISnackbar Snackbar
@inject IProductDimensionsService DimensionsService
@inject IProductDimensionsValidator DimensionsValidator
@inject IBrandService BrandService
@inject IProductService ProductService
@inject ISizeService SizeService
@inject IUserService UserService

<EditForm Model="Dimensions" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="Dimensions.Product" For="() => Dimensions.Product" ValueChanged="HandleProductChanged" Disabled="ProductSelectDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Size" T="SizeModel" Value="Dimensions.Size" For="() => Dimensions.Size" ValueChanged="HandleSizeChanged" Disabled="SizeSelectDisabled">
            @foreach (var size in Sizes)
            {
                <MudSelectItem Value="size">@size.Name</MudSelectItem>
            }
        </MudSelect>
        <div class="d-flex">
            <MudNumericField Label="Weight [g]" T="double?" Value="Dimensions.WeightInGrams" ValueChanged="HandleWeightInGramsChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
            <div class="flex-none d-flex" style="width: 50px;"></div>
            <MudNumericField Label="Weight [lb]" T="double?" Value="Dimensions.WeightInPounds" ValueChanged="HandleWeightInPoundsChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
        </div>
        <div class="d-flex">
            <MudNumericField Label="Depth [cm]" T="double?" Value="Dimensions.DepthInCentimeters" ValueChanged="HandleDepthInCentimetersChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
            <div class="flex-none d-flex" style="width: 50px;"></div>
            <MudNumericField Label="Depth [in]" T="double?" Value="Dimensions.DepthInInches" ValueChanged="HandleDepthInInchesChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
        </div>
        <div class="d-flex">
            <MudNumericField Label="Length [cm]" T="double?" Value="Dimensions.LengthInCentimeters" ValueChanged="HandleLengthInCentimetersChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
            <div class="flex-none d-flex" style="width: 50px;"></div>
            <MudNumericField Label="Length [in]" T="double?" Value="Dimensions.LengthInInches" ValueChanged="HandleLengthInInchesChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
        </div>
        <div class="d-flex">
            <MudNumericField Label="Width [cm]" T="double?" Value="Dimensions.WidthInCentimeters" ValueChanged="HandleWidthInCentimetersChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
            <div class="flex-none d-flex" style="width: 50px;"></div>
            <MudNumericField Label="Width [in]" T="double?" Value="Dimensions.WidthInInches" ValueChanged="HandleWidthInInchesChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
        </div>
        <div class="d-flex">
            <MudNumericField Label="Height [cm]" T="double?" Value="Dimensions.HeightInCentimeters" ValueChanged="HandleHeightInCentimetersChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
            <div class="flex-none d-flex" style="width: 50px;"></div>
            <MudNumericField Label="Height [in]" T="double?" Value="Dimensions.HeightInInches" ValueChanged="HandleHeightInInchesChanged" Culture="Culture" Format="N2" Variant="Variant.Text" Min="0.01" HideSpinButtons="true" />
        </div>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool AddingSimilar { get; set; }
    [Parameter] public long DimensionsId { get; set; }

    private CustomValidation CustomValidation = new();
    private ProductDimensionsModel Dimensions = new();
    private CultureInfo Culture = CultureInfo.GetCultureInfo("pl-PL");
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<SizeModel> Sizes = new List<SizeModel>();

    private bool ProductSelectDisabled = true;
    private bool SizeSelectDisabled = true;

    private double GramToPoundRatio = 0.0022046226;
    private double CentimeterToInchRatio = 0.393700787;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);

        if (IsEdit || AddingSimilar)
        {
            SetInitialValues();
        }
        else
        {
            if (UserService.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }
        }
    }

    private void SetInitialValues()
    {
        Dimensions = DimensionsService.Get(DimensionsId);

        if (AddingSimilar)
        {
            Dimensions.Id = 0;
        }

        ActivateProduct(Dimensions.Product.Brand.Id);
        ActivateSize(Dimensions.Product.SizeGroup.Id);

        Brand = Brands.Single(b => b.Id == Dimensions.Product.Brand.Id);
        Dimensions.Product = Products.Single(p => p.Id == Dimensions.Product.Id);
        Dimensions.Size = Sizes.Single(s => s.Id == Dimensions.Size.Id);
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == UserService.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ResetSize();

        ActivateProduct(brand.Id);
    }

    private void HandleProductChanged(ProductModel product)
    {
        Dimensions.Product = product;

        ResetSize();

        ActivateSize(product.SizeGroup.Id);
    }

    private void HandleSizeChanged(SizeModel size)
    {
        Dimensions.Size = size;
    }

    private void ResetProduct()
    {
        Dimensions.Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void ResetSize()
    {
        Dimensions.Size = null;
        SizeSelectDisabled = true;
        Sizes = new List<SizeModel>();
    }

    private void ActivateSize(long sizeGroupId)
    {
        SizeSelectDisabled = false;
        Sizes = SizeService.GetAllForGroup(sizeGroupId);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = DimensionsValidator.Validate(Dimensions);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                DimensionsService.Update(Dimensions);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Product Dimensions"));
            }
            else
            {
                DimensionsService.Add(Dimensions);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Product Dimensions"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }

    private void HandleWeightInGramsChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.WeightInGrams = value;
            return;
        }

        Dimensions.WeightInGrams = Math.Round(value.Value, 2);
        HandleWeightInPoundsChanged(GramToPoundRatio * Dimensions.WeightInGrams);
    }

    private void HandleWeightInPoundsChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.WeightInPounds = value;
            return;
        }

        Dimensions.WeightInPounds = Math.Round(value.Value, 2);
    }

    private void HandleDepthInCentimetersChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.DepthInCentimeters = value;
            return;
        }

        Dimensions.DepthInCentimeters = Math.Round(value.Value, 2);
        HandleDepthInInchesChanged(CentimeterToInchRatio * Dimensions.DepthInCentimeters);
    }

    private void HandleDepthInInchesChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.DepthInInches = value;
            return;
        }

        Dimensions.DepthInInches = Math.Round(value.Value, 2);
    }

    private void HandleLengthInCentimetersChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.LengthInCentimeters = value;
            return;
        }

        Dimensions.LengthInCentimeters = Math.Round(value.Value, 2);
        HandleLengthInInchesChanged(CentimeterToInchRatio * Dimensions.LengthInCentimeters);
    }

    private void HandleLengthInInchesChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.LengthInInches = value;
            return;
        }

        Dimensions.LengthInInches = Math.Round(value.Value, 2);
    }

    private void HandleWidthInCentimetersChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.WidthInCentimeters = value;
            return;
        }

        Dimensions.WidthInCentimeters = Math.Round(value.Value, 2);
        HandleWidthInInchesChanged(CentimeterToInchRatio * Dimensions.WidthInCentimeters);
    }

    private void HandleWidthInInchesChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.WidthInInches = value;
            return;
        }

        Dimensions.WidthInInches = Math.Round(value.Value, 2);
    }

    private void HandleHeightInCentimetersChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.HeightInCentimeters = value;
            return;
        }

        Dimensions.HeightInCentimeters = Math.Round(value.Value, 2);
        HandleHeightInInchesChanged(CentimeterToInchRatio * Dimensions.HeightInCentimeters);
    }

    private void HandleHeightInInchesChanged(double? value)
    {
        if (!value.HasValue)
        {
            Dimensions.HeightInInches = value;
            return;
        }

        Dimensions.HeightInInches = Math.Round(value.Value, 2);
    }
}