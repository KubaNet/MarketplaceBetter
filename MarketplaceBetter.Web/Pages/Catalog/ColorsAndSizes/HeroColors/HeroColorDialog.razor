@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Base.Interfaces;
@using MarketplaceBetter.Services.Validation.Catalog.ColorsAndSizes.Interfaces

@inject ISnackbar Snackbar
@inject IHeroColorService HeroColorService
@inject IHeroColorValidator HeroColorValidator
@inject IProductService ProductService
@inject IColorService ColorService
@inject IProductColorService ProductColorService

<EditForm Model="HeroColor" OnValidSubmit="@HandleValidSubmit">
	<CustomValidation @ref="CustomValidation" />
	<FormDialog Title=@Title>
		<DataAnnotationsValidator />
		<MudSelect Label="Product" T="ProductModel" Value="HeroColor.Product" For="() => HeroColor.Product" ValueChanged="HandleProductChanged">
			@foreach (var brand in Products)
			{
				<MudSelectItem Value="brand">@brand.Name</MudSelectItem>
			}
		</MudSelect>
		<MudSelect Label="Color" T="ColorModel" @bind-Value="HeroColor.Color" For="() => HeroColor.Color" Disabled="ColorSelectDisabled">
			@foreach (var color in Colors)
			{
				<MudSelectItem Value="color">@color.Name</MudSelectItem>
			}
		</MudSelect>
	</FormDialog>
</EditForm>

@code {
	[CascadingParameter] public MudDialogInstance MudDialog { get; set; }
	[Parameter] public string Title { get; set; }
	[Parameter] public bool IsEdit { get; set; }
	[Parameter] public long HeroColorId { get; set; }

	private CustomValidation CustomValidation = new();
	private HeroColorModel HeroColor = new();
	private bool ColorSelectDisabled = true;

	private IList<ProductModel> Products;
	private IList<ColorModel> Colors = new List<ColorModel>();

	protected override void OnInitialized()
	{
		base.OnInitialized();

		Products = ProductService.GetAll();

		if (IsEdit)
		{
			SetInitialValues();
		}
	}

	private void SetInitialValues()
	{
		HeroColor = HeroColorService.Get(HeroColorId);

		ActivateColor(HeroColor.Product.Id);

		HeroColor.Product = Products.Single(p => p.Id == HeroColor.Product.Id);
		HeroColor.Color = Colors.Single(c => c.Id == HeroColor.Color.Id);
	}

	private void HandleProductChanged(ProductModel product)
	{
		HeroColor.Product = product;

		ResetColor();
		ActivateColor(product.Id);
	}

	private void ResetColor()
	{
		HeroColor.Color = null;
		ColorSelectDisabled = true;
		Colors = new List<ColorModel>();
	}

	private void ActivateColor(long productId)
	{
		ColorSelectDisabled = false;
		Colors = ProductColorService.GetAllForProduct(productId);
	}

	private void HandleValidSubmit()
	{
		ValidationResult result = HeroColorValidator.Validate(HeroColor);

		if (result.IsValid)
		{
			if (IsEdit)
			{
				HeroColorService.Update(HeroColor);
				Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Hero Color"));
			}
			else
			{
				HeroColorService.Add(HeroColor);
				Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Hero Color"));
			}

			MudDialog.Close();
		}
		else
		{
			CustomValidation.DisplayErrors(result.Errors);
		}
	}
}