@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Model

@page "/color-translations"
@inject IColorTranslationService ColorTranslationService
@inject IDialogService DialogService

<MudText Typo="Typo.h3" Class="mt-2">Color Translations</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ColorTranslationModel>>>(ReloadTranslations))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
			<MudTextField Placeholder="Search" T="string" ValueChanged="FilterTranslations" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
            <MudButton OnClick="AddColorTranslation" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Color Translation</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="ColorTranslationModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="ColorTranslationModel">Instance</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="translation" T="ColorTranslationModel">Translation</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="mapping" T="ColorTranslationModel">Mapping</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="color" T="ColorTranslationModel">Color</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="color_group" T="ColorTranslationModel">Color Group</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ColorTranslationModel">Brand</MudTableSortLabel></MudTh>
            <MudTh Style="width: 170px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd DataLabel="Translation">@context.Translation</MudTd>
            <MudTd DataLabel="Mapping">@context.Mapping</MudTd>
            <MudTd DataLabel="Color">@context.Color.Name</MudTd>
            <MudTd DataLabel="Color Group">@context.Color.Group.Name</MudTd>
            <MudTd DataLabel="Brand">@context.Color.Group.Brand.Name</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => AddSimilarColorTranslation(context.Id))">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditColorTranslation(context.Id))">Edit</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<ColorTranslationModel> Table;
	private ListRequest ListRequest = new();

	private Task<TableData<ColorTranslationModel>> ReloadTranslations(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<ColorTranslationModel> translations = ColorTranslationService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<ColorTranslationModel>() { TotalItems = ColorTranslationService.CountForListRequest(ListRequest), Items = translations });
	}

	private void FilterTranslations(string searchString)
	{
		ListRequest.SearchString = searchString;

		Table.ReloadServerData();

		StateHasChanged();
	}

    private async void AddColorTranslation()
    {
        var result = await DialogService.Show<ColorTranslationDialog>(null, new DialogParameters { ["Title"] = "Add Color Translation" }).Result;

        ProcessColorTranslationDialogResult(result);
    }

    private async void AddSimilarColorTranslation(long id)
    {
        var result = await DialogService.Show<ColorTranslationDialog>(null, new DialogParameters { ["Title"] = "Add Color Translation", ["AddingSimilar"] = true, ["ColorTranslationId"] = id }).Result;

        ProcessColorTranslationDialogResult(result);
    }

    private async void EditColorTranslation(long id)
    {
        var result = await DialogService.Show<ColorTranslationDialog>(null, new DialogParameters { ["Title"] = "Edit Color Translation", ["IsEdit"] = true, ["ColorTranslationId"] = id }).Result;

        ProcessColorTranslationDialogResult(result);
    }

    private void ProcessColorTranslationDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
