@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Model
@using System.Threading

@page "/color-translations"
<PageTitle>Color Translations</PageTitle>

@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IColorTranslationService ColorTranslationService

<MudText Typo="Typo.h4" Class="mt-2">Color Translations</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, CancellationToken, Task<TableData<ColorTranslationModel>>>(Reload))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
            <MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Color Translation</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="ColorTranslationModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="ColorTranslationModel">Instance</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="translation" T="ColorTranslationModel">Translation</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="mapping" T="ColorTranslationModel">Mapping</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="color" T="ColorTranslationModel">Color</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="color_group" T="ColorTranslationModel">Color Group</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ColorTranslationModel">Brand</MudTableSortLabel></MudTh>
            <MudTh Style="width: 170px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd DataLabel="Translation">@context.Translation</MudTd>
            <MudTd DataLabel="Mapping">@context.Mapping</MudTd>
            <MudTd DataLabel="Color">@context.Color.Name</MudTd>
            <MudTd DataLabel="Color Group">@context.Color.Group.Name</MudTd>
            <MudTd DataLabel="Brand">@context.Color.Group.Brand.Name</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" OnClick="@(() => AddSimilar(context.Id))">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" OnClick="@(() => Edit(context.Id))">Edit</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }
    [Parameter][SupplyParameterFromQuery] public long? ColorId { get; set; }

    private MudTable<ColorTranslationModel> Table;
    private ListRequest ListRequest = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
        else
        {
            if (ColorId.HasValue)
            {
                ListRequest.SearchString += $"color_id: {ColorId.Value}";
            }
        }
    }

	private Task<TableData<ColorTranslationModel>> Reload(TableState state, CancellationToken token)
	{
		state.PopulateListRequest(ListRequest);

		IList<ColorTranslationModel> translations = ColorTranslationService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<ColorTranslationModel>() { TotalItems = ColorTranslationService.CountForListRequest(ListRequest), Items = translations });
	}

	private void Filter(string searchString)
	{
		ListRequest.SearchString = searchString;

        string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
        Navigation.NavigateTo(newUrl, replace: true);

		Table.ReloadServerData();

		StateHasChanged();
	}

    private async void Add()
    {
        DialogResult result = await DialogService.Show<ColorTranslationDialog>(null, new DialogParameters { ["Title"] = "Add Color Translation" }).Result;

        ProcessDialogResult(result);
    }

    private async void AddSimilar(long id)
    {
        DialogResult result = await DialogService.Show<ColorTranslationDialog>(null, new DialogParameters { ["Title"] = "Add Color Translation", ["AddingSimilar"] = true, ["ColorTranslationId"] = id }).Result;

        ProcessDialogResult(result);
    }

    private async void Edit(long id)
    {
        DialogResult result = await DialogService.Show<ColorTranslationDialog>(null, new DialogParameters { ["Title"] = "Edit Color Translation", ["IsEdit"] = true, ["ColorTranslationId"] = id }).Result;

        ProcessDialogResult(result);
    }

    private void ProcessDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }
}
