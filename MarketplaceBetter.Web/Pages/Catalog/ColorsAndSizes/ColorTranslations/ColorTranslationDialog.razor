@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Base
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Base.Interfaces
@using MarketplaceBetter.Services.Settings.Interfaces;
@using MarketplaceBetter.Services.Validation.Catalog.ColorsAndSizes.Interfaces

@inject ISnackbar Snackbar
@inject IColorTranslationService ColorTranslationService
@inject IColorTranslationValidator ColorTranslationValidator
@inject IInstanceService InstanceService
@inject IBrandService BrandService
@inject IColorGroupService ColorGroupService
@inject IColorService ColorService
@inject ICurrentBrandSetting CurrentBrandSetting
@inject ICurrentInstanceSetting CurrentInstanceSetting

<EditForm Model="ColorTranslation" OnValidSubmit="@HandleValidSubmit">
	<CustomValidation @ref="CustomValidation" />
	<FormDialog Title=@Title>
		<DataAnnotationsValidator />
		<MudSelect Label="Instance" T="InstanceModel" @bind-Value="ColorTranslation.Instance" For="() => ColorTranslation.Instance">
			@foreach (var instance in Instances)
			{
				<MudSelectItem Value="instance">@instance.Name</MudSelectItem>
			}
		</MudSelect>
		<MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
			@foreach (var brand in Brands)
			{
				<MudSelectItem Value="brand">@brand.Name</MudSelectItem>
			}
		</MudSelect>
		<MudSelect Label="Color Group" T="ColorGroupModel" Value="ColorGroup" ValueChanged="HandleColorGroupChanged" Disabled="ColorGroupSelectDisabled">
			@foreach (var group in ColorGroups)
			{
				<MudSelectItem Value="group">@group.Name</MudSelectItem>
			}
		</MudSelect>
		<MudSelect Label="Color" T="ColorModel" @bind-Value="ColorTranslation.Color" For="() => ColorTranslation.Color" Disabled="ColorSelectDisabled">
			@foreach (var color in Colors)
			{
				<MudSelectItem Value="color">@color.Name</MudSelectItem>
			}
		</MudSelect>
		<MudTextField Label="Translation" @bind-Value="ColorTranslation.Translation" For="() => ColorTranslation.Translation" />
		<MudTextField Label="Mapping" @bind-Value="ColorTranslation.Mapping" For="() => ColorTranslation.Mapping" />
	</FormDialog>
</EditForm>

@code {
	[CascadingParameter] public MudDialogInstance MudDialog { get; set; }
	[Parameter] public string Title { get; set; }
	[Parameter] public bool IsEdit { get; set; }
	[Parameter] public bool AddingSimilar { get; set; }
	[Parameter] public long ColorTranslationId { get; set; }

	private CustomValidation CustomValidation = new();
	private ColorTranslationModel ColorTranslation = new();
	private BrandModel Brand;
	private ColorGroupModel ColorGroup;

	private IList<InstanceModel> Instances;
	private IList<BrandModel> Brands;
	private IList<ColorGroupModel> ColorGroups = new List<ColorGroupModel>();
	private IList<ColorModel> Colors = new List<ColorModel>();

	private bool ColorGroupSelectDisabled = true;
	private bool ColorSelectDisabled = true;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		Instances = InstanceService.GetAllNormal(true);
		Brands = BrandService.GetAll(true);

		if (IsEdit || AddingSimilar)
		{
			SetInitialValues();
		}
		else
		{
			if (CurrentBrandSetting.IsSpecificBrand())
			{
				SetValuesForCurrentBrand();
			}

			if (CurrentInstanceSetting.IsSpecificInstance())
			{
				SetValuesForCurrentInstance();
			}
		}
	}

	private void SetInitialValues()
	{
		ColorTranslation = ColorTranslationService.Get(ColorTranslationId);
		if (AddingSimilar)
		{
			ColorTranslation.Id = 0;
		}

		ActivateColorGroup(ColorTranslation.Color.Group.Brand.Id);
		ActivateColor(ColorTranslation.Color.Group.Id);

		ColorTranslation.Instance = Instances.Single(i => i.Id == ColorTranslation.Instance.Id);
		Brand = Brands.Single(b => b.Id == ColorTranslation.Color.Group.Brand.Id);
		ColorGroup = ColorGroups.Single(g => g.Id == ColorTranslation.Color.Group.Id);
		ColorTranslation.Color = Colors.Single(c => c.Id == ColorTranslation.Color.Id);
	}

	private void SetValuesForCurrentBrand()
	{
		BrandModel currentBrand = Brands.Single(b => b.Id == CurrentBrandSetting.GetCurrentBrand().Id);

		HandleBrandChanged(currentBrand);
	}

	private void SetValuesForCurrentInstance()
	{
		InstanceModel currentInstance = Instances.Single(b => b.Id == CurrentInstanceSetting.GetCurrentInstance().Id);

		HandleInstanceChanged(currentInstance);
	}

	private void HandleBrandChanged(BrandModel brand)
	{
		Brand = brand;

		ResetColorGroup();
		ActivateColorGroup(brand.Id);

		ResetColor();
	}

	private void HandleInstanceChanged(InstanceModel instance)
	{
		ColorTranslation.Instance = instance;
	}

	private void HandleColorGroupChanged(ColorGroupModel group)
	{
		ColorGroup = group;

		ResetColor();
		ActivateColor(group.Id);
	}

	private void ResetColorGroup()
	{
		ColorGroup = null;
		ColorGroupSelectDisabled = true;
		ColorGroups = new List<ColorGroupModel>();
	}

	private void ActivateColorGroup(long brandId)
	{
		ColorGroupSelectDisabled = false;
		ColorGroups = ColorGroupService.GetAllForBrand(brandId);
	}

	private void ResetColor()
	{
		ColorTranslation.Color = null;
		ColorSelectDisabled = true;
		Colors = new List<ColorModel>();
	}

	private void ActivateColor(long colorGroupId)
	{
		ColorSelectDisabled = false;
		Colors = ColorService.GetAllForGroup(colorGroupId);
	}

	private void HandleValidSubmit()
	{
		ValidationResult result = ColorTranslationValidator.Validate(ColorTranslation);

		if (result.IsValid)
		{
			if (IsEdit)
			{
				ColorTranslationService.Update(ColorTranslation);
				Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Color Translation"));
			}
			else
			{
				ColorTranslationService.Add(ColorTranslation);
				Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Color Translation"));
			}

			MudDialog.Close();
		}
		else
		{
			CustomValidation.DisplayErrors(result.Errors);
		}
	}
}