@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Model

@page "/colors"
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IColorService ColorService

<MudText Typo="Typo.h4" Class="mt-2">Colors</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ColorModel>>>(Reload))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString"  Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
            <MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Color</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="ColorModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="name" T="ColorModel">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="code" T="ColorModel">Code</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ColorModel">Brand</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="group" T="ColorModel">Group</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Code">@context.Code</MudTd>
            <MudTd DataLabel="Brand">@context.Group.Brand.Name</MudTd>
            <MudTd DataLabel="Group">@context.Group.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Edit(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

    private MudTable<ColorModel> Table;
	private ListRequest ListRequest = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
    }

	private Task<TableData<ColorModel>> Reload(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<ColorModel> colors = ColorService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<ColorModel>() { TotalItems = ColorService.CountForListRequest(ListRequest), Items = colors });
	}

	private void Filter(string searchString)
	{
		ListRequest.SearchString = searchString;

        string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
        Navigation.NavigateTo(newUrl, replace: true);

		Table.ReloadServerData();

		StateHasChanged();
	}

    private async void Add()
    {
        DialogResult result = await DialogService.Show<ColorDialog>(null, new DialogParameters { ["Title"] = "Add Color" }).Result;

        ProcessDialogResult(result);
    }

    private async void Edit(long id)
    {
        DialogResult result = await DialogService.Show<ColorDialog>(null, new DialogParameters { ["Title"] = "Edit Color", ["IsEdit"] = true, ["ColorId"] = id }).Result;

        ProcessDialogResult(result);
    }

    private void ProcessDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }
}
