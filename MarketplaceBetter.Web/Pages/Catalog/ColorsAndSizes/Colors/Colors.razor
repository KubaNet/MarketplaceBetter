@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Model

@page "/colors"
@inject IColorService ColorService
@inject IDialogService DialogService

<MudText Typo="Typo.h3" Class="mt-2">Colors</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ColorModel>>>(ReloadColors))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
			<MudTextField Placeholder="Search" T="string" ValueChanged="FilterColors" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
            <MudButton OnClick="AddColor" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Color</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="ColorModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="name" T="ColorModel">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="code" T="ColorModel">Code</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ColorModel">Brand</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="group" T="ColorModel">Group</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Code">@context.Code</MudTd>
            <MudTd DataLabel="Brand">@context.Group.Brand.Name</MudTd>
            <MudTd DataLabel="Group">@context.Group.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditColor(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<ColorModel> Table;
	private ListRequest ListRequest = new();

	private Task<TableData<ColorModel>> ReloadColors(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<ColorModel> colors = ColorService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<ColorModel>() { TotalItems = ColorService.CountForListRequest(ListRequest), Items = colors });
	}

	private void FilterColors(string searchString)
	{
		ListRequest.SearchString = searchString;

		Table.ReloadServerData();

		StateHasChanged();
	}

    private async void AddColor()
    {
        var result = await DialogService.Show<ColorDialog>(null, new DialogParameters { ["Title"] = "Add Color" }).Result;

        ProcessColorDialogResult(result);
    }

    private async void EditColor(long id)
    {
        var result = await DialogService.Show<ColorDialog>(null, new DialogParameters { ["Title"] = "Edit Color", ["IsEdit"] = true, ["ColorId"] = id }).Result;

        ProcessColorDialogResult(result);
    }

    private void ProcessColorDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
