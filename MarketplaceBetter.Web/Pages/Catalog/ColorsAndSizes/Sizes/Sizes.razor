@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Model

@page "/sizes"
@inject ISizeService SizeService
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mt-2">Sizes</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<SizeModel>>>(ReloadSizes))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
			<MudTextField Placeholder="Search" T="string" ValueChanged="FilterSizes" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
            <MudButton OnClick="AddSize" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Size</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="SizeModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="name" T="SizeModel">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="code" T="SizeModel">Code</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="is_one_size" T="SizeModel">Is One Size</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="group" T="SizeModel">Group</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ColorModel">Brand</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Code">@context.Code</MudTd>
            <MudTd DataLabel="Is One Size"><MudCheckBox T="bool" Checked="@context.IsOneSize" Disabled="true"></MudCheckBox></MudTd>
            <MudTd DataLabel="Group">@context.Group.Name</MudTd>
            <MudTd DataLabel="Brand">@context.Group.Brand.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditSize(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<SizeModel> Table;
	private ListRequest ListRequest = new();

	private Task<TableData<SizeModel>> ReloadSizes(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<SizeModel> colors = SizeService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<SizeModel>() { TotalItems = SizeService.CountForListRequest(ListRequest), Items = colors });
	}

	private void FilterSizes(string searchString)
	{
		ListRequest.SearchString = searchString;

		Table.ReloadServerData();

		StateHasChanged();
	}

    private async void AddSize()
    {
        var result = await DialogService.Show<SizeDialog>(null, new DialogParameters { ["Title"] = "Add Size" }).Result;

        ProcessSizeDialogResult(result);
    }

    private async void EditSize(long id)
    {
        var result = await DialogService.Show<SizeDialog>(null, new DialogParameters { ["Title"] = "Edit Size", ["IsEdit"] = true, ["SizeId"] = id }).Result;

        ProcessSizeDialogResult(result);
    }

    private void ProcessSizeDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }
}
