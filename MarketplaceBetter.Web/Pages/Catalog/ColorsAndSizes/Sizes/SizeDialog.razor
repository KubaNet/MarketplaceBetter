@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Settings.Interfaces;
@using MarketplaceBetter.Services.Validation.Catalog.ColorsAndSizes.Interfaces

@inject ISnackbar Snackbar
@inject ISizeService SizeService
@inject IBrandService BrandService
@inject ISizeGroupService SizeGroupService
@inject ISizeValidator SizeValidator
@inject ICurrentBrandSetting CurrentBrandSetting

<EditForm Model="Size" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Group" T="SizeGroupModel" @bind-Value="Size.Group" For="() => Size.Group" Disabled="SizeGroupSelectDisabled">
            @foreach (var group in SizeGroups)
            {
                <MudSelectItem Value="group">@group.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Name" @bind-Value="Size.Name" For="() => Size.Name" />
        <MudTextField Label="Code" @bind-Value="Size.Code" For="() => Size.Code" />
        <MudCheckBox Label="Is One Size" @bind-Checked="Size.IsOneSize" For="() => Size.IsOneSize" Color="Color.Primary"></MudCheckBox>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long SizeId { get; set; }

    private CustomValidation CustomValidation = new();
    private SizeModel Size = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<SizeGroupModel> SizeGroups = new List<SizeGroupModel>();

    private bool SizeGroupSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);

        if (IsEdit)
        {
            SetInitialValues();
        }
        else
        {
            if (CurrentBrandSetting.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }
        }
    }

    private void SetInitialValues()
    {
        Size = SizeService.Get(SizeId);

        ActivateSizeGroup(Size.Group.Brand.Id);

        Brand = Brands.Single(b => b.Id == Size.Group.Brand.Id);
        Size.Group = SizeGroups.Single(g => g.Id == Size.Group.Id);
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == CurrentBrandSetting.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetSizeGroup();
        ActivateSizeGroup(brand.Id);
    }

    private void ResetSizeGroup()
    {
        Size.Group = null;
        SizeGroupSelectDisabled = true;
        SizeGroups = new List<SizeGroupModel>();
    }

    private void ActivateSizeGroup(long brandId)
    {
        SizeGroupSelectDisabled = false;
        SizeGroups = SizeGroupService.GetAllForBrand(brandId);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = SizeValidator.Validate(Size);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                SizeService.Update(Size);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Size"));
            }
            else
            {
                SizeService.Add(Size);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Size"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}