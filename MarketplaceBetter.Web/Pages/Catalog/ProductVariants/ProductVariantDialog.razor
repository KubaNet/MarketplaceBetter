@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Validation.Catalog.Interfaces

@inject IProductVariantService ProductVariantService
@inject IProductVariantValidator ProductVariantValidator
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IColorService ColorService
@inject ISizeService SizeService
@inject ISnackbar Snackbar

<EditForm Model="ProductVariant" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="ProductVariant.Product" For="() => ProductVariant.Product" ValueChanged="HandleProductChanged" Disabled="ProductSelectDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Color" T="ColorModel" Value="ProductVariant.Color" For="() => ProductVariant.Color" ValueChanged="HandleColorChanged" Disabled="ColorSelectDisabled">
            @foreach (var color in Colors)
            {
                <MudSelectItem Value="color">@color.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Size" T="SizeModel" Value="ProductVariant.Size" For="() => ProductVariant.Size" ValueChanged="HandleSizeChanged" Disabled="SizeSelectDisabled">
            @foreach (var size in Sizes)
            {
                <MudSelectItem Value="size">@size.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Sku" @bind-Value="ProductVariant.Sku" For="() => ProductVariant.Sku" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool AddingSimilar { get; set; }
    [Parameter] public long ProductVariantId { get; set; }

    private CustomValidation CustomValidation = new();
    private ProductVariantModel ProductVariant = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<ColorModel> Colors = new List<ColorModel>();
    private IList<SizeModel> Sizes = new List<SizeModel>();

    private bool ProductSelectDisabled = true;
    private bool ColorSelectDisabled = true;
    private bool SizeSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();

        if (IsEdit || AddingSimilar)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        ProductVariant = ProductVariantService.Get(ProductVariantId);
        if (AddingSimilar)
        {
            ProductVariant.Id = 0;
        }

        ActivateProduct(ProductVariant.Product.Brand.Id);
        ActivateColor(ProductVariant.Product.ColorGroup.Id);
        ActivateSize(ProductVariant.Product.SizeGroup.Id);

        Brand = Brands.Single(b => b.Id == ProductVariant.Product.Brand.Id);
        ProductVariant.Product = Products.Single(p => p.Id == ProductVariant.Product.Id);
        ProductVariant.Color = Colors.Single(c => c.Id == ProductVariant.Color.Id);
        ProductVariant.Size = Sizes.Single(s => s.Id == ProductVariant.Size.Id);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ResetColor();
        ResetSize();

        ActivateProduct(brand.Id);

        ProductVariant.Sku = brand.Code;
    }

    private void HandleProductChanged(ProductModel product)
    {
        ProductVariant.Product = product;

        ResetColor();
        ResetSize();

        ActivateColor(product.ColorGroup.Id);
        ActivateSize(product.SizeGroup.Id);

        SetVariantSku();
    }

    private void HandleColorChanged(ColorModel color)
    {
        ProductVariant.Color = color;

        SetVariantSku();
    }

    private void HandleSizeChanged(SizeModel size)
    {
        ProductVariant.Size = size;

        SetVariantSku();
    }

    private void ResetProduct()
    {
        ProductVariant.Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId).OrderBy(p => p.Name).ToList();
    }

    private void ResetColor()
    {
        ProductVariant.Color = null;
        ColorSelectDisabled = true;
        Colors = new List<ColorModel>();
    }

    private void ActivateColor(long colorGroupId)
    {
        ColorSelectDisabled = false;
        Colors = ColorService.GetAllForGroup(colorGroupId).OrderBy(p => p.Name).ToList();
    }

    private void ResetSize()
    {
        ProductVariant.Size = null;
        SizeSelectDisabled = true;
        Sizes = new List<SizeModel>();
    }

    private void ActivateSize(long sizeGroupId)
    {
        SizeSelectDisabled = false;
        Sizes = SizeService.GetAllForGroup(sizeGroupId).OrderBy(p => p.Name).ToList();
    }

    private void SetVariantSku()
    {
        if (ProductVariant.Product != null)
        {
            ProductVariant.Sku = string.Format("{0}_{1}", ProductVariant.Product.Brand.Code, ProductVariant.Product.Code);

            if (ProductVariant.Color != null)
            {
                ProductVariant.Sku += string.Format("_{0}", ProductVariant.Color.Code);

                if (ProductVariant.Size != null)
                {
                    ProductVariant.Sku += string.Format("_{0}", ProductVariant.Size.Code);
                }
            }
        }
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ProductVariantValidator.Validate(ProductVariant);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ProductVariantService.Update(ProductVariant);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Product Variant"));
            }
            else
            {
                ProductVariantService.Add(ProductVariant);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Product Variant"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}