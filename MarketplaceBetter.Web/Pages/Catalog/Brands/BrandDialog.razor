@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Validation.Catalog.Interfaces

@inject IBrandService BrandService
@inject IBrandValidator BrandValidator
@inject ISnackbar Snackbar

<EditForm Model="Brand" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudTextField Label="Name" @bind-Value="Brand.Name" For="() => Brand.Name" />
        <MudTextField Label="Code" @bind-Value="Brand.Code" For="() => Brand.Code" UserAttributes="@(new Dictionary<string, object>() { { "maxlength", "3" } })" />
    </FormDialog>
</EditForm>

@code {
    CustomValidation CustomValidation = new();
    BrandModel Brand = new();

    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long BrandId { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (IsEdit)
        {
            Brand = BrandService.Get(BrandId);
        }
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = BrandValidator.Validate(Brand);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                BrandService.Update(Brand);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Brand"));
            }
            else
            {
                BrandService.Add(Brand);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Brand"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}