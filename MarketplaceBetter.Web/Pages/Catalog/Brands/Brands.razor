@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces

@page "/brands"
@inject IBrandService BrandService
@inject IDialogService DialogService

<MudText Typo="Typo.h3">Brands</MudText>

<MainBody>
    <MudTable Items="@BrandsData" Dense="true">
        <ToolBarContent>
            <MudButton OnClick="AddBrand" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Brand</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Code</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Code">@context.Code</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private IList<BrandModel> BrandsData { get; set; }

    private async void AddBrand()
    {
        var dialog = DialogService.Show<AddBrandDialog>();
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            BrandsData = BrandService.GetBrands();

            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        BrandsData = BrandService.GetBrands();
    }
}
