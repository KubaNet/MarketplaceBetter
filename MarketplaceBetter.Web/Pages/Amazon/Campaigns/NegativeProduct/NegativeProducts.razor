@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Model

@page "/negative-products"
@inject INegativeProductService NegativeProductService
@inject IDialogService DialogService

<MudText Typo="Typo.h3" Class="mt-2">Negative Products</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<NegativeProductModel>>>(ReloadNegativeProducts))" Dense="true" Hover="true" RowsPerPage="15">
        <ToolBarContent>
            <MudTextField Placeholder="Search" T="string" ValueChanged="FilterNegativeProducts" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="AddNegativeProduct" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Negative Product</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="NegativeProductModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="asin" T="NegativeProductModel">ASIN</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="status" T="NegativeProductModel">Status</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="amazonid" T="NegativeProductModel">Amazon Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="campaign" T="NegativeProductModel">Campaign</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="ASIN">@context.Asin</MudTd>
            <MudTd DataLabel="Status"><NegativeProductStatusDisplay NegativeProduct="context" /></MudTd>
            <MudTd DataLabel="AmazonId">@context.AmazonId</MudTd>
            <MudTd DataLabel="Campaign">@context.AdGroup.Campaign.Name</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => AddSimilarNegativeProduct(context.Id))">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditNegativeProduct(context.Id))">Edit</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<NegativeProductModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<NegativeProductModel>> ReloadNegativeProducts(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<NegativeProductModel> parents = NegativeProductService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<NegativeProductModel>() { TotalItems = NegativeProductService.CountForListRequest(ListRequest), Items = parents });
    }

    private void FilterNegativeProducts(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddNegativeProduct()
    {
        var result = await DialogService.Show<NegativeProductDialog>(null, new DialogParameters { ["Title"] = "Add Negative Product" }).Result;

        ProcessNegativeProductDialogResult(result);
    }

    private async void AddSimilarNegativeProduct(long id)
    {
        var result = await DialogService.Show<NegativeProductDialog>(null, new DialogParameters { ["Title"] = "Add Negative Product", ["AddingSimilar"] = true, ["NegativeProductId"] = id }).Result;

        ProcessNegativeProductDialogResult(result);
    }

    private async void EditNegativeProduct(long id)
    {
        var result = await DialogService.Show<NegativeProductDialog>(null, new DialogParameters { ["Title"] = "Edit Negative Product", ["IsEdit"] = true, ["NegativeProductId"] = id }).Result;

        ProcessNegativeProductDialogResult(result);
    }

    private void ProcessNegativeProductDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
