@using MarketplaceBetter.Domain.Entities.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Base
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Base.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Campaigns.Interfaces

@inject INegativeProductService NegativeProductService
@inject INegativeProductValidator NegativeProductValidator
@inject IInstanceService InstanceService
@inject IBrandService BrandService
@inject IProductService ProductService
@inject ICampaignService CampaignService
@inject IAdGroupService AdGroupService
@inject ISnackbar Snackbar

<EditForm Model="NegativeProduct" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged" Disabled="IsEdit">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="Product" For="() => Product" ValueChanged="HandleProductChanged" Disabled="ProductSelectDisabled || IsEdit">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Instance" T="InstanceModel" Value="Instance" For="() => Instance" ValueChanged="HandleInstanceChanged" Disabled="InstanceSelectDisabled || IsEdit">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Campaign" T="CampaignModel" @bind-Value="Campaign" For="() => Campaign" Disabled="CampaignSelectDisabled || IsEdit">
            @foreach (var campaign in Campaigns)
            {
                <MudSelectItem Value="campaign">@campaign.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Asin" @bind-Value="NegativeProduct.Asin" For="() => NegativeProduct.Asin" Disabled="IsEdit" />
        <MudTextField Label="Amazon Id" @bind-Value="NegativeProduct.AmazonId" For="() => NegativeProduct.AmazonId" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool AddingSimilar { get; set; }
    [Parameter] public long NegativeProductId { get; set; }

    private CustomValidation CustomValidation = new();
    private NegativeProductModel NegativeProduct = new();
    private BrandModel Brand;
    private ProductModel Product;
    private InstanceModel Instance;
    private CampaignModel Campaign;

    private IList<BrandModel> Brands;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<InstanceModel> Instances;
    private IList<CampaignModel> Campaigns = new List<CampaignModel>();

    private bool ProductSelectDisabled = true;
    private bool InstanceSelectDisabled = true;
    private bool CampaignSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);
        Instances = InstanceService.GetAllNormal();

        if (IsEdit || AddingSimilar)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        NegativeProduct = NegativeProductService.Get(NegativeProductId);
        if (AddingSimilar)
        {
            NegativeProduct.Id = 0;
            NegativeProduct.AmazonId = null;
        }

        ActivateProduct(NegativeProduct.AdGroup.Campaign.Product.Brand.Id);
        ActivateInstance();
        ActivateCampaign(NegativeProduct.AdGroup.Campaign.Instance.Id, NegativeProduct.AdGroup.Campaign.Product.Id);

        Brand = Brands.Single(b => b.Id == NegativeProduct.AdGroup.Campaign.Product.Brand.Id);
        Product = Products.Single(p => p.Id == NegativeProduct.AdGroup.Campaign.Product.Id);
        Instance = Instances.Single(i => i.Id == NegativeProduct.AdGroup.Campaign.Instance.Id);
        Campaign = Campaigns.Single(c => c.Id == NegativeProduct.AdGroup.Campaign.Id);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);

        ResetInstance();
        ResetCampaign();
    }

    private void HandleProductChanged(ProductModel product)
    {
        Product = product;

        ResetInstance();
        ActivateInstance();

        ResetCampaign();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        Instance = instance;

        ResetCampaign();
        ActivateCampaign(instance.Id, Product.Id);
    }

    private void ResetProduct()
    {
        Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void ResetInstance()
    {
        Instance = null;
        InstanceSelectDisabled = true;
    }

    private void ActivateInstance()
    {
        InstanceSelectDisabled = false;
    }

    private void ResetCampaign()
    {
        Campaign = null;
        CampaignSelectDisabled = true;
        Campaigns = new List<CampaignModel>();
    }

    private void ActivateCampaign(long instanceId, long productId)
    {
        CampaignSelectDisabled = false;
        Campaigns = CampaignService.GetForInstanceAndProduct(instanceId, productId);
    }

    private void HandleValidSubmit()
    {
        NegativeProduct.AdGroup = AdGroupService.GetForCampaign(Campaign.Id);

        ValidationResult result = NegativeProductValidator.Validate(NegativeProduct);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                NegativeProductService.Update(NegativeProduct);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Negative Product"));
            }
            else
            {
                NegativeProductService.Add(NegativeProduct, Campaign);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Negative Product"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}