@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Campaigns.Interfaces
@using System.IO

@inject IAmazonTargetingService AmazonTargetingService
@inject IAmazonTargetingValidator AmazonTargetingValidator
@inject IInstanceService InstanceService
@inject ICampaignService AmazonCampaignService
@inject ISnackbar Snackbar

<EditForm Model="AmazonTargeting" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Instance" T="InstanceModel" Value="Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Campaign" T="CampaignModel" Value="AmazonTargeting.Campaign" For="() => AmazonTargeting.Campaign" ValueChanged="HandleCampaignChanged" Disabled="CampaignSelectDisabled">
            @foreach (var campaign in Campaigns)
            {
                <MudSelectItem Value="campaign">@campaign.Name</MudSelectItem>
            }
        </MudSelect>
        <InputFile id="FileInput" OnChange="UploadFile" hidden />
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Filled.CloudUpload" for="FileInput" Class="mt-4">
            Upload File
        </MudButton>
        @if (File != null)
        {
            <MudList>
                <MudListItem Icon="@Icons.Filled.AttachFile">
                    @File.Name <code>@File.Size bytes</code>
                </MudListItem>
            </MudList>
        }
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }

    private CustomValidation CustomValidation = new();
    private AmazonTargetingModel AmazonTargeting = new();
    private InstanceModel Instance;

    private IList<InstanceModel> Instances;
    private IList<CampaignModel> Campaigns = new List<CampaignModel>();
    private IBrowserFile File;

    private bool CampaignSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Instances = InstanceService.GetAll();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        Instance = instance;

        ResetCampaign();
        ActivateCampaign(instance.Id);
    }

    private void HandleCampaignChanged(CampaignModel campaign)
    {
        AmazonTargeting.Campaign = campaign;
    }

    private void ResetCampaign()
    {
        AmazonTargeting.Campaign = null;
        CampaignSelectDisabled = true;
        Campaigns = new List<CampaignModel>();
    }

    private void ActivateCampaign(long instanceId)
    {
        CampaignSelectDisabled = false;
        Campaigns = AmazonCampaignService.GetForInstance(instanceId);
    }

    private void UploadFile(InputFileChangeEventArgs e)
    {
        File = e.File;
    }

    private async void HandleValidSubmit()
    {
        ValidationResult result = AmazonTargetingValidator.Validate(AmazonTargeting);

        if (result.IsValid)
        {
            MemoryStream memoryStream = new MemoryStream();
            await File.OpenReadStream().CopyToAsync(memoryStream);
            memoryStream.Seek(0, SeekOrigin.Begin);

            AmazonTargetingService.Add(AmazonTargeting, memoryStream);
            Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Amazon Targeting"));

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}