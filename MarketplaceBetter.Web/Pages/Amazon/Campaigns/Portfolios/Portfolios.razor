@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Model
@using System.IO

@page "/portfolios"
@inject IJSRuntime JS
@inject IPortfolioService PortfolioService
@inject IDialogService DialogService

<MudText Typo="Typo.h3" Class="mt-2">Portfolios</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<PortfolioModel>>>(ReloadPortfolios))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
            <MudTextField Placeholder="Search" T="string" ValueChanged="FilterPortfolios" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="AddPortfolio" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Portfolio</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="PortfolioModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="name" T="PortfolioModel">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="amazonid" T="PortfolioModel">Amazon Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="PortfolioModel">Instance</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="AmazonId">@context.AmazonId</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditPortfolio(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<PortfolioModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<PortfolioModel>> ReloadPortfolios(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<PortfolioModel> portoflios = PortfolioService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<PortfolioModel>() { TotalItems = PortfolioService.CountForListRequest(ListRequest), Items = portoflios });
    }

    private void FilterPortfolios(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddPortfolio()
    {
        var result = await DialogService.Show<PortfolioDialog>(null, new DialogParameters { ["Title"] = "Add Portfolio" }).Result;

        ProcessPortfolioDialogResult(result);
    }

    private async void EditPortfolio(long id)
    {
        var result = await DialogService.Show<PortfolioDialog>(null, new DialogParameters { ["Title"] = "Edit Portfolio", ["IsEdit"] = true, ["PortfolioId"] = id }).Result;

        ProcessPortfolioDialogResult(result);
    }

    private void ProcessPortfolioDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
