@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Model

@page "/negative-keywords"
@inject INegativeKeywordService NegativeKeywordService
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mt-2">Negative Keywords</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<NegativeKeywordModel>>>(ReloadNegativeKeywords))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
            <MudTextField Placeholder="Search" T="string" ValueChanged="FilterNegativeKeywords" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="AddNegativeKeyword" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Negative Keyword</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="NegativeKeywordModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="keyword" T="NegativeKeywordModel">Keyword</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="matchtype" T="NegativeKeywordModel">Match Type</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="status" T="NegativeKeywordModel">Status</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="amazonid" T="NegativeKeywordModel">Amazon Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="campaign" T="NegativeKeywordModel">Campaign</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Keyword">@context.Keyword</MudTd>
            <MudTd DataLabel="MatchType">@context.MatchType.Name</MudTd>
            <MudTd DataLabel="Status"><NegativeKeywordStatusDisplay NegativeKeyword="context" /></MudTd>
            <MudTd DataLabel="AmazonId">@context.AmazonId</MudTd>
            <MudTd DataLabel="Campaign">@context.AdGroup.Campaign.Name</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => AddSimilarNegativeKeyword(context.Id))">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditNegativeKeyword(context.Id))">Edit</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<NegativeKeywordModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<NegativeKeywordModel>> ReloadNegativeKeywords(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<NegativeKeywordModel> parents = NegativeKeywordService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<NegativeKeywordModel>() { TotalItems = NegativeKeywordService.CountForListRequest(ListRequest), Items = parents });
    }

    private void FilterNegativeKeywords(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddNegativeKeyword()
    {
        DialogResult result = await DialogService.Show<NegativeKeywordDialog>(null, new DialogParameters { ["Title"] = "Add Negative Keyword" }).Result;

        ProcessNegativeKeywordDialogResult(result);
    }

    private async void AddSimilarNegativeKeyword(long id)
    {
        DialogResult result = await DialogService.Show<NegativeKeywordDialog>(null, new DialogParameters { ["Title"] = "Add Negative Keyword", ["AddingSimilar"] = true, ["NegativeKeywordId"] = id }).Result;

        ProcessNegativeKeywordDialogResult(result);
    }

    private async void EditNegativeKeyword(long id)
    {
        DialogResult result = await DialogService.Show<NegativeKeywordDialog>(null, new DialogParameters { ["Title"] = "Edit Negative Keyword", ["IsEdit"] = true, ["NegativeKeywordId"] = id }).Result;

        ProcessNegativeKeywordDialogResult(result);
    }

    private void ProcessNegativeKeywordDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }
}
