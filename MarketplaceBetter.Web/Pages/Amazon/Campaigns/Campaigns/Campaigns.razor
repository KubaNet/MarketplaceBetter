@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Model
@using System.IO

@page "/campaigns"
@inject IJSRuntime JS
@inject ICampaignService CampaignService
@inject IDialogService DialogService

<MudText Typo="Typo.h3" Class="mt-2">Campaigns</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<CampaignModel>>>(ReloadCampaigns))" Dense="true" Hover="true" RowsPerPage="15">
        <ToolBarContent>
            <MudTextField Placeholder="Search" T="string" ValueChanged="FilterCampaigns" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="Export" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Upload" Color="Color.Info">Export</MudButton>
            <MudButton OnClick="AddCampaign" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Campaign</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="CampaignModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="name" T="CampaignModel">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product" T="CampaignModel">Product</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="CampaignModel">Brand</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="strategy" T="CampaignModel">Strategy</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="status" T="CampaignModel">Status</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="amazonid" T="CampaignModel">Amazon Id</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Product">@context.Product.Name</MudTd>
            <MudTd DataLabel="Brand">@context.Product?.Brand.Name</MudTd>
            <MudTd DataLabel="Strategy">@context.Strategy.Name</MudTd>
            <MudTd DataLabel="Status"><CampaignStatusDisplay Campaign="context" /></MudTd>
            <MudTd DataLabel="AmazonId">@context.AmazonId</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<CampaignModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<CampaignModel>> ReloadCampaigns(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<CampaignModel> campaigns = CampaignService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<CampaignModel>() { TotalItems = CampaignService.CountForListRequest(ListRequest), Items = campaigns });
    }

    private void FilterCampaigns(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddCampaign()
    {
        var result = await DialogService.Show<CampaignDialog>(null, new DialogParameters { ["Title"] = "Add Campaign" }).Result;

        ProcessCampaignDialogResult(result);
    }

    private async void EditCampaign(long id)
    {
        var result = await DialogService.Show<CampaignDialog>(null, new DialogParameters { ["Title"] = "Edit Campaign", ["IsEdit"] = true, ["CampaignId"] = id }).Result;

        ProcessCampaignDialogResult(result);
    }

    private void ProcessCampaignDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }

    private async void Export()
    {
        Stream fileStream = CampaignService.Export();

        using var streamRef = new DotNetStreamReference(stream: fileStream);

        await JS.InvokeVoidAsync("DownloadFileFromStream", $"Campaigns.csv", streamRef);
    }
}
