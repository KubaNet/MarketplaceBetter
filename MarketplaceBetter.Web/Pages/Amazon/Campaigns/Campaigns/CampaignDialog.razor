@using MarketplaceBetter.Domain.Entities.Amazon.Campaigns
@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Campaigns.Interfaces

@inject ICampaignService CampaignService
@inject IAmazonCampaignValidator CampaignValidator
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IInstanceService InstanceService
@inject ICampaignTypeService TypeService
@inject ICampaignStrategyService StrategyService
@inject ISnackbar Snackbar

<EditForm Model="Campaign" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Instance" T="InstanceModel" Value="Campaign.Instance" For="() => Campaign.Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Type" T="CampaignTypeModel" Value="Campaign.Type" For="() => Campaign.Type" ValueChanged="HandleTypeChanged">
            @foreach (var type in Types)
            {
                <MudSelectItem Value="type">@type.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Strategy" T="CampaignStrategyModel" Value="Campaign.Strategy" For="() => Campaign.Strategy" ValueChanged="HandleStrategyChanged" Disabled="StrategySelectDisabled">
            @foreach (var strategy in Strategies)
            {
                <MudSelectItem Value="strategy">@strategy.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="Campaign.Product" For="() => Campaign.Product" ValueChanged="HandleProductChanged" Disabled="ProductSelectDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Name" @bind-Value="Campaign.Name" For="() => Campaign.Name" />
        <MudTextField Label="Amazon Id" @bind-Value="Campaign.AmazonId" For="() => Campaign.AmazonId" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long CampaignId { get; set; }

    private CustomValidation CustomValidation = new();
    private CampaignModel Campaign = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<InstanceModel> Instances;
    private IList<CampaignTypeModel> Types;
    private IList<CampaignStrategyModel> Strategies = new List<CampaignStrategyModel>();

    private bool ProductSelectDisabled = true;
    private bool StrategySelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();
        Instances = InstanceService.GetAll();
        Types = TypeService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        Campaign = CampaignService.Get(CampaignId);

        ActivateProduct(Campaign.Product.Brand.Id);

        Campaign.Instance = Instances.Single(i => i.Id == Campaign.Instance.Id);
        Brand = Brands.Single(b => b.Id == Campaign.Product.Brand.Id);
        Campaign.Product = Products.Single(p => p.Id == Campaign.Product.Id);
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        Campaign.Instance = instance;
        SetCampaignName();
    }

    private void HandleTypeChanged(CampaignTypeModel type)
    {
        Campaign.Type = type;

        ResetStrategy();
        ActivateStrategy(type.SystemName);
        SetCampaignName();
    }

    private void HandleStrategyChanged(CampaignStrategyModel strategy)
    {
        Campaign.Strategy = strategy;

        SetCampaignName();
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);
    }

    private void HandleProductChanged(ProductModel product)
    {
        Campaign.Product = product;

        SetCampaignName();
        SetCampaignName();
    }

    private void ResetProduct()
    {
        Campaign.Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void ResetStrategy()
    {
        Campaign.Strategy = null;
        StrategySelectDisabled = true;
        Strategies = new List<CampaignStrategyModel>();
    }

    private void ActivateStrategy(CampaignTypeEnum type)
    {
        StrategySelectDisabled = false;
        Strategies = StrategyService.GetAllByCampaignType(type);
    }

    private void SetCampaignName()
    {
        Campaign.Name = CampaignHelper.GetNameFor(Campaign.Instance, Campaign.Type, Campaign.Strategy, Campaign.Product);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = CampaignValidator.Validate(Campaign);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                CampaignService.Update(Campaign);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Campaign"));
            }
            else
            {
                CampaignService.Add(Campaign);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Campaign"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}