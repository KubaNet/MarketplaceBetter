@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Interfaces
@using System.IO

@inject IKeywordDataService KeywordDataService
@inject IKeywordDataValidator KeywordDataValidator
@inject IKeywordAnalysisService KeywordAnalysisService
@inject IMainPhraseService MainPhraseService
@inject IKeywordDataSourceService KeywordDataSourceService
@inject ISnackbar Snackbar

<EditForm Model="KeywordData" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudSelect T="KeywordAnalysisModel" Value="Analysis" Label="Analysis" ValueChanged="HandleAnalysisChanged">
            @foreach (var analysis in Analyses)
            {
                <MudSelectItem Value="analysis">@analysis.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="MainPhraseModel" @bind-Value="KeywordData.MainPhrase" Label="Main Phrase" For="() => KeywordData.MainPhrase" Disabled="MainPhraseSelectDisabled">
            @foreach (var mainPhrase in MainPhrases)
            {
                <MudSelectItem Value="mainPhrase">@mainPhrase.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="KeywordDataSourceModel" @bind-Value="KeywordData.Source" Label="Source" For="() => KeywordData.Source">
            @foreach (var source in Sources)
            {
                <MudSelectItem Value="source">@source.Name</MudSelectItem>
            }
        </MudSelect>
        <InputFile id="DataFile" OnChange="UploadFile" hidden accept=".csv, .txt" />
        <MudButton for="DataFile" HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Filled.CloudUpload">Upload file</MudButton>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }

    CustomValidation CustomValidation = new();
    KeywordDataModel KeywordData = new();
    KeywordAnalysisModel Analysis;
    string DataFilePath;

    IList<KeywordAnalysisModel> Analyses;
    IList<MainPhraseModel> MainPhrases = new List<MainPhraseModel>();
    IList<KeywordDataSourceModel> Sources;

    bool MainPhraseSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Analyses = KeywordAnalysisService.GetAll();
        Sources = KeywordDataSourceService.GetAll();
    }

    private void HandleAnalysisChanged(KeywordAnalysisModel analysis)
    {
        Analysis = analysis;

        ResetMainPhrase();
        ActivateMainPhrase(analysis.Id);
    }

    private void ResetMainPhrase()
    {
        KeywordData.MainPhrase = null;
        MainPhraseSelectDisabled = true;
        MainPhrases = new List<MainPhraseModel>();
    }

    private void ActivateMainPhrase(long analysisId)
    {
        MainPhraseSelectDisabled = false;
        MainPhrases = MainPhraseService.GetForAnalysis(analysisId).ToList();
    }

    private void HandleValidSubmit()
    {
        ValidationResult entityValidation = KeywordDataValidator.Validate(KeywordData);

        if (entityValidation.IsValid)
        {
            using FileStream dataFileStream = new(DataFilePath, FileMode.Open);

            ValidationResult dataFileValidation = KeywordDataValidator.ValidateDataFile(dataFileStream, KeywordData.Source.SystemName);

            if (dataFileValidation.IsValid)
            {
                KeywordDataService.Add(KeywordData, dataFileStream);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Keyword Data"));

                File.Delete(DataFilePath);

                MudDialog.Close();
            }
            else
            {
                File.Delete(DataFilePath);
            }
        }
        else
        {
            CustomValidation.DisplayErrors(entityValidation.Errors);
        }
    }

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        DataFilePath = Path.GetTempFileName();

        await using FileStream dataFileStream = new(DataFilePath, FileMode.Create);

        await e.File.OpenReadStream().CopyToAsync(dataFileStream);

        dataFileStream.Seek(0, SeekOrigin.Begin);
    }
}