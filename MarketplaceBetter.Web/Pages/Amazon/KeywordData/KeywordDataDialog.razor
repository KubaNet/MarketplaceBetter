@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Interfaces

@inject IKeywordDataService KeywordDataService
@inject IKeywordAnalysisService KeywordAnalysisService
@inject IMainPhraseService MainPhraseService
@inject ISnackbar Snackbar

<EditForm Model="KeywordData" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudSelect T="KeywordAnalysisModel" @bind-Value="KeywordData.Analysis" Label="Analysis" For="() => KeywordData.Analysis">
            @foreach (var analysis in Analyses)
            {
                <MudSelectItem Value="analysis">@analysis.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="MainPhraseModel" @bind-Value="KeywordData.MainPhrase" Label="Status" For="() => KeywordData.MainPhrase">
            @foreach (var mainPhrase in MainPhrases)
            {
                <MudSelectItem Value="mainPhrase">@mainPhrase.Name</MudSelectItem>
            }
        </MudSelect>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long KeywordDataId { get; set; }

    CustomValidation CustomValidation = new();
    KeywordDataModel KeywordData = new();
    IList<KeywordAnalysisModel> Analyses;
    IList<MainPhraseModel> MainPhrases;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Analyses = KeywordAnalysisService.GetAll();
        MainPhrases = MainPhraseService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        KeywordData = KeywordDataService.Get(KeywordDataId);
        KeywordData.Analysis = Analyses.Single(a => a.Id == KeywordData.Analysis.Id);
        KeywordData.Status = MainPhrases.Single(s => s.Id == KeywordData.Status.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = KeywordDataValidator.Validate(KeywordData);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                KeywordDataService.Update(KeywordData);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Main Phrase"));
            }
            else
            {
                KeywordDataService.Add(KeywordData);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Main Phrase"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}