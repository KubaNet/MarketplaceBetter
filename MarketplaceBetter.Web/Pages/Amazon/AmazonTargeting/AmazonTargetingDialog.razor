@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Interfaces

@inject IAmazonTargetingService AmazonTargetingService
@inject IAmazonTargetingValidator AmazonTargetingValidator
@inject IInstanceService InstanceService
@inject IAmazonCampaignService AmazonCampaignService
@inject ISnackbar Snackbar

<EditForm Model="AmazonTargeting" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Instance" T="InstanceModel" Value="Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Campaign" T="AmazonCampaignModel" Value="AmazonTargeting.Campaign" For="() => AmazonTargeting.Campaign" ValueChanged="HandleCampaignChanged" Disabled="CampaignSelectDisabled">
            @foreach (var campaign in Campaigns)
            {
                <MudSelectItem Value="campaign">@campaign.Name</MudSelectItem>
            }
        </MudSelect>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long AmazonTargetingId { get; set; }

    private CustomValidation CustomValidation = new();
    private AmazonTargetingModel AmazonTargeting = new();
    private InstanceModel Instance;

    private IList<InstanceModel> Instances;
    private IList<AmazonCampaignModel> Campaigns = new List<AmazonCampaignModel>();

    private bool CampaignSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Instances = InstanceService.GetAllForAmazon();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        AmazonTargeting = AmazonTargetingService.Get(AmazonTargetingId);

        ActivateCampaign(AmazonTargeting.Campaign.Instance.Id);

        Instance = Instances.Single(b => b.Id == AmazonTargeting.Campaign.Instance.Id);
        AmazonTargeting.Campaign = Campaigns.Single(p => p.Id == AmazonTargeting.Campaign.Id);
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        Instance = instance;

        ResetCampaign();
        ActivateCampaign(instance.Id);
    }

    private void HandleCampaignChanged(AmazonCampaignModel campaign)
    {
        AmazonTargeting.Campaign = campaign;
    }

    private void ResetCampaign()
    {
        AmazonTargeting.Campaign = null;
        CampaignSelectDisabled = true;
        Campaigns = new List<AmazonCampaignModel>();
    }

    private void ActivateCampaign(long instanceId)
    {
        CampaignSelectDisabled = false;
        Campaigns = AmazonCampaignService.GetForInstance(instanceId);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = AmazonTargetingValidator.Validate(AmazonTargeting);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                AmazonTargetingService.Update(AmazonTargeting);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Amazon Targeting"));
            }
            else
            {
                AmazonTargetingService.Add(AmazonTargeting);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Amazon Targeting"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}