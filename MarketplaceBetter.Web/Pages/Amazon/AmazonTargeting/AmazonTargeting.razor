@using MarketplaceBetter.Domain.Entities.Amazon
@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Model
@using System.IO

@page "/amazontargeting"
@inject IJSRuntime JS
@inject IAmazonTargetingService AmazonTargetingService
@inject IAmazonTargetingStatusService AmazonTargetingStatusService
@inject IDialogService DialogService

<MudText Typo="Typo.h3">Amazon Targeting</MudText>

<MainBody>
    <MudTable T="AmazonTargetingModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<AmazonTargetingModel>>>(ReloadTargetings))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true">
        <ToolBarContent>
            <MudTextField Placeholder="Search" T="string" ValueChanged="FilterTargetings" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="SetAsActive" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" Disabled="NoneSelected" Class="ml-2">Active</MudButton>
            <MudButton OnClick="SetAsNegative" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Error" Disabled="NoneSelected" Class="ml-2">Negative</MudButton>
            <MudButton OnClick="ExportTargeting" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Secondary" Class="ml-2">Export</MudButton>
            <MudButton OnClick="AddTargeting" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="AmazonTargetingModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="type" T="AmazonTargetingModel">Type</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="value" T="AmazonTargetingModel">Value</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="status" T="AmazonTargetingModel">Status</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="campaign" T="AmazonTargetingModel">Campaign</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Type">
                <AmazonTargetingTypeDisplay Targeting="@context" />
            </MudTd>
            <MudTd DataLabel="Value">@context.Value</MudTd>
            <MudTd DataLabel="Status">
                <AmazonTargetingStatusDisplay Targeting="@context" />
            </MudTd>
            <MudTd DataLabel="Campaign">@context.Campaign.Name</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<AmazonTargetingModel> Table;
    private ListRequest ListRequest = new();

    private HashSet<AmazonTargetingModel> SelectedTargeting = new HashSet<AmazonTargetingModel>();
    private bool NoneSelected = true;

    private Task<TableData<AmazonTargetingModel>> ReloadTargetings(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<AmazonTargetingModel> parents = AmazonTargetingService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<AmazonTargetingModel>() { TotalItems = AmazonTargetingService.CountForListRequest(ListRequest), Items = parents });
    }

    private void FilterTargetings(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddTargeting()
    {
        var result = await DialogService.Show<AmazonTargetingDialog>(null, new DialogParameters { ["Title"] = "Add Amazon Targeting" }).Result;

        ProcessAmazonTargetingDialogResult(result);
    }

    private void ProcessAmazonTargetingDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }

    private void OnSelectedItemsChanged(HashSet<AmazonTargetingModel> selectedTargeting)
    {
        SelectedTargeting = selectedTargeting;

        if (SelectedTargeting.Any())
        {
            NoneSelected = false;
        }
        else
        {
            NoneSelected = true;
        }
    }

    private void SetAsActive()
    {
        AmazonTargetingService.SetAsActive(SelectedTargeting.ToList());

        foreach (var targeting in SelectedTargeting)
        {
            targeting.Status = AmazonTargetingStatusService.GetBySystemName(AmazonTargetingStatusEnum.Active);
        }

        SelectedTargeting.Clear();
    }

    private void SetAsNegative()
    {
        AmazonTargetingService.SetAsNegative(SelectedTargeting.ToList());

        foreach (var targeting in SelectedTargeting)
        {
            targeting.Status = AmazonTargetingStatusService.GetBySystemName(AmazonTargetingStatusEnum.Negative);
        }

        SelectedTargeting.Clear();
    }

    private async Task ExportTargeting()
    {
        Stream fileStream = AmazonTargetingService.ExportTargeting(ListRequest);

        using var streamRef = new DotNetStreamReference(stream: fileStream);

        await JS.InvokeVoidAsync("downloadFileFromStream", "Targeting.csv", streamRef);
    }
}