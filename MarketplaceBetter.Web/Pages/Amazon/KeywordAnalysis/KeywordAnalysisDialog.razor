@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Interfaces

@inject IKeywordAnalysisService KeywordAnalysisService
@inject IKeywordAnalysisValidator KeywordAnalysisValidator
@inject IInstanceService InstanceService
@inject ISnackbar Snackbar

<EditForm Model="KeywordAnalysis" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudTextField Label="Name" @bind-Value="KeywordAnalysis.Name" For="() => KeywordAnalysis.Name" />
        <MudTextField Label="Description" @bind-Value="KeywordAnalysis.Description" For="() => KeywordAnalysis.Description" />
        <MudSelect T="InstanceModel" @bind-Value="KeywordAnalysis.Instance" Label="Instance" For="() => KeywordAnalysis.Instance">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long KeywordAnalysisId { get; set; }

    CustomValidation CustomValidation = new();
    KeywordAnalysisModel KeywordAnalysis = new();
    IList<InstanceModel> Instances;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Instances = InstanceService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        KeywordAnalysis = KeywordAnalysisService.Get(KeywordAnalysisId);
        KeywordAnalysis.Instance = Instances.Single(i => i.Id == KeywordAnalysis.Instance.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = KeywordAnalysisValidator.Validate(KeywordAnalysis);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                KeywordAnalysisService.Update(KeywordAnalysis);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Keyword Analysis"));
            }
            else
            {
                KeywordAnalysisService.Add(KeywordAnalysis);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Keyword Analysis"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}