@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces

@page "/keywordanalyses"
@inject IKeywordAnalysisService KeywordAnalysisService
@inject IDialogService DialogService

<MudText Typo="Typo.h3">Keyword Analyses</MudText>

<MainBody>
    <MudTable Items="@KeywordAnalysesData" Dense="true">
        <ToolBarContent>
            <MudButton OnClick="AddKeywordAnalysis" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Keyword Analysis</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Instance</MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="SKU">@context.Name</MudTd>
            <MudTd DataLabel="Product">@context.Description</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditKeywordAnalysis(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private IList<KeywordAnalysisModel> KeywordAnalysesData { get; set; }

    private async void AddKeywordAnalysis()
    {
        var result = await DialogService.Show<KeywordAnalysisDialog>(null, new DialogParameters { ["Title"] = "Add Keyword Analysis" }).Result;

        ProcessKeywordAnalysisDialogResult(result);
    }

    private async void EditKeywordAnalysis(long id)
    {
        var result = await DialogService.Show<KeywordAnalysisDialog>(null, new DialogParameters { ["Title"] = "Edit Keyword Analysis", ["IsEdit"] = true, ["KeywordAnalysisId"] = id }).Result;

        ProcessKeywordAnalysisDialogResult(result);
    }

    private void ProcessKeywordAnalysisDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            KeywordAnalysesData = KeywordAnalysisService.GetAll();

            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        KeywordAnalysesData = KeywordAnalysisService.GetAll();
    }
}
