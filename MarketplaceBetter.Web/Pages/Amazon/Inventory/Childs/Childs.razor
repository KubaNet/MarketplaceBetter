@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Model

@page "/childs"
@inject IChildService ChildService
@inject IDialogService DialogService

<MudText Typo="Typo.h3" Class="mt-2">Childs</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ChildModel>>>(ReloadChilds))" Dense="true" Hover="true" RowsPerPage="15">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="FilterChilds" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="AddChild" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Child</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="ChildModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="sku" T="ChildModel">SKU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="asin" T="ChildModel">ASIN</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product_variant" T="ChildModel">Variant</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="parent" T="ChildModel">Parent</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ChildModel">Brand</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="SKU">@context.Sku</MudTd>
            <MudTd DataLabel="ASIN">@context.Asin</MudTd>
            <MudTd DataLabel="Variant">@context.Variant.Sku</MudTd>
            <MudTd DataLabel="Parent">@context.Parent.Sku</MudTd>
            <MudTd DataLabel="Parent">@context.Parent.Product.Brand.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditChild(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50 , 100 }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public long? ProductId { get; set; }

    private MudTable<ChildModel> Table;
    private ListRequest ListRequest = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (ProductId.HasValue)
        {
            ListRequest.SearchString = $"product_id: {ProductId.Value}";
        }
    }

    private Task<TableData<ChildModel>> ReloadChilds(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<ChildModel> childs = ChildService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<ChildModel>() { TotalItems = ChildService.CountForListRequest(ListRequest), Items = childs });
    }

    private void FilterChilds(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddChild()
    {
        var result = await DialogService.Show<ChildDialog>(null, new DialogParameters { ["Title"] = "Add Child" }).Result;

        ProcessChildDialogResult(result);
    }

    private async void EditChild(long id)
    {
        var result = await DialogService.Show<ChildDialog>(null, new DialogParameters { ["Title"] = "Edit Child", ["IsEdit"] = true, ["ChildId"] = id }).Result;

        ProcessChildDialogResult(result);
    }

    private void ProcessChildDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
