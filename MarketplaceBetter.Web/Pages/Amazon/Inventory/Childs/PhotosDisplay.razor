@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces

@inject IChildService ChildService

@if (PhotoCount > 0)
{
    <MudLink Href="@LinkHelper.GetUrlForVariantPhotosByVariant(Child.Variant.Id)" title="View photos" Style="text-decoration: none;">@PhotoCount photos</MudLink>
}
else
{
    <span>0 photos</span>
}

@code {
    [Parameter] public ChildModel Child { get; set; }

    private int PhotoCount = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        PhotoCount = ChildService.GetPhotoCountFor(Child);
    }
}
