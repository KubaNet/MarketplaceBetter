@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Inventory.Interfaces

@inject IChildService ChildService
@inject IChildValidator ChildValidator
@inject IBrandService BrandService
@inject IInstanceService InstanceService
@inject IParentService ParentService
@inject IVariantService VariantService
@inject ISnackbar Snackbar

<EditForm Model="Child" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Parent" T="ParentModel" Value="Child.Parent" For="() => Child.Parent" ValueChanged="HandleParentChanged" Disabled="ParentSelectDisabled">
            @foreach (var parent in Parents)
            {
                <MudSelectItem Value="parent">@parent.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Variant" T="VariantModel" Value="Child.Variant" For="() => Child.Variant" ValueChanged="HandleVariantChanged" Disabled="VariantDisabled">
            @foreach (var Variant in Variants)
            {
                <MudSelectItem Value="Variant">@Variant.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="Child.Sku" For="() => Child.Sku" />
        <MudTextField Label="ASIN" @bind-Value="Child.Asin" For="() => Child.Asin" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long ChildId { get; set; }

    private CustomValidation CustomValidation = new();
    private ChildModel Child = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<ParentModel> Parents = new List<ParentModel>();
    private IList<VariantModel> Variants = new List<VariantModel>();

    private bool ParentSelectDisabled = true;
    private bool VariantDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        Child = ChildService.Get(ChildId);

        Brand = Brands.Single(b => b.Id == Child.Parent.Product.Brand.Id);

        ActivateParent();
        ActivateVariant(Child.Parent.Product.Id);

        Child.Parent = Parents.Single(p => p.Id == Child.Parent.Id);
        Child.Variant = Variants.Single(v => v.Id == Child.Variant.Id);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetParent();
        ActivateParent();

        ResetVariant();

        SetChildSku();
    }

    private void HandleParentChanged(ParentModel parent)
    {
        Child.Parent = parent;

        ResetVariant();
        ActivateVariant(parent.Product.Id);

        SetChildSku();
    }

    private void HandleVariantChanged(VariantModel Variant)
    {
        Child.Variant = Variant;

        SetChildSku();
    }

    private void ResetParent()
    {
        Child.Parent = null;
        ParentSelectDisabled = true;
        Parents = new List<ParentModel>();
    }

    private void ActivateParent()
    {
        ParentSelectDisabled = false;
        Parents = ParentService.GetAllForBrand(Brand.Id);
    }

    private void ResetVariant()
    {
        Child.Variant = null;
        VariantDisabled = true;
        Variants = new List<VariantModel>();
    }

    private void ActivateVariant(long productId)
    {
        VariantDisabled = false;
        Variants = VariantService.GetAllForProduct(productId);
    }

    private void SetChildSku()
    {
        Child.Sku = ChildService.GetSkuFor(Child.Parent?.Id, Child.Variant?.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ChildValidator.Validate(Child);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ChildService.Update(Child);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Child"));
            }
            else
            {
                ChildService.Add(Child);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Child"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}