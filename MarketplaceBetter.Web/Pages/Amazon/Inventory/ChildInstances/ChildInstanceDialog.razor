@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Base
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Base.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Inventory.Interfaces

@inject ISnackbar Snackbar
@inject IChildInstanceService ChildInstanceService
@inject IChildInstanceValidator ChildInstanceValidator
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IVariantService VariantService
@inject IInstanceService InstanceService
@inject IUserService UserService
@inject IUserService UserService

<EditForm Model="ChildInstance" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="Product" ValueChanged="HandleProductChanged" Disabled="ProductSelectDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Code</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Variant" T="VariantModel" Value="ChildInstance.Variant" For="() => ChildInstance.Variant" ValueChanged="HandleVariantChanged" Disabled="VariantSelectDisabled">
            @foreach (var variant in Variants)
            {
                <MudSelectItem Value="variant">@variant.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Instance" T="InstanceModel" Value="ChildInstance.Instance" For="() => ChildInstance.Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="ChildInstance.Sku" For="() => ChildInstance.Sku" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long ChildInstanceId { get; set; }

    private CustomValidation CustomValidation = new();
    private ChildInstanceModel ChildInstance = new();
    private BrandModel Brand;
    private ProductModel Product;

    private IList<BrandModel> Brands;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<InstanceModel> Instances;
    private IList<VariantModel> Variants = new List<VariantModel>();

    private bool ProductSelectDisabled = true;
    private bool VariantSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);
        Instances = InstanceService.GetAllNormal(true);

        if (IsEdit)
        {
            SetInitialValues();
        }
        else
        {
            if (UserService.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }

            if (UserService.IsSpecificInstance())
            {
                SetValuesForCurrentInstance();
            }
        }
    }

    private void SetInitialValues()
    {
        ChildInstance = ChildInstanceService.Get(ChildInstanceId);

        ActivateProduct(ChildInstance.Variant.Product.Brand.Id);
        ActivateVariant(ChildInstance.Variant.Product.Id);

        Brand = Brands.Single(b => b.Id == ChildInstance.Variant.Product.Brand.Id);
        Product = Products.Single(b => b.Id == ChildInstance.Variant.Product.Id);
        ChildInstance.Variant = Variants.Single(p => p.Id == ChildInstance.Variant.Id);
        ChildInstance.Instance = Instances.Single(i => i.Id == ChildInstance.Instance.Id);
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == UserService.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void SetValuesForCurrentInstance()
    {
        InstanceModel currentInstance = Instances.Single(b => b.Id == UserService.GetCurrentInstance().Id);

        HandleInstanceChanged(currentInstance);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);
        SetChildInstanceSku();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        ChildInstance.Instance = instance;
        SetChildInstanceSku();
    }

    private void HandleProductChanged(ProductModel product)
    {
        Product = product;

        ResetVariant();
        ActivateVariant(product.Id);
        SetChildInstanceSku();
    }

    private void HandleVariantChanged(VariantModel variant)
    {
        ChildInstance.Variant = variant;
        SetChildInstanceSku();
    }

    private void ResetProduct()
    {
        Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ResetVariant()
    {
        ChildInstance.Variant = null;
        VariantSelectDisabled = true;
        Variants = new List<VariantModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void ActivateVariant(long productId)
    {
        VariantSelectDisabled = false;
        Variants = VariantService.GetAllForProduct(productId);
    }

    private void SetChildInstanceSku()
    {
        ChildInstance.Sku = ChildInstanceService.GetSkuFor(ChildInstance.Variant?.Id, ChildInstance.Instance?.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ChildInstanceValidator.Validate(ChildInstance);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ChildInstanceService.Update(ChildInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Child Instance"));
            }
            else
            {
                ChildInstanceService.Add(ChildInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Child Instance"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}