@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Inventory.Interfaces

@inject IChildInstanceService ChildInstanceService
@inject IChildInstanceValidator ChildInstanceValidator
@inject IBrandService BrandService
@inject IParentService ParentService
@inject IChildService ChildService
@inject IInstanceService InstanceService
@inject ISnackbar Snackbar

<EditForm Model="ChildInstance" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Parent" T="ParentModel" Value="Parent" ValueChanged="HandleParentChanged" Disabled="ParentSelectDisabled">
            @foreach (var parent in Parents)
            {
                <MudSelectItem Value="parent">@parent.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Child" T="ChildModel" Value="ChildInstance.Child" For="() => ChildInstance.Child" ValueChanged="HandleChildChanged" Disabled="ChildSelectDisabled">
            @foreach (var parent in Childs)
            {
                <MudSelectItem Value="parent">@parent.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Instance" T="InstanceModel" Value="ChildInstance.Instance" For="() => ChildInstance.Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="ChildInstance.Sku" For="() => ChildInstance.Sku" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long ChildInstanceId { get; set; }

    private CustomValidation CustomValidation = new();
    private ChildInstanceModel ChildInstance = new();
    private BrandModel Brand;
    private ParentModel Parent;

    private IList<BrandModel> Brands;
    private IList<ParentModel> Parents = new List<ParentModel>();
    private IList<InstanceModel> Instances;
    private IList<ChildModel> Childs = new List<ChildModel>();

    private bool ParentSelectDisabled = true;
    private bool ChildSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();
        Instances = InstanceService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        ChildInstance = ChildInstanceService.Get(ChildInstanceId);

        ActivateParent(ChildInstance.Child.Parent.Product.Brand.Id);
        ActivateChild(ChildInstance.Child.Parent.Id);

        Brand = Brands.Single(b => b.Id == ChildInstance.Child.Parent.Product.Brand.Id);
        Parent = Parents.Single(b => b.Id == ChildInstance.Child.Parent.Id);
        ChildInstance.Child = Childs.Single(p => p.Id == ChildInstance.Child.Id);
        ChildInstance.Instance = Instances.Single(i => i.Id == ChildInstance.Instance.Id);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetParent();
        ActivateParent(brand.Id);
        SetChildInstanceSku();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        ChildInstance.Instance = instance;
        SetChildInstanceSku();
    }

    private void HandleParentChanged(ParentModel parent)
    {
        Parent = parent;

        ResetChild();
        ActivateChild(parent.Id);
        SetChildInstanceSku();
    }

    private void HandleChildChanged(ChildModel child)
    {
        ChildInstance.Child = child;
        SetChildInstanceSku();
    }

    private void ResetParent()
    {
        Parent = null;
        ParentSelectDisabled = true;
        Parents = new List<ParentModel>();
    }

    private void ResetChild()
    {
        ChildInstance.Child = null;
        ChildSelectDisabled = true;
        Childs = new List<ChildModel>();
    }

    private void ActivateParent(long brandId)
    {
        ParentSelectDisabled = false;
        Parents = ParentService.GetAllForBrand(brandId);
    }

    private void ActivateChild(long parentId)
    {
        ChildSelectDisabled = false;
        Childs = ChildService.GetAllForParent(parentId);
    }

    private void SetChildInstanceSku()
    {
        ChildInstance.Sku = ChildInstanceService.GetSkuFor(ChildInstance.Child?.Id, ChildInstance.Instance?.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ChildInstanceValidator.Validate(ChildInstance);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ChildInstanceService.Update(ChildInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Child Instance"));
            }
            else
            {
                ChildInstanceService.Add(ChildInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Child Instance"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}