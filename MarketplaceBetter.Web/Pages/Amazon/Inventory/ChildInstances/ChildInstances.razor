@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Model

@page "/child-instances"
@inject ISnackbar Snackbar
@inject IChildInstanceService ChildInstanceService
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mt-2">Child Instances</MudText>

<MainBody>
    <MudTable T="ChildInstanceModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ChildInstanceModel>>>(ReloadChildInstances))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="FilterChildInstances" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="ChangeStatusOfSelected" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PublishedWithChanges" Color="Color.Info" Disabled="NoneSelected" Class="ml-2">Change Status</MudButton>
            <MudButton OnClick="AddChildInstance" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Child Instance</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="ChildInstanceModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="sku" T="ChildInstanceModel">SKU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="ChildInstanceModel">Instance</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="status" T="ChildInstanceModel">Status</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="child" T="ChildInstanceModel">Child</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ChildInstanceModel">Brand</MudTableSortLabel></MudTh>
            <MudTh Style="width: 170px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="SKU">
                @context.Sku
                <ProductPageLinkDisplay Instance="@context.Instance" Asin="@context.Child.Asin" />
            </MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd DataLabel="Status"><AmazonEntityStatusDisplay Status="@context.Status" /></MudTd>
            <MudTd DataLabel="Child">@context.Child.Sku</MudTd>
            <MudTd DataLabel="Brand">@context.Child.Parent.Product.Brand.Name</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditChildInstance(context.Id))">Edit</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => DeleteChildInstance(context.Id, context.Sku))" Color="Color.Secondary">Delete</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            @if (!ShowAll.HasValue || ShowAll == false)
            {
                <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
            }
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public long? ProductId { get; set; }
    [Parameter][SupplyParameterFromQuery] public bool? ShowAll { get; set; }

    private MudTable<ChildInstanceModel> Table;
    private ListRequest ListRequest = new();

    private HashSet<ChildInstanceModel> SelectedChilds = new HashSet<ChildInstanceModel>();
    private bool NoneSelected = true;
    private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (ProductId.HasValue)
        {
            ListRequest.SearchString = $"product_id: {ProductId.Value}";
        }
        if (ShowAll.HasValue)
        {
            ListRequest.ShowAll = ShowAll.Value;
        }
    }

    private Task<TableData<ChildInstanceModel>> ReloadChildInstances(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<ChildInstanceModel> childInstances = ChildInstanceService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<ChildInstanceModel>() { TotalItems = ChildInstanceService.CountForListRequest(ListRequest), Items = childInstances });
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        CurrentRowsPerPageValue = rowsPerPage;
    }

    private void FilterChildInstances(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddChildInstance()
    {
        var result = await DialogService.Show<ChildInstanceDialog>(null, new DialogParameters { ["Title"] = "Add Child Instance" }).Result;

        ProcessChildInstanceDialogResult(result);
    }

    private async void EditChildInstance(long id)
    {
        var result = await DialogService.Show<ChildInstanceDialog>(null, new DialogParameters { ["Title"] = "Edit Child Instance", ["IsEdit"] = true, ["ChildInstanceId"] = id }).Result;

        ProcessChildInstanceDialogResult(result);
    }

    private async void DeleteChildInstance(long id, string sku)
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = $"Are you sure you want to delete child instance \"{sku}\"?" }).Result;

        if (!result.Canceled)
        {
            ChildInstanceService.Delete(id);

            await Table.ReloadServerData();

            Snackbar.AddSuccess(OperationMessages.SuccessfullyDeleted("Child"));
        }
    }

    private void ProcessChildInstanceDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }

    private async void ChangeStatusOfSelected()
    {
        var result = await DialogService.Show<ChildInstancesSetStatusDialog>(null, new DialogParameters { ["ChildInstances"] = SelectedChilds.ToList() }).Result;

        ProcessChildInstanceDialogResult(result);
    }

    private void OnSelectedItemsChanged(HashSet<ChildInstanceModel> selectedChilds)
    {
        SelectedChilds = selectedChilds;

        if (SelectedChilds.Any())
        {
            NoneSelected = false;
        }
        else
        {
            NoneSelected = true;
        }
    }
}
