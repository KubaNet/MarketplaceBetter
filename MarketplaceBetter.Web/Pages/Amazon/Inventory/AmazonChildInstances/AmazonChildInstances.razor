@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Model

@page "/amazonchildinstances"
@inject IAmazonChildInstanceService AmazonChildInstanceService
@inject IDialogService DialogService

<MudText Typo="Typo.h3">Child Instances</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<AmazonChildInstanceModel>>>(ReloadChildInstances))" Dense="true" Hover="true">
        <ToolBarContent>
			<MudTextField Placeholder="Search" T="string" ValueChanged="FilterChildInstances" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
            <MudButton OnClick="AddAmazonChildInstance" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Child Instance</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="AmazonChildInstanceModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="sku" T="AmazonChildInstanceModel">SKU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="AmazonChildInstanceModel">Instance</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="child" T="AmazonChildInstanceModel">Child</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="AmazonChildInstanceModel">Brand</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="SKU">@context.Sku</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd DataLabel="Child">@context.Child.Sku</MudTd>
            <MudTd DataLabel="Brand">@context.Child.Parent.Product.Brand.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditAmazonChildInstance(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<AmazonChildInstanceModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<AmazonChildInstanceModel>> ReloadChildInstances(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<AmazonChildInstanceModel> childInstances = AmazonChildInstanceService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<AmazonChildInstanceModel>() { TotalItems = AmazonChildInstanceService.CountForListRequest(ListRequest), Items = childInstances });
	}

    private void FilterChildInstances(string searchString)
	{
		ListRequest.SearchString = searchString;

		Table.ReloadServerData();

		StateHasChanged();
	}

    private async void AddAmazonChildInstance()
    {
        var result = await DialogService.Show<AmazonChildInstanceDialog>(null, new DialogParameters { ["Title"] = "Add Child Instance" }).Result;

        ProcessAmazonChildInstanceDialogResult(result);
    }

    private async void EditAmazonChildInstance(long id)
    {
        var result = await DialogService.Show<AmazonChildInstanceDialog>(null, new DialogParameters { ["Title"] = "Edit Child Instance", ["IsEdit"] = true, ["AmazonChildInstanceId"] = id }).Result;

        ProcessAmazonChildInstanceDialogResult(result);
    }

    private void ProcessAmazonChildInstanceDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
