@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Inventory.Interfaces

@inject IAmazonParentInstanceService AmazonParentInstanceService
@inject IAmazonParentInstanceValidator AmazonParentInstanceValidator
@inject IBrandService BrandService
@inject IAmazonParentService ParentService
@inject IInstanceService InstanceService
@inject ISnackbar Snackbar

<EditForm Model="AmazonParentInstance" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Parent" T="AmazonParentModel" Value="AmazonParentInstance.Parent" For="() => AmazonParentInstance.Parent" ValueChanged="HandleParentChanged" Disabled="ParentSelectDisabled">
            @foreach (var parent in Parents)
            {
                <MudSelectItem Value="parent">@parent.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Instance" T="InstanceModel" Value="AmazonParentInstance.Instance" For="() => AmazonParentInstance.Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="AmazonParentInstance.Sku" For="() => AmazonParentInstance.Sku" />
        <MudTextField Label="ASIN" @bind-Value="AmazonParentInstance.Asin" For="() => AmazonParentInstance.Asin" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long AmazonParentInstanceId { get; set; }

    private CustomValidation CustomValidation = new();
    private AmazonParentInstanceModel AmazonParentInstance = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<InstanceModel> Instances;
    private IList<AmazonParentModel> Parents = new List<AmazonParentModel>();

    private bool ParentSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();
        Instances = InstanceService.GetAllForAmazon();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        AmazonParentInstance = AmazonParentInstanceService.Get(AmazonParentInstanceId);

        ActivateParent(AmazonParentInstance.Parent.Product.Brand.Id);

        Brand = Brands.Single(b => b.Id == AmazonParentInstance.Parent.Product.Brand.Id);
        AmazonParentInstance.Parent = Parents.Single(p => p.Id == AmazonParentInstance.Parent.Id);
        AmazonParentInstance.Instance = Instances.Single(i => i.Id == AmazonParentInstance.Instance.Id);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetParent();
        ActivateParent(brand.Id);
        SetParentInstanceSku();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        AmazonParentInstance.Instance = instance;
        SetParentInstanceSku();
    }

    private void HandleParentChanged(AmazonParentModel parent)
    {
        AmazonParentInstance.Parent = parent;
        SetParentInstanceSku();
    }

    private void ResetParent()
    {
        AmazonParentInstance.Parent = null;
        ParentSelectDisabled = true;
        Parents = new List<AmazonParentModel>();
    }

    private void ActivateParent(long brandId)
    {
        ParentSelectDisabled = false;
        Parents = ParentService.GetAllForBrand(brandId);
    }

    private void SetParentInstanceSku()
    {
        AmazonParentInstance.Sku = AmazonParentInstanceService.GetSkuFor(AmazonParentInstance.Parent?.Id, AmazonParentInstance.Instance?.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = AmazonParentInstanceValidator.Validate(AmazonParentInstance);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                AmazonParentInstanceService.Update(AmazonParentInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Parent Instance"));
            }
            else
            {
                AmazonParentInstanceService.Add(AmazonParentInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Parent Instance"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}