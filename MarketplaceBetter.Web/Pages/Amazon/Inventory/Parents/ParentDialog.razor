@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Base
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Base.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Inventory.Interfaces

@inject ISnackbar Snackbar
@inject IParentService ParentService
@inject IParentValidator ParentValidator
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IInstanceService InstanceService
@inject IUserService UserService

<EditForm Model="Parent" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Disabled="true" Label="Brand" T="BrandModel" Value="Brand">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Disabled="true" Label="Product" T="ProductModel" Value="Parent.Product">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Code</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Disabled="true" Label="Instance" T="InstanceModel" Value="Parent.Instance">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="Parent.Sku" For="() => Parent.Sku" />
        <MudTextField Label="ASIN" @bind-Value="Parent.Asin" For="() => Parent.Asin" />
        <MudTextField Label="Category" @bind-Value="Parent.Category" For="() => Parent.Category" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long ParentId { get; set; }

    private CustomValidation CustomValidation = new();
    private ParentModel Parent = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<InstanceModel> Instances;
    private IList<ProductModel> Products = new List<ProductModel>();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);
        Instances = InstanceService.GetAllNormal(true);

        if (IsEdit)
        {
            SetInitialValues();
        }
        else
        {
            if (UserService.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }

            if (UserService.IsSpecificInstance())
            {
                SetValuesForCurrentInstance();
            }
        }
    }

    private void SetInitialValues()
    {
        Parent = ParentService.Get(ParentId);

        ActivateProduct(Parent.Product.Brand.Id);

        Brand = Brands.Single(b => b.Id == Parent.Product.Brand.Id);
        Parent.Product = Products.Single(p => p.Id == Parent.Product.Id);
        Parent.Instance = Instances.Single(i => i.Id == Parent.Instance.Id);
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == UserService.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void SetValuesForCurrentInstance()
    {
        InstanceModel currentInstance = Instances.Single(i => i.Id == UserService.GetCurrentInstance().Id);

        HandleInstanceChanged(currentInstance);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);
        SetParentSku();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        Parent.Instance = instance;
        SetParentSku();
    }

    private void HandleProductChanged(ProductModel product)
    {
        Parent.Product = product;
        SetParentSku();
    }

    private void ResetProduct()
    {
        Parent.Product = null;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void SetParentSku()
    {
        Parent.Sku = ParentService.GetSkuFor(Parent.Product?.Id, Parent.Instance?.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ParentValidator.Validate(Parent);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ParentService.Update(Parent);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Parent"));
            }
            else
            {
                ParentService.Add(Parent);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Parent"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}