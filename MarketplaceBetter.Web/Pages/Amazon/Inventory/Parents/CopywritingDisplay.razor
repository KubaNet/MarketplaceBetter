@using MarketplaceBetter.Domain.Entities.Amazon.CopyAndMedia
@using MarketplaceBetter.Domain.Model.Amazon.CopyAndMedia
@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces

@inject IParentService ParentService

@if (Copywriting.Any())
{
    <MudLink Href="@LinkHelper.GetUrlForCopywriting(Parent.Product.Id, Parent.Instance.Id)" title="View copywriting" Style="text-decoration: none;" @onmouseenter="Open" @onmouseleave="Close">@Copywriting.Count copy</MudLink>
    <MudPopover Class="pa-4" Open="IsOpen" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopCenter" OverflowBehavior="OverflowBehavior.FlipNever" Style="max-width: 2000px;">
        @if (TitleCopy != null)
        {
            <MudText Typo="Typo.h6">@TitleCopy.Value</MudText>
        }
        else
        {
            <p>@EmptyValue</p>
        }
        <p class="mt-3">1. @(Bp1Copy != null ? Bp1Copy.Value : EmptyValue)</p>
        <p>2. @(Bp2Copy != null ? Bp2Copy.Value : EmptyValue)</p>
        <p>3. @(Bp3Copy != null ? Bp3Copy.Value : EmptyValue)</p>
        <p>4. @(Bp4Copy != null ? Bp4Copy.Value : EmptyValue)</p>
        <p class="mb-3">5. @(Bp5Copy != null ? Bp5Copy.Value : EmptyValue)</p>
        @if(DescriptionCopy != null)
        {
            <div class="copywriting-description-display">
                @((MarkupString)DescriptionCopy.Value)
            </div>
        }
        else
        {
            <p>@EmptyValue</p>
        }
    </MudPopover>
}
else
{
    <span>0 copy</span>
}

@code {
    [Parameter] public ParentModel Parent { get; set; }

    private IList<CopywritingModel> Copywriting { get; set; }
    private bool IsOpen { get; set; }
    private string EmptyValue = "........";
    private CopywritingModel TitleCopy;
    private CopywritingModel Bp1Copy;
    private CopywritingModel Bp2Copy;
    private CopywritingModel Bp3Copy;
    private CopywritingModel Bp4Copy;
    private CopywritingModel Bp5Copy;
    private CopywritingModel DescriptionCopy;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Copywriting = ParentService.GetCopywritingFor(Parent);

        TitleCopy = Copywriting.SingleOrDefault(c => c.Element.SystemName == CopywritingElementEnum.Title);
        Bp1Copy = Copywriting.SingleOrDefault(c => c.Element.SystemName == CopywritingElementEnum.BulletPoint1);
        Bp2Copy = Copywriting.SingleOrDefault(c => c.Element.SystemName == CopywritingElementEnum.BulletPoint2);
        Bp3Copy = Copywriting.SingleOrDefault(c => c.Element.SystemName == CopywritingElementEnum.BulletPoint3);
        Bp4Copy = Copywriting.SingleOrDefault(c => c.Element.SystemName == CopywritingElementEnum.BulletPoint4);
        Bp5Copy = Copywriting.SingleOrDefault(c => c.Element.SystemName == CopywritingElementEnum.BulletPoint5);
        DescriptionCopy = Copywriting.SingleOrDefault(c => c.Element.SystemName == CopywritingElementEnum.Description);
    }

    private void Open()
    {
        IsOpen = true;
    }

    private void Close()
    {
        IsOpen = false;
    }
}
