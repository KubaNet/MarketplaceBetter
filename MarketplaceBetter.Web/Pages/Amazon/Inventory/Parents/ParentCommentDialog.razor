@using MarketplaceBetter.Domain.Model.Amazon.Inventory;
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces;
@using TinyMCE.Blazor;

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IParentCommentService CommentService

<EditForm Model="Parent" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <MudDialog Style="min-width: 1000px;">
        <TitleContent>
            <MudText Typo="Typo.h6">@Title</MudText>
        </TitleContent>
        <DialogContent>
            <DataAnnotationsValidator />
            <Editor @bind-Value="Parent.Comment" Field="() => Parent.Comment" Conf="EditorConfiguration" ScriptSrc="/lib/tinymce/tinymce.min.js" ClassName="mt-4" />
        </DialogContent>
        <DialogActions>
            @if (IsEdit)
            {
                <MudButton OnClick="Delete" Color="Color.Error" Class="mr-6">Delete</MudButton>
            }
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public ParentModel Parent { get; set; }

    private CustomValidation CustomValidation = new();

    private Dictionary<string, object> EditorConfiguration = new Dictionary<string, object>{
        { "toolbar", "undo redo | bold italic underline | numlist bullist" },
        { "plugins", "lists" },
        { "menubar", false }
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private void Cancel() => MudDialog.Cancel();

    private void HandleValidSubmit()
    {
        if (IsEdit)
        {
            CommentService.Update(Parent);
            Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Comment"));
        }
        else
        {
            CommentService.Add(Parent);
            Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Comment"));
        }

        MudDialog.Close();
    }

    private async void Delete()
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = "Are you sure you want to delete this comment?" }).Result;

        if (!result.Canceled)
        {
            CommentService.Delete(Parent);

            Snackbar.AddSuccess(OperationMessages.SuccessfullyDeleted("Comment"));

            MudDialog.Close();
        }
    }
}