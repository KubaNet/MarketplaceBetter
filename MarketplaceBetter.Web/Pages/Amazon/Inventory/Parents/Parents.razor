@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Model

@page "/parents"
@inject IParentService ParentService
@inject IDialogService DialogService

<MudText Typo="Typo.h3">Parents</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ParentModel>>>(ReloadParents))" Dense="true" Hover="true">
        <ToolBarContent>
			<MudTextField Placeholder="Search" T="string" ValueChanged="FilterParents" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
            <MudButton OnClick="AddParent" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Parent</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="ParentModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="sku" T="ParentModel">SKU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="child_sku" T="ParentModel">Child SKU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product" T="ParentModel">Product</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ParentModel">Brand</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="SKU">@context.Sku</MudTd>
            <MudTd DataLabel="Child SKU">@context.ChildSku</MudTd>
            <MudTd DataLabel="Product">@context.Product.Name</MudTd>
            <MudTd DataLabel="Brand">@context.Product.Brand.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditParent(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<ParentModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<ParentModel>> ReloadParents(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<ParentModel> parents = ParentService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<ParentModel>() { TotalItems = ParentService.CountForListRequest(ListRequest), Items = parents });
	}

    private void FilterParents(string searchString)
	{
		ListRequest.SearchString = searchString;

		Table.ReloadServerData();

		StateHasChanged();
	}

    private async void AddParent()
    {
        var result = await DialogService.Show<ParentDialog>(null, new DialogParameters { ["Title"] = "Add Parent" }).Result;

        ProcessParentDialogResult(result);
    }

    private async void EditParent(long id)
    {
        var result = await DialogService.Show<ParentDialog>(null, new DialogParameters { ["Title"] = "Edit Parent", ["IsEdit"] = true, ["ParentId"] = id }).Result;

        ProcessParentDialogResult(result);
    }

    private void ProcessParentDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
