@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces

@inject IParentService ParentService

@if (PhotosCount > 0)
{
    <MudLink Href="@LinkHelper.GetUrlForVariantPhotosByProduct(Parent.Product.Id, Parent.Instance.Id)" title="View photos" Style="text-decoration: none;">@PhotosCount photos</MudLink>
}
else
{
    <span>0 photos</span>
}

@code {
    [Parameter] public ParentModel Parent { get; set; }

    private int PhotosCount = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        PhotosCount = ParentService.GetPhotoCountFor(Parent);
    }
}
