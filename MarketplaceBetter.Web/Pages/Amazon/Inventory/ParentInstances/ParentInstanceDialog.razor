@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Base
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Base.Interfaces
@using MarketplaceBetter.Services.Specialized.Interfaces;
@using MarketplaceBetter.Services.Validation.Amazon.Inventory.Interfaces

@inject ISnackbar Snackbar
@inject IParentInstanceService ParentInstanceService
@inject IParentInstanceValidator ParentInstanceValidator
@inject IBrandService BrandService
@inject IParentService ParentService
@inject IInstanceService InstanceService
@inject ICurrentBrandService CurrentBrandService
@inject ICurrentInstanceService CurrentInstanceService

<EditForm Model="ParentInstance" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Parent" T="ParentModel" Value="ParentInstance.Parent" For="() => ParentInstance.Parent" ValueChanged="HandleParentChanged" Disabled="ParentSelectDisabled">
            @foreach (var parent in Parents)
            {
                <MudSelectItem Value="parent">@parent.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Instance" T="InstanceModel" Value="ParentInstance.Instance" For="() => ParentInstance.Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="ParentInstance.Sku" For="() => ParentInstance.Sku" />
        <MudTextField Label="ASIN" @bind-Value="ParentInstance.Asin" For="() => ParentInstance.Asin" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long ParentInstanceId { get; set; }

    private CustomValidation CustomValidation = new();
    private ParentInstanceModel ParentInstance = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<InstanceModel> Instances;
    private IList<ParentModel> Parents = new List<ParentModel>();

    private bool ParentSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);
        Instances = InstanceService.GetAllNormal(true);

        if (IsEdit)
        {
            SetInitialValues();
        }
        else
        {
            if (CurrentBrandService.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }

            if (CurrentInstanceService.IsSpecificInstance())
            {
                SetValuesForCurrentInstance();
            }
        }
    }

    private void SetInitialValues()
    {
        ParentInstance = ParentInstanceService.Get(ParentInstanceId);

        ActivateParent(ParentInstance.Parent.Product.Brand.Id);

        Brand = Brands.Single(b => b.Id == ParentInstance.Parent.Product.Brand.Id);
        ParentInstance.Parent = Parents.Single(p => p.Id == ParentInstance.Parent.Id);
        ParentInstance.Instance = Instances.Single(i => i.Id == ParentInstance.Instance.Id);
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == CurrentBrandService.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void SetValuesForCurrentInstance()
    {
        InstanceModel currentInstance = Instances.Single(b => b.Id == CurrentInstanceService.GetCurrentInstance().Id);

        HandleInstanceChanged(currentInstance);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetParent();
        ActivateParent(brand.Id);
        SetParentInstanceSku();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        ParentInstance.Instance = instance;
        SetParentInstanceSku();
    }

    private void HandleParentChanged(ParentModel parent)
    {
        ParentInstance.Parent = parent;
        SetParentInstanceSku();
    }

    private void ResetParent()
    {
        ParentInstance.Parent = null;
        ParentSelectDisabled = true;
        Parents = new List<ParentModel>();
    }

    private void ActivateParent(long brandId)
    {
        ParentSelectDisabled = false;
        Parents = ParentService.GetAllForBrand(brandId);
    }

    private void SetParentInstanceSku()
    {
        ParentInstance.Sku = ParentInstanceService.GetSkuFor(ParentInstance.Parent?.Id, ParentInstance.Instance?.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ParentInstanceValidator.Validate(ParentInstance);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ParentInstanceService.Update(ParentInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Parent Instance"));
            }
            else
            {
                ParentInstanceService.Add(ParentInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Parent Instance"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}