@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.CopyAndMedia.Interfaces;
@using MarketplaceBetter.Services.Model
@using MarketplaceBetter.Services.Specialized.Interfaces;
@using System.IO

@page "/parent-instances"
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IParentInstanceService ParentInstanceService
@inject ITemplateCreator TemplateCreator
@inject ITemplateService TemplateService

<MudText Typo="Typo.h4" Class="mt-2">Parent Instances</MudText>

<MainBody>
    <MudTable T="ParentInstanceModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<ParentInstanceModel>>>(Reload))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="ChangeStatusOfSelected" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PublishedWithChanges" Color="Color.Info" Disabled="NoneSelected" Class="ml-2">Change Status</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="ParentInstanceModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="sku" T="ParentInstanceModel">SKU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="asin" T="ParentInstanceModel">ASIN</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="status" T="ParentInstanceModel">Status</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="ParentInstanceModel">Instance</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product" T="ParentInstanceModel">Product</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="ParentInstanceModel">Brand</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="template" T="ParentInstanceModel">Template</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="category" T="ParentInstanceModel">Category</MudTableSortLabel></MudTh>
            <MudTh Style="width: 250px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="SKU">
                @context.Sku
                <ProductPageLinkDisplay Instance="@context.Instance" Asin="@context.Asin" />
            </MudTd>
            <MudTd DataLabel="ASIN">@context.Asin</MudTd>
            <MudTd DataLabel="Status"><EntityStatusDisplay Status="@context.Status" /></MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd DataLabel="Product">@context.Product.Code</MudTd>
            <MudTd DataLabel="Brand">@context.Product.Brand.Name</MudTd>
            <MudTd DataLabel="Template"><TemplateDisplay Parent="@context" /></MudTd>
            <MudTd DataLabel="Category"><CategoryDisplay Category="@context.Category" /></MudTd>
            <MudTd>
                <MudFileUpload T="IBrowserFile" @bind-Files="File" Context="file" OnFilesChanged="@(() => UploadTemplate(context))" Class="d-inline-flex mt-0">
                    <ButtonTemplate>
                        <MudButton for="@file" HtmlTag="label" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Upload</MudButton>
                    </ButtonTemplate>
                </MudFileUpload>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="@(() => Export(context.Id, context.Sku))">Export</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => Edit(context.Id))">Edit</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            @if (!ShowAll.HasValue || ShowAll == false)
            {
                <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
            }
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }
    [Parameter][SupplyParameterFromQuery] public long? ProductId { get; set; }
    [Parameter][SupplyParameterFromQuery] public bool? ShowAll { get; set; }

    private MudTable<ParentInstanceModel> Table;
    private ListRequest ListRequest = new();

    private HashSet<ParentInstanceModel> SelectedParents = new HashSet<ParentInstanceModel>();
    private bool NoneSelected = true;
    private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

    private IBrowserFile File;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
        if (ProductId.HasValue)
        {
            ListRequest.SearchString = $"product_id: {ProductId.Value}";
        }
        if (ShowAll.HasValue)
        {
            ListRequest.ShowAll = ShowAll.Value;
        }
    }

    private Task<TableData<ParentInstanceModel>> Reload(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<ParentInstanceModel> parentInstances = ParentInstanceService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<ParentInstanceModel>() { TotalItems = ParentInstanceService.CountForListRequest(ListRequest), Items = parentInstances });
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        CurrentRowsPerPageValue = rowsPerPage;
    }

    private void Filter(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void Edit(long id)
    {
        var result = await DialogService.Show<ParentInstanceDialog>(null, new DialogParameters { ["Title"] = "Edit Parent Instance", ["IsEdit"] = true, ["ParentInstanceId"] = id }).Result;

        ProcessDialogResult(result);
    }

    private void ProcessDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }

    private async void ChangeStatusOfSelected()
    {
        var result = await DialogService.Show<ParentInstancesSetStatusDialog>(null, new DialogParameters { ["ParentInstances"] = SelectedParents.ToList() }).Result;

        ProcessDialogResult(result);
    }

    private void OnSelectedItemsChanged(HashSet<ParentInstanceModel> selectedParents)
    {
        SelectedParents = selectedParents;

        if (SelectedParents.Any())
        {
            NoneSelected = false;
        }
        else
        {
            NoneSelected = true;
        }
    }

    private async Task Export(long id, string sku)
    {
        using Stream fileStream = TemplateCreator.CreateTemplateFor(id);

        using var streamReference = new DotNetStreamReference(fileStream);

        await JS.InvokeVoidAsync("DownloadFileFromStream", $"{sku}.csv", streamReference);
    }

    private async void UploadTemplate(ParentInstanceModel parent)
    {
        string fileWithoutExtension = File.Name.Remove(File.Name.LastIndexOf('.'));

        if (fileWithoutExtension != parent.Sku)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter; ;
            Snackbar.Add("File name has to be same as SKU of the parent instance. Correct the name of file and upload it again.", Severity.Error);

            return;
        }

        MemoryStream memoryStream = new MemoryStream();
        await File.OpenReadStream(Standard.UploadTemplateSizeLimit).CopyToAsync(memoryStream);
        memoryStream.Seek(0, SeekOrigin.Begin);

        TemplateService.Save(memoryStream, File.Name, parent.Id);

        await Table.ReloadServerData();
    }
}
