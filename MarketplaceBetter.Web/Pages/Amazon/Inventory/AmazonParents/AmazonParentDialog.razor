@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Amazon.Inventory
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Inventory.Interfaces

@inject IAmazonParentService AmazonParentService
@inject IAmazonParentValidator AmazonParentValidator
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IInstanceService InstanceService
@inject ISnackbar Snackbar

<EditForm Model="AmazonParent" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="AmazonParent.Product" For="() => AmazonParent.Product" ValueChanged="HandleProductChanged" Disabled="ProductSelectDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="AmazonParent.Sku" For="() => AmazonParent.Sku" />
        <MudTextField Label="Child SKU" @bind-Value="AmazonParent.ChildSku" For="() => AmazonParent.ChildSku" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long AmazonParentId { get; set; }

    private CustomValidation CustomValidation = new();
    private AmazonParentModel AmazonParent = new();
    private BrandModel Brand;

    private IList<BrandModel> Brands;
    private IList<ProductModel> Products = new List<ProductModel>();

    private bool ProductSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        AmazonParent = AmazonParentService.Get(AmazonParentId);

        ActivateProduct(AmazonParent.Product.Brand.Id);

        Brand = Brands.Single(b => b.Id == AmazonParent.Product.Brand.Id);
        AmazonParent.Product = Products.Single(p => p.Id == AmazonParent.Product.Id);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);
        SetParentSku();
    }

    private void HandleProductChanged(ProductModel product)
    {
        AmazonParent.Product = product;
        SetParentSku();
    }

    private void ResetProduct()
    {
        AmazonParent.Product = null;
        ProductSelectDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductSelectDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void SetParentSku()
    {
        AmazonParent.Sku = null;

        if (AmazonParent.Product != null)
        {
            AmazonParent.Sku = AmazonParent.Product.Name.ToLower().Replace(" ", "_");
        }
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = AmazonParentValidator.Validate(AmazonParent);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                AmazonParentService.Update(AmazonParent);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Amazon Parent"));
            }
            else
            {
                AmazonParentService.Add(AmazonParent);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Amazon Parent"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}