@using MarketplaceBetter.Domain.Model.Amazon.CopyAndMedia
@using MarketplaceBetter.Services.Domain.Amazon.CopyAndMedia.Interfaces
@using MarketplaceBetter.Services.Model
@using MarketplaceBetter.Specialized.Interfaces

@page "/photos"
<PageTitle>Photos</PageTitle>

@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IPhotoService PhotoService
@inject IPhotoCloudService PhotoCloudService

<MudText Typo="Typo.h4" Class="mt-2">Photos</MudText>

<MainBody>
    <MudTable T="PhotoModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<PhotoModel>>>(Reload))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudCheckBox T="bool" T="bool" Label="Show shared only" Value="ShowSharedOnly" Class="mt-4" ValueChanged="OnShowSharedOnlyChanged" />
            <MudSpacer />
            <MudButton OnClick="ChangeTypeOfSelected" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Workspaces" Color="Color.Dark" Disabled="NoneSelected" Class="ml-2">Change Type</MudButton>
            <MudButton OnClick="DeleteSelected" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="NoneSelected" Class="ml-2">Delete</MudButton>
            <MudButton OnClick="AddMultiple" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.FastForward" Color="Color.Info" Class="ml-2">Add multiple</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="PhotoModel">Id</MudTableSortLabel></MudTh>
            <MudTh>Photo</MudTh>
            <MudTh><MudTableSortLabel SortLabel="variant" T="PhotoModel">Variant</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="asin" T="PhotoModel">ASIN</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="type" T="PhotoModel">Type</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="kind" T="PhotoModel">Kind</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="PhotoModel">Instance</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="width" T="PhotoModel">Width</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="height" T="PhotoModel">Height</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="uploaded" T="PhotoModel">Uploaded</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="comment" T="PhotoModel">Comment</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Photo"><PhotoOnListDisplay CloudId="@context.CloudId" Version="@context.Version" Size="PhotoOnListSizeEnum.S100" /></MudTd>
            <MudTd DataLabel="Variant">@context.Variant.Sku</MudTd>
            <MudTd DataLabel="ASIN">@context.Variant.Asin</MudTd>
            <MudTd DataLabel="Type">@context.Type.Name</MudTd>
            <MudTd DataLabel="Kind">@context.Kind.Name</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd DataLabel="Width">@context.Width</MudTd>
            <MudTd DataLabel="Height">@context.Height</MudTd>
            <MudTd DataLabel="Uploaded">@context.Uploaded</MudTd>
            <MudTd DataLabel="Comment"><PhotoComment Photo="context" /></MudTd>
            <MudTd>
                <MudButton Class="mt-1" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Id, context.Type.Name, context.Variant.Sku))">Delete</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }"  />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

    private MudTable<PhotoModel> Table;
    private ListRequest ListRequest = new();
    private bool ShowSharedOnly;

    private HashSet<PhotoModel> SelectedPhotos = new HashSet<PhotoModel>();
    private bool NoneSelected = true;
    private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
    }

    private Task<TableData<PhotoModel>> Reload(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<PhotoModel> photos = PhotoService.GetForListRequest(ListRequest, ShowSharedOnly);

        return Task.FromResult(new TableData<PhotoModel>() { TotalItems = PhotoService.CountForListRequest(ListRequest, ShowSharedOnly), Items = photos });
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        CurrentRowsPerPageValue = rowsPerPage;
    }

    private void Filter(string searchString)
    {
        ListRequest.SearchString = searchString;

        string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
        Navigation.NavigateTo(newUrl, replace: true);

        Table.ReloadServerData();
        StateHasChanged();
    }

    private void OnShowSharedOnlyChanged(bool showSharedOnly)
    {
        ShowSharedOnly = showSharedOnly;

        Table.ReloadServerData();
        StateHasChanged();
    }

    private async void Add()
    {
        DialogResult result = await DialogService.Show<PhotoDialog>(null, new DialogParameters { ["Title"] = "Add Photo" }).Result;

        ProcessDialogResult(result);
    }

    private void AddMultiple()
    {
        Navigation.NavigateTo($"add-photos");
    }

    private async void AddSimilar(long id)
    {
        DialogResult result = await DialogService.Show<PhotoDialog>(null, new DialogParameters { ["Title"] = "Add Photo", ["AddingSimilar"] = true, ["PhotoId"] = id }).Result;

        ProcessDialogResult(result);
    }

    private async void Edit(long id)
    {
        DialogResult result = await DialogService.Show<PhotoDialog>(null, new DialogParameters { ["Title"] = "Edit Photo", ["IsEdit"] = true, ["PhotoId"] = id }).Result;

        ProcessDialogResult(result);
    }

    private async void Delete(long id, string type, string variant)
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = $"Are you sure you want to delete <b>{type}</b> photo for variant <b>{variant}</b> ?" }).Result;

        if (!result.Canceled)
        {
            PhotoService.Delete(id);

            await Table.ReloadServerData();

            Snackbar.AddSuccess(OperationMessages.SuccessfullyDeleted("Photo"));
        }
    }

    private async void DeleteSelected()
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = $"Are you sure you want to delete selected photos?" }).Result;

        if (!result.Canceled)
        {
            PhotoService.Delete(SelectedPhotos.ToList());

            await Table.ReloadServerData();

            Snackbar.AddSuccess("Photos were successfully deleted.");
        }
    }

    private async void ChangeTypeOfSelected()
    {
        DialogResult result = await DialogService.Show<PhotosChangeTypeDialog>(null, new DialogParameters { ["PhotosToUpdate"] = SelectedPhotos.ToList() }).Result;

        ProcessDialogResult(result);
    }

    private void ProcessDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }

    private void OnSelectedItemsChanged(HashSet<PhotoModel> selectedPhotos)
    {
        SelectedPhotos = selectedPhotos;

        if (SelectedPhotos.Any())
        {
            NoneSelected = false;
        }
        else
        {
            NoneSelected = true;
        }
    }
}
