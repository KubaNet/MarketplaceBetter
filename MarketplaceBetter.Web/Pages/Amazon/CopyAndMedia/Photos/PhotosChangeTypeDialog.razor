@using MarketplaceBetter.Domain.Model.Amazon.CopyAndMedia;
@using MarketplaceBetter.Services.Validation.Amazon.CopyAndMedia.Interfaces;
@using MarketplaceBetter.Services.Domain.Amazon.CopyAndMedia.Interfaces;

@inject ISnackbar Snackbar
@inject IPhotoService PhotoService
@inject IPhotoTypeService PhotoTypeService
@inject IPhotoValidator PhotoValidator

<EditForm Model="Type" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title="Change type of photos">
        <ValidationSummary />
        <MudSelect Label="Type" T="PhotoTypeModel" @bind-Value="Type" ReadOnly="!PhotoInfoHidden">
            @foreach (var type in Types)
            {
                <MudSelectItem Value="type">@type.Name</MudSelectItem>
            }
        </MudSelect>
        <MudProgressLinear Class="mt-4" Value="CurrentProgressValue" Color="Color.Primary" Size="Size.Medium" />
        <MudText Class="ma-4" Typo="Typo.body1" Align="Align.Center">Progress <b>@CurrentPhotoNumber / @TotalPhotoCount</b></MudText>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public IList<PhotoModel> PhotosToUpdate { get; set; }

    private CustomValidation CustomValidation = new();
    private PhotoTypeModel Type = new PhotoTypeModel();
    private IList<PhotoTypeModel> Types;

    private bool PhotoInfoHidden = true;
    private double CurrentProgressValue;
    private int CurrentPhotoNumber = 0;
    private int TotalPhotoCount;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Types = PhotoTypeService.GetAll();
        Type = Types.First();

        TotalPhotoCount = PhotosToUpdate.Count;
    }

    private void HandleValidSubmit()
    {
        ValidationResult validationResult = PhotoValidator.ValidateTypeChange(PhotosToUpdate, Type);

        if (validationResult.IsValid)
        {
            PhotoInfoHidden = false;
            double progressStep = (double)100 / (double)TotalPhotoCount;
            StateHasChanged();

            foreach (var photo in PhotosToUpdate)
            {
                PhotoService.UpdateType(photo, Type);

                CurrentProgressValue += progressStep;
                CurrentPhotoNumber++;
                StateHasChanged();
            }

            Snackbar.AddSuccess("Type of photos was successfully changed.");

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(validationResult.Errors);
        }
    }
}