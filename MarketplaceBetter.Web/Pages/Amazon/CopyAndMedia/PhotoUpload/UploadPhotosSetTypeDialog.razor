@using MarketplaceBetter.Domain.Model.Amazon.CopyAndMedia;
@using MarketplaceBetter.Services.Domain.Amazon.CopyAndMedia.Interfaces;

@inject IPhotoTypeService PhotoTypeService
@inject IPhotoUploadService PhotoUploadService
@inject ISnackbar Snackbar

<EditForm Model="Type" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title="Set type of photos">
        <ValidationSummary />
        <MudSelect Label="Type" T="PhotoTypeModel" @bind-Value="Type">
            @foreach (var type in Types)
            {
                <MudSelectItem Value="type">@type.Name</MudSelectItem>
            }
        </MudSelect>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public IList<PhotoUploadModel> PhotoUploadsToUpdate { get; set; }
    [Parameter] public IList<PhotoUploadModel> AllPhotoUploads { get; set; }

    private CustomValidation CustomValidation = new();
    private PhotoTypeModel Type = new PhotoTypeModel();
    private IList<PhotoTypeModel> Types;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Types = PhotoTypeService.GetAll();

        Type = Types.First();
    }

    private void HandleValidSubmit()
    {
        foreach (var photoUploadToUpdate in PhotoUploadsToUpdate)
        {
            if (AllPhotoUploads.Any(p => p.Id != photoUploadToUpdate.Id && p.Instance.Id == photoUploadToUpdate.Instance.Id && p.Variants.Any(v1 => photoUploadToUpdate.Variants.Any(v2 => v2.Variant.Id == v1.Variant.Id)) && p.Type != null && p.Type.Id == Type.Id))
            {
                CustomValidation.DisplayError("Can't set this type to selected photos because another photo that is on list has same type (and instance) and is for same variant. Each photo of a variant has to have different type (for same instance).");

                return;
            }
        }

        PhotoUploadService.SetType(PhotoUploadsToUpdate, Type);

        Snackbar.AddSuccess("Type of photos was successfully set.");

        MudDialog.Close();
    }
}