@using MarketplaceBetter.Domain.Entities.Amazon.CopyAndMedia
@using MarketplaceBetter.Domain.Model.Amazon.CopyAndMedia
@using MarketplaceBetter.Services.Domain.Amazon.CopyAndMedia.Interfaces
@using MarketplaceBetter.Services.Model;
@using System.IO

@page "/copywriting"
<PageTitle>Copywriting</PageTitle>

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ICopywritingService CopywritingService

<MudText Typo="Typo.h4" Class="mt-2">Copywriting</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<CopywritingModel>>>(ReloadCopywritings))" Dense="true" Hover="true" RowsPerPage=Standard.InitialRowsPerPage>
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="FilterCopywritings" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="GetMissing" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CloudDownload" Color="Color.Info" Class="ml-2">Get Missing</MudButton>
            <MudButton OnClick="AddCopywriting" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Copywriting</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="CopywritingModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product" T="CopywritingModel">Product</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="CopywritingModel">Instance</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="element" T="CopywritingModel">Element</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="value" T="CopywritingModel">Value</MudTableSortLabel></MudTh>
            <MudTh Style="width: 170px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Product">@context.Product.Code</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd DataLabel="Element">@context.Element.Name</MudTd>
            <MudTd DataLabel="Value">
                @if (context.Element.SystemName != CopywritingElementEnum.Description)
                {
                    @context.Value
                }
                else
                {
                    <div @onclick="() => ToggleDescription(context.Id)">@context.Value</div>
                    <MudPopover Class="pa-4" Open="OpenInfo[context.Id]" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" OverflowBehavior="OverflowBehavior.FlipNever" Style="max-width: 1400px;">
                        <div class="copywriting-description-display">
                            @((MarkupString)context.Value)
                        </div>
                    </MudPopover>
                }
            </MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => AddSimilarCopywriting(context.Id))">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditCopywriting(context.Id))">Edit</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

    private MudTable<CopywritingModel> Table;
    private ListRequest ListRequest = new();
    private IDictionary<long, bool> OpenInfo;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
    }

    private Task<TableData<CopywritingModel>> ReloadCopywritings(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<CopywritingModel> copywritings = CopywritingService.GetForListRequest(ListRequest);

        InitializeOpenInfo(copywritings);

        return Task.FromResult(new TableData<CopywritingModel>() { TotalItems = CopywritingService.CountForListRequest(ListRequest), Items = copywritings });
    }

    private void FilterCopywritings(string searchString)
    {
        ListRequest.SearchString = searchString;

        string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
        Navigation.NavigateTo(newUrl, replace: true);

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddCopywriting()
    {
        DialogResult result = await DialogService.Show<CopywritingDialog>(null, new DialogParameters { ["Title"] = "Add Copywriting" }).Result;

        ProcessCopywritingDialogResult(result);
    }

    private async void AddSimilarCopywriting(long id)
    {
        DialogResult result = await DialogService.Show<CopywritingDialog>(null, new DialogParameters { ["Title"] = "Add Copywriting", ["AddingSimilar"] = true, ["CopywritingId"] = id }).Result;

        ProcessCopywritingDialogResult(result);
    }

    private async void EditCopywriting(long id)
    {
        DialogResult result = await DialogService.Show<CopywritingDialog>(null, new DialogParameters { ["Title"] = "Edit Copywriting", ["IsEdit"] = true, ["CopywritingId"] = id }).Result;

        ProcessCopywritingDialogResult(result);
    }

    private void ProcessCopywritingDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }

    private void InitializeOpenInfo(IList<CopywritingModel> copywritings)
    {
        OpenInfo = new Dictionary<long, bool>();

        foreach (var copywriting in copywritings.Where(c => c.Element.SystemName == CopywritingElementEnum.Description))
        {
            OpenInfo.Add(copywriting.Id, false);
        }
    }

    private void ToggleDescription(long id)
    {
        OpenInfo[id] = !OpenInfo[id];
    }

    private async Task GetMissing()
    {
        using Stream fileStream = CopywritingService.GetMissing();

        using var streamReference = new DotNetStreamReference(fileStream);

        await JS.InvokeVoidAsync("DownloadFileFromStream", $"Missing Copywriting.csv", streamReference);
    }
}
