@using MarketplaceBetter.Domain.Model.Amazon.CopyAndMedia;
@using MarketplaceBetter.Domain.Model.Base;
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Amazon.CopyAndMedia.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces
@using MarketplaceBetter.Services.Model;

@page "/variant-photos"
<PageTitle>Variant Photos</PageTitle>

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IVariantPhotosService VariantPhotosService
@inject IPhotoTypeService PhotoTypeService

<MudText Typo="Typo.h4" Class="mt-2">Variant Photos</MudText>

<MainBody>
    <MudTable T="VariantPhotosModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<VariantPhotosModel>>>(Reload))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudCheckBox T="bool" T="bool" Label="Show shared only" Value="ShowSharedOnly" Class="mt-4" ValueChanged="OnShowSharedOnlyChanged" />
            <MudSpacer />
            <MudButton OnClick="DownloadPhotos" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Download" Color="Color.Secondary" Disabled="NoneSelected" Class="ml-2">Download</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh Class="variant-photo-sku-cell"><MudTableSortLabel SortLabel="variant" T="VariantPhotosModel">Variant</MudTableSortLabel></MudTh>
            <MudTh Class="variant-photo-sku-cell"><MudTableSortLabel SortLabel="asin" T="VariantPhotosModel">ASIN</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="VariantPhotosModel">Instance</MudTableSortLabel></MudTh>
            @foreach (var type in Types)
            {
                <MudTh>@type.Name</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="variant-photo-sku-cell" DataLabel="Variant">@context.Variant.Sku</MudTd>
            <MudTd Class="variant-photo-sku-cell" DataLabel="ASIN">@context.Variant.Asin</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            @foreach (var type in Types)
            {
                <MudTd>
                    @if (context.Photos.Any(t => t.Type.Id == type.Id))
                    {
                        <PhotoOnListDisplay CloudId="@context.Photos.Single(t => t.Type.Id == type.Id).CloudId" Version="@context.Photos.Single(t => t.Type.Id == type.Id).Version" Size="PhotoOnListSizeEnum.S200"></PhotoOnListDisplay>
                    }
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            @if (!ShowAll.HasValue || ShowAll == false)
            {
                <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
            }
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }
    [Parameter][SupplyParameterFromQuery] public long? ProductId { get; set; }
    [Parameter][SupplyParameterFromQuery] public long? VariantId { get; set; }
    [Parameter][SupplyParameterFromQuery] public long? InstanceId { get; set; }
    [Parameter][SupplyParameterFromQuery] public bool? ShowAll { get; set; }

    private MudTable<VariantPhotosModel> Table;
    private ListRequest ListRequest = new();
    private bool ShowSharedOnly;
    private IList<PhotoTypeModel> Types;

    private HashSet<VariantPhotosModel> SelectedVariantPhotos = new HashSet<VariantPhotosModel>();
    private bool NoneSelected = true;
    private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();

        Types = PhotoTypeService.GetAll();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
        if (ProductId.HasValue)
        {
            ListRequest.SearchString += $"& product_id: {ProductId.Value} ";
        }
        if (VariantId.HasValue)
        {
            ListRequest.SearchString += $"& variant_id: {VariantId.Value} ";
        }
        if (InstanceId.HasValue)
        {
            ListRequest.SearchString += $"& instance_id: {InstanceId.Value} ";
        }
        if (ShowAll.HasValue)
        {
            ListRequest.ShowAll = ShowAll.Value;
        }
    }

    private Task<TableData<VariantPhotosModel>> Reload(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<VariantPhotosModel> variantPhotos = VariantPhotosService.GetForListRequest(ListRequest, ShowSharedOnly);

        return Task.FromResult(new TableData<VariantPhotosModel>() { TotalItems = VariantPhotosService.CountForListRequest(ListRequest, ShowSharedOnly), Items = variantPhotos });
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        CurrentRowsPerPageValue = rowsPerPage;
    }

    private void Filter(string searchString)
    {
        ListRequest.SearchString = searchString;

        string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
        Navigation.NavigateTo(newUrl, replace: true);

        Table.ReloadServerData();
        StateHasChanged();
    }

    private void OnShowSharedOnlyChanged(bool showSharedOnly)
    {
        ShowSharedOnly = showSharedOnly;
        
        Table.ReloadServerData();
        StateHasChanged();
    }

    private void OnSelectedItemsChanged(HashSet<VariantPhotosModel> selectedVariantPhotos)
    {
        SelectedVariantPhotos = selectedVariantPhotos;

        if (SelectedVariantPhotos.Any())
        {
            NoneSelected = false;
        }
        else
        {
            NoneSelected = true;
        }
    }

    private async void DownloadPhotos()
    {
        if (SelectedVariantPhotos.Any(p => String.IsNullOrWhiteSpace(p.Variant.Asin)))
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Some of selected variants don't have assigned ASIN. This is necessary to download their photos.", Severity.Warning);

            return;
        }

        InstanceModel firstInstance = SelectedVariantPhotos.First().Instance;
        if (SelectedVariantPhotos.Any(p => p.Instance.Id != firstInstance.Id))
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("To download photos the Instance has to be the same for all selected variants.", Severity.Warning);

            return;
        }

        DialogResult result = await DialogService.Show<DownloadPhotosDialog>(null, new DialogParameters { ["VariantPhotos"] = SelectedVariantPhotos.ToList() }, new DialogOptions { BackdropClick = false }).Result;

        Table.SelectedItems.Clear();

        StateHasChanged();
    }
}
