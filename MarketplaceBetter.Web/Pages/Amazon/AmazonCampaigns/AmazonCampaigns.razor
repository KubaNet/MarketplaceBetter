@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Model

@page "/amazoncampaigns"
@inject IAmazonCampaignService AmazonCampaignService
@inject IDialogService DialogService

<MudText Typo="Typo.h3">Amazon Campaigns</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<AmazonCampaignModel>>>(ReloadCampaigns))" Dense="true" Hover="true">
        <ToolBarContent>
			<MudTextField Placeholder="Search" T="string" ValueChanged="FilterCampaigns" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
            <MudButton OnClick="AddAmazonCampaign" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Amazon Campaign</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="AmazonCampaignModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="sku" T="AmazonCampaignModel">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product" T="AmazonCampaignModel">Product</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="brand" T="AmazonCampaignModel">Brand</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="AmazonCampaignModel">Instance</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Product">@context.Product.Name</MudTd>
            <MudTd DataLabel="Brand">@context.Product.Brand.Name</MudTd>
            <MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditAmazonCampaign(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<AmazonCampaignModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<AmazonCampaignModel>> ReloadCampaigns(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<AmazonCampaignModel> parents = AmazonCampaignService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<AmazonCampaignModel>() { TotalItems = AmazonCampaignService.CountForListRequest(ListRequest), Items = parents });
	}

    private void FilterCampaigns(string searchString)
	{
		ListRequest.SearchString = searchString;

		Table.ReloadServerData();

		StateHasChanged();
	}

    private async void AddAmazonCampaign()
    {
        var result = await DialogService.Show<AmazonCampaignDialog>(null, new DialogParameters { ["Title"] = "Add Amazon Campaign" }).Result;

        ProcessAmazonCampaignDialogResult(result);
    }

    private async void EditAmazonCampaign(long id)
    {
        var result = await DialogService.Show<AmazonCampaignDialog>(null, new DialogParameters { ["Title"] = "Edit Amazon Campaign", ["IsEdit"] = true, ["AmazonCampaignId"] = id }).Result;

        ProcessAmazonCampaignDialogResult(result);
    }

    private void ProcessAmazonCampaignDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
