@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces

@page "/mainphrases"
@inject IMainPhraseService MainPhraseService
@inject IDialogService DialogService

<MudText Typo="Typo.h3">Main Phrases</MudText>

<MainBody>
    <MudTable Items="@MainPhrasesData" Dense="true">
        <ToolBarContent>
            <MudButton OnClick="AddMainPhrase" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary">Add Main Phrase</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Analysis</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Description</MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Analysis.Name</MudTd>
            <MudTd DataLabel="Code">@context.Name</MudTd>
            <MudTd DataLabel="Group">@context.Status.Name</MudTd>
            <MudTd DataLabel="Group">@context.Description</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditMainPhrase(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private IList<MainPhraseModel> MainPhrasesData { get; set; }

    private async void AddMainPhrase()
    {
        var result = await DialogService.Show<MainPhraseDialog>(null, new DialogParameters { ["Title"] = "Add Main Phrase" }).Result;

        ProcessMainPhraseDialogResult(result);
    }

    private async void EditMainPhrase(long id)
    {
        var result = await DialogService.Show<MainPhraseDialog>(null, new DialogParameters { ["Title"] = "Edit Main Phrase", ["IsEdit"] = true, ["MainPhraseId"] = id }).Result;

        ProcessMainPhraseDialogResult(result);
    }

    private void ProcessMainPhraseDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            MainPhrasesData = MainPhraseService.GetAll();

            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        MainPhrasesData = MainPhraseService.GetAll();
    }
}
