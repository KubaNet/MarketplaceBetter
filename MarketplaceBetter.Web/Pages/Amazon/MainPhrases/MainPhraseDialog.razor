@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Interfaces

@inject IMainPhraseService MainPhraseService
@inject IMainPhraseValidator MainPhraseValidator
@inject IKeywordAnalysisService KeywordAnalysisService
@inject IMainPhraseStatusService MainPhraseStatusService
@inject ISnackbar Snackbar

<EditForm Model="MainPhrase" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudSelect T="KeywordAnalysisModel" @bind-Value="MainPhrase.Analysis" Label="Analysis" For="() => MainPhrase.Analysis">
            @foreach (var analysis in Analyses)
            {
                <MudSelectItem Value="analysis">@analysis.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Name" @bind-Value="MainPhrase.Name" For="() => MainPhrase.Name" />
        <MudTextField Label="Description" @bind-Value="MainPhrase.Description" For="() => MainPhrase.Description" />
        <MudSelect T="MainPhraseStatusModel" @bind-Value="MainPhrase.Status" Label="Status" For="() => MainPhrase.Status">
            @foreach (var status in Statuses)
            {
                <MudSelectItem Value="status">@status.Name</MudSelectItem>
            }
        </MudSelect>
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long MainPhraseId { get; set; }

    CustomValidation CustomValidation = new();
    MainPhraseModel MainPhrase = new();
    IList<KeywordAnalysisModel> Analyses;
    IList<MainPhraseStatusModel> Statuses;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Analyses = KeywordAnalysisService.GetAll();
        Statuses = MainPhraseStatusService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        MainPhrase = MainPhraseService.Get(MainPhraseId);
        MainPhrase.Analysis = Analyses.Single(a => a.Id == MainPhrase.Analysis.Id);
        MainPhrase.Status = Statuses.Single(s => s.Id == MainPhrase.Status.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = MainPhraseValidator.Validate(MainPhrase);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                MainPhraseService.Update(MainPhrase);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Main Phrase"));
            }
            else
            {
                MainPhraseService.Add(MainPhrase);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Main Phrase"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}