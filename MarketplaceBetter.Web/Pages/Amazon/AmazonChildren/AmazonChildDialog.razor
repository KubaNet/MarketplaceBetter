    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetParent();
        ActivateParent();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        Instance = instance;

        ResetParent();
        ActivateParent();
    }

    private void HandleParentChanged(AmazonParentModel parent)
    {
        AmazonChild.Parent = parent;
        //SetChildSku();
    }

    private void HandleProductVariantChanged(ProductVariantModel productVariant)
    {
        AmazonChild.ProductVariant = productVariant;
    }

    private void ResetParent()
    {
        AmazonChild.Parent = null;
        ParentSelectDisabled = true;
        Parents = new List<AmazonParentModel>();
    }

    private void ActivateParent()
    {
        if (Brand != null && Instance != null)
        {
            ParentSelectDisabled = false;
            Parents = AmazonParentService.GetAllForBrandAndInstance(Brand.Id, Instance.Id).OrderBy(p => p.Sku).ToList();
        }
    }

    @*    private void SetChildSku()
        {
        AmazonChild.Sku = null;

        if (AmazonChild.Parent != null && AmazonChild.Instance != null)
        {
        AmazonChild.Sku = string.Format("{0}_{1}", GetInstanceCode(AmazonChild.Instance), AmazonChild.Parent.Name.ToLower().Replace(" ", "_"));
        }
        else if (AmazonChild.Parent != null)
        {
        AmazonChild.Sku = AmazonChild.Parent.Name.ToLower().Replace(" ", "_");
        }
        else if (AmazonChild.Instance != null)
        {
        AmazonChild.Sku = GetInstanceCode(AmazonChild.Instance);
        }
        }*@

    private string GetInstanceCode(InstanceModel instance)
    {
        return instance.SystemName switch
        {
            InstanceEnum.AmazonUK => "uk",
            InstanceEnum.AmazonDE => "de",
            _ => throw new UnrecognizedEnumValue<InstanceEnum>(instance.SystemName)
        };
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = AmazonChildValidator.Validate(AmazonChild);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                AmazonChildService.Update(AmazonChild);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Amazon Child"));
            }
            else
            {
                AmazonChildService.Add(AmazonChild);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Amazon Child"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}