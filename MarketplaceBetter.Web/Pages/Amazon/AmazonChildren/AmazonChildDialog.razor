@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Interfaces

@inject IAmazonChildService AmazonChildService
@inject IAmazonChildValidator AmazonChildValidator
@inject IBrandService BrandService
@inject IInstanceService InstanceService
@inject IAmazonParentService AmazonParentService
@inject IProductVariantService ProductVariantService
@inject ISnackbar Snackbar

<EditForm Model="AmazonChild" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect T="BrandModel" Value="Brand" Label="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="InstanceModel" Value="Instance" Label="Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="AmazonParentModel" Value="AmazonChild.Parent" Label="Parent" For="() => AmazonChild.Parent" ValueChanged="HandleParentChanged" Disabled="ParentSelectDisabled">
            @foreach (var parent in Parents)
            {
                <MudSelectItem Value="parent">@parent.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="ProductVariantModel" Value="AmazonChild.ProductVariant" Label="ProductVariant" For="() => AmazonChild.ProductVariant" ValueChanged="HandleProductVariantChanged" Disabled="ProductVariantDisabled">
            @foreach (var productVariant in ProductVariants)
            {
                <MudSelectItem Value="productVariant">@productVariant.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Sku" @bind-Value="AmazonChild.Sku" For="() => AmazonChild.Sku" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long AmazonChildId { get; set; }

    CustomValidation CustomValidation = new();
    AmazonChildModel AmazonChild = new();
    BrandModel Brand;
    InstanceModel Instance;

    IList<BrandModel> Brands;
    IList<InstanceModel> Instances;
    IList<AmazonParentModel> Parents = new List<AmazonParentModel>();
    IList<ProductVariantModel> ProductVariants = new List<ProductVariantModel>();

    bool ParentSelectDisabled = true;
    bool ProductVariantDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();
        Instances = InstanceService.GetAllForAmazon();

        if (IsEdit)
        {
            //SetInitialValues();
        }
    }

