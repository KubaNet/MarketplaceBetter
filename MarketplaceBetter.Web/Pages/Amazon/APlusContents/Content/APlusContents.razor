@using MarketplaceBetter.Domain.Model.Amazon.APlusContents;
@using MarketplaceBetter.Services.Domain.Amazon.APlusContents.Interfaces;
@using MarketplaceBetter.Services.Model;

@page "/a-plus-content"

@inject IAPlusContentService APlusContentService
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mt-2">A+ Content</MudText>

<MainBody>
	<MudTable T="APlusContentModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<APlusContentModel>>>(Reload))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
		<ToolBarContent>
			<MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
			<MudSpacer />
			<MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Content</MudButton>
		</ToolBarContent>
		<HeaderContent>
			<MudTh><MudTableSortLabel SortLabel="id" T="APlusContentModel">Id</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="name" T="APlusContentModel">Name</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="status" T="APlusContentModel">Status</MudTableSortLabel></MudTh>
			<MudTh>Sections</MudTh>
			<MudTh><MudTableSortLabel SortLabel="product" T="APlusContentModel">Product</MudTableSortLabel></MudTh>
			<MudTh>Variant</MudTh>
			<MudTh><MudTableSortLabel SortLabel="instance" T="APlusContentModel">Instance</MudTableSortLabel></MudTh>
			<MudTh><MudTableSortLabel SortLabel="brand" T="APlusContentModel">Brand</MudTableSortLabel></MudTh>
			<MudTh Style="width: 100px;">Actions</MudTh>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="Id">@context.Id</MudTd>
			<MudTd DataLabel="Name">@context.Name</MudTd>
			<MudTd DataLabel="Status"><EntityStatusDisplay Status="@context.Status" /></MudTd>
			<MudTd DataLabel="Sections"><APlusSectionsDisplay Content="@context" /></MudTd>
			<MudTd DataLabel="Product">@context.Product.Code</MudTd>
			<MudTd DataLabel="Variant"><APlusContentVariantsDisplay Variants="@context.Variants.Select(v => v.Variant).OrderBy(v => v.Sku).ToList()" /></MudTd>
			<MudTd DataLabel="Instance">@context.Instance.Name</MudTd>
			<MudTd DataLabel="Brand">@context.Product.Brand.Name</MudTd>
			<MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Edit(context.Id))">Edit</MudButton></MudTd>
		</RowTemplate>
		<PagerContent>
			<MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
		</PagerContent>
	</MudTable>
</MainBody>

@code {
	[Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }

	private MudTable<APlusContentModel> Table;
	private ListRequest ListRequest = new();

	private HashSet<APlusContentModel> SelectedAPlusContents = new HashSet<APlusContentModel>();
	private bool NoneSelected = true;
	private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		ProcessQueryParameters();		
	}

	private void ProcessQueryParameters()
	{
		if (!String.IsNullOrWhiteSpace(SearchString))
		{
			ListRequest.SearchString = SearchString;
		}
	}

	private Task<TableData<APlusContentModel>> Reload(TableState state)
	{
		state.PopulateListRequest(ListRequest);

		IList<APlusContentModel> contents = APlusContentService.GetForListRequest(ListRequest);

		return Task.FromResult(new TableData<APlusContentModel>() { TotalItems = APlusContentService.CountForListRequest(ListRequest), Items = contents });
	}

	private void OnRowsPerPageChanged(int rowsPerPage)
	{
		CurrentRowsPerPageValue = rowsPerPage;
	}

	private void Filter(string searchString)
	{
		ListRequest.SearchString = searchString;

		Table.ReloadServerData();

		StateHasChanged();
	}

	private async void Add()
	{
		var result = await DialogService.Show<APlusContentDialog>(null, new DialogParameters { ["Title"] = "Add A+ Content" }).Result;

		ProcessDialogResult(result);
	}

	private async void Edit(long id)
	{
		var result = await DialogService.Show<APlusContentDialog>(null, new DialogParameters { ["Title"] = "Edit A+ Content", ["IsEdit"] = true, ["APlusContentId"] = id }).Result;

		ProcessDialogResult(result);
	}

	private void ProcessDialogResult(DialogResult result)
	{
		if (!result.Canceled)
		{
			Table.ReloadServerData();
		}
	}

	private void OnSelectedItemsChanged(HashSet<APlusContentModel> selectedAPlusContents)
	{
		SelectedAPlusContents = selectedAPlusContents;

		if (SelectedAPlusContents.Any())
		{
			NoneSelected = false;
		}
		else
		{
			NoneSelected = true;
		}
	}
}
