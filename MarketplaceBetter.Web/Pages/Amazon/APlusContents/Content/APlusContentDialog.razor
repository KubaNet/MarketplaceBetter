@using MarketplaceBetter.Domain.Model.Amazon.APlusContents;
@using MarketplaceBetter.Domain.Model.Base;
@using MarketplaceBetter.Domain.Model.Catalog.Products;
@using MarketplaceBetter.Services.Domain.Amazon.APlusContents.Interfaces;
@using MarketplaceBetter.Services.Domain.Base.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces;
@using MarketplaceBetter.Services.Validation.Amazon.APlusContents.Interfaces;

@inject ISnackbar Snackbar
@inject IAPlusContentService APlusContentService
@inject IAPlusContentValidator APlusContentValidator
@inject IInstanceService InstanceService
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IVariantService VariantService
@inject IUserService UserService

<EditForm Model="Content" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudSelect Label="Instance" T="InstanceModel" Value="Content.Instance" For="() => Content.Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" For="() => Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="Content.Product" For="() => Content.Product" ValueChanged="HandleProductChanged" Disabled="ProductDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Variants" T="string" MultiSelection="true" @bind-Value="VariantsValue" SelectedValues="SelectedVariants" SelectedValuesChanged="HandleVariantsChanged" Disabled="VariantsDisabled">
            @foreach (var variant in Variants)
            {
                <MudSelectItem Value="variant.Sku">@variant.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Name" @bind-Value="Content.Name" For="() => Content.Name" Disabled="NameDisabled" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long APlusContentId { get; set; }

    private CustomValidation CustomValidation = new();
    private BrandModel Brand;
    private APlusContentModel Content = new();
    private string VariantsValue;
    private IEnumerable<string> SelectedVariants = new HashSet<string>();

    private IList<BrandModel> Brands;
    private IList<InstanceModel> Instances;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<VariantModel> Variants = new List<VariantModel>();

    private bool ProductDisabled = true;
    private bool VariantsDisabled = true;
    private bool NameDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);
        Instances = InstanceService.GetAllNormal(true);

        if (IsEdit)
        {
            SetInitialValues();
        }
        else
        {
            if (UserService.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }
        }
    }

    private void SetInitialValues()
    {
        Content = APlusContentService.Get(APlusContentId);
        Brand = Brands.Single(b => b.Id == Content.Product.Brand.Id);

        ActivateProduct(Brand.Id);

        Content.Instance = Instances.Single(i => i.Id == Content.Instance.Id);
        Content.Product = Products.Single(p => p.Id == Content.Product.Id);

        ActivateVariants(Content.Product.Id);

        SelectedVariants = Content.Variants.Select(v => v.Variant.Sku);

        ActivateName();
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == UserService.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        Content.Instance = instance;

        UpdateName();
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);

        ResetName();
    }

    private void HandleProductChanged(ProductModel product)
    {
        Content.Product = product;

        ResetVariants();
        ActivateVariants(product.Id);
        ActivateName();
        UpdateName();
    }

    private void HandleVariantsChanged(IEnumerable<string> variants)
    {
        SelectedVariants = variants;

        UpdateName();
    }

    private void ResetProduct()
    {
        Content.Product = null;
        ProductDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void ResetVariants()
    {
        VariantsValue = null;
        SelectedVariants = new HashSet<string>();
        VariantsDisabled = true;
        Variants = new List<VariantModel>();
    }

    private void ActivateVariants(long productId)
    {
        VariantsDisabled = false;
        Variants = VariantService.GetAllForProduct(productId);
    }

    private void ResetName()
    {
        Content.Name = null;
        NameDisabled = true;
    }

    private void ActivateName()
    {
        NameDisabled = false;
    }

    private void UpdateName()
    {
        if (Content.Instance != null && Content.Product != null)
        {
            Content.Name = $"{InstanceHelper.GetCodeFor(Content.Instance.SystemName)}_{Content.Product.Brand.Code.ToLower()}_{Content.Product.Code}";

            if (SelectedVariants.Any())
            {
                if (SelectedVariants.Count() == 1)
                {
                    VariantModel variant = Variants.Single(v => v.Sku == SelectedVariants.First());

                    Content.Name += $"_{variant.Color.Code}_{variant.Size.Code}";
                }
                else
                {
                    IList<VariantModel> variants = Variants.Where(v => SelectedVariants.Contains(v.Sku)).ToList();

                    IList<IGrouping<string, VariantModel>> variantsByColor = variants.GroupBy(v => v.Color.Code).ToList();

                    foreach (var variantByColor in variantsByColor)
                    {
                        string color = variantByColor.Key;
                        IList<VariantModel> variantsBySizes = variantByColor.ToList();

                        Content.Name += $"_{color}";

                        foreach (var variantBySize in variantsBySizes.OrderBy(v => v.Size.Id))
                        {
                            Content.Name += $"_{variantBySize.Size.Code}";
                        }
                    }
                }
            }
        }
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = APlusContentValidator.Validate(Content);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                APlusContentService.Update(Content, SelectedVariants.ToList());
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("A+ Content"));
            }
            else
            {
                APlusContentService.Add(Content, SelectedVariants.ToList());
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("A+ Content"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}