@using MarketplaceBetter.Domain.Model.Amazon.APlusContents;
@using MarketplaceBetter.Services.Specialized.Interfaces;

@inject IAPlusImageCloudService ImageCloudService
@inject IRefreshService RefreshService
@inject IVariantPhotoNamingHelper NamingHelper

@if (UploadState)
{
    <InputFile id="@InputName" OnChange="AssignImage" hidden />
    <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" for="@InputName" Class="mt-4">
        Upload @ElementName
    </MudButton>
    @if (ImagesToAdd.ContainsKey(ElementName))
    {
        <MudList T="string">
            <MudListItem Icon="@Icons.Material.Filled.AttachFile">
                @ImagesToAdd[ElementName].Name <code>(@ImagesToAdd[ElementName].Size.BytesToKilobytes() KB)</code>
            </MudListItem>
        </MudList>
    }
}
else
{
    <div class="my-4 d-flex align-center">
        <div class="d-flex">
            <MudTooltip Placement="Placement.Right">
                <ChildContent>
                    <MudLink Typo="Typo.body2" Href="@ImageCloudService.GetOriginalUrl(ElementValue.Image.CloudId, ElementValue.Image.Version)" Target="_blank">
                        <MudImage Src="@ImageCloudService.GetSmallerUrlForDisplay(ElementValue.Image.CloudId, ElementValue.Image.Version)" />
                    </MudLink>
                </ChildContent>
                <TooltipContent>Click to open in new window</TooltipContent>
            </MudTooltip>
        </div>
        <div class="d-flex">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" title="Click to delete" OnClick="DeleteImage"></MudIconButton>
        </div>
    </div>
}

@code {
    [Parameter] public APlusElementValueModel ElementValue { get; set; }
    [Parameter] public IDictionary<string, IBrowserFile> ImagesToAdd { get; set; }
    [Parameter] public IList<string> ImagesToDelete { get; set; }
    [Parameter] public APlusElementValueModel ProductAsinField { get; set; }

    private string ElementName;
    private string InputName;
    private bool UploadState = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ElementName = ElementValue.Element.Name;
        InputName = $"FileInput_{ElementName.WithoutSpaces()}";
        UploadState = ElementValue.Image == null;
    }

    private void AssignImage(InputFileChangeEventArgs changeEvent)
    {
        ImagesToAdd.Remove(ElementName);
        ImagesToAdd.Add(ElementName, changeEvent.File);

        if (ProductAsinField != null)
        {
            IList<MarketplaceBetter.Domain.Entities.Catalog.Products.Variant> variants = NamingHelper.GetVariantsFrom(changeEvent.File.Name);

            if (variants != null && variants.Any())
            {
                ProductAsinField.SingleLineText = variants[0].Asin;
            }
            else
            {
                ProductAsinField.SingleLineText = "nie rozpoznano wariantu z nazwy zdjęcia";
            }

            RefreshService.RequestRefresh();
        }
    }

    private void DeleteImage()
    {
        ImagesToDelete.Add(ElementName);
        UploadState = true;
        ElementValue.Image = null;
    }
}
