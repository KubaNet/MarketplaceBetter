@using MarketplaceBetter.Domain.Entities.Amazon.APlusContents;
@using MarketplaceBetter.Domain.Model.Amazon.APlusContents;
@using MarketplaceBetter.Domain.Model.Base;
@using MarketplaceBetter.Domain.Model.Catalog.Products;
@using MarketplaceBetter.Domain.Model.Other;
@using MarketplaceBetter.Services.Domain.Amazon.APlusContents.Interfaces;
@using MarketplaceBetter.Services.Domain.Base.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces;
@using MarketplaceBetter.Services.Model;
@using MarketplaceBetter.Services.Specialized.Interfaces;
@using MarketplaceBetter.Services.Validation.Amazon.APlusContents.Interfaces;
@using System.IO;
@using TinyMCE.Blazor;

@inject ISnackbar Snackbar
@inject IAPlusModuleValueService ModuleValueService
@inject IAPlusModuleValueValidator ModuleValueValidator
@inject IAPlusImageCloudService ImageCloudService
@inject IAPlusContentService ContentService
@inject IAPlusModuleService ModuleService
@inject IInstanceService InstanceService
@inject IBrandService BrandService
@inject IProductService ProductService
@inject IUserService UserService

<EditForm Model="ModuleValue" OnValidSubmit="HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title MinWidth="700" FormButtonsDisabled="FormButtonsDisabled" ShowProgressIcon="ShowProgressIcon">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Instance" T="InstanceModel" Value="Instance" For="() => Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" For="() => Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Product" T="ProductModel" Value="Product" For="() => Product" ValueChanged="HandleProductChanged" Disabled="ProductDisabled">
            @foreach (var product in Products)
            {
                <MudSelectItem Value="product">@product.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Content" T="APlusContentModel" Value="ModuleValue.Content" For="() => ModuleValue.Content" ValueChanged="HandleContentChanged">
            @foreach (var content in Contents)
            {
                <MudSelectItem Value="content">@content.Name</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField Label="Order" T="int" @bind-Value="ModuleValue.Order" Variant="Variant.Text" Min="1" Max="Standard.APlusModulesMaxNumber" HideSpinButtons="true" Disabled="OrderDisabled" />
        <MudSelect Label="Type" T="APlusModuleModel" Value="ModuleValue.Module" For="() => ModuleValue.Module" ValueChanged="HandleModuleChanged">
            @foreach (var moduleItem in Modules)
            {
                <MudSelectItem Value="moduleItem">@moduleItem.Name</MudSelectItem>
            }
        </MudSelect>
        @if (ModuleValue.Module != null)
        {
            <MudText Typo="Typo.h6" Class="mt-3">Elements:</MudText>

            @if (ModuleValue.Module.SystemName == APlusModuleEnum.StandardComparisonChart)
            {
                <ComparisonChartForm ModuleValue="ModuleValue" ImagesToAdd="ImagesToAdd" ImagesToDelete="ImagesToDelete" MetricsInfo="MetricsInfo" IsEdit="@(IsEdit || AddingSimilar)" />
            }
            else
            {
                @foreach (var elementValue in ModuleValue.Elements.OrderBy(e => e.Element.Order))
                {
                    if (ModuleValue.Module.SystemName == APlusModuleEnum.StandardTechnicalSpecifications && elementValue.Element.Name.Equals("Number of columns", StringComparison.OrdinalIgnoreCase))
                    {
                        <MudSelect Label="@elementValue.Element.Name" T="string" @bind-Value="elementValue.SingleLineText">
                            <MudSelectItem Value="One">1</MudSelectItem>
                            <MudSelectItem Value="Two">2</MudSelectItem>
                        </MudSelect>

                        continue;
                    }

                    @switch (elementValue.Element.Type.SystemName)
                    {
                        case APlusElementTypeEnum.SingleLineText:
                            <MudTextField Label="@elementValue.Element.Name" @bind-Value="elementValue.SingleLineText" For="() => elementValue.SingleLineText" MaxLength="elementValue.Element.CharactersLimit.Value" />
                            break;
                        case APlusElementTypeEnum.BodyText:
                            <Editor @bind-Value="elementValue.BodyText" Field="() => elementValue.BodyText" Conf="EditorConfiguration" ScriptSrc="/lib/tinymce/tinymce.min.js" ClassName="mt-4" />
                            break;
                        case APlusElementTypeEnum.Image:
                            <APlusImageFormEditor @key="elementValue" ElementValue="elementValue" ImagesToAdd="ImagesToAdd" ImagesToDelete="ImagesToDelete" />
                            break;
                        case APlusElementTypeEnum.TrueOrFalse:
                            <MudCheckBox Label="@elementValue.Element.Name" @bind-Checked="elementValue.TrueOrFalse" TriState="true" For="() => elementValue.TrueOrFalse" />
                            break;
                        default:
                            throw new UnrecognizedEnumValueException<APlusElementTypeEnum>(elementValue.Element.Type.SystemName);
                    }
                }
            }
        }
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool AddingSimilar { get; set; }
    [Parameter] public long ModuleValueId { get; set; }

    private CustomValidation CustomValidation = new();
    private BrandModel Brand;
    private ProductModel Product;
    private InstanceModel Instance;
    private APlusModuleValueModel ModuleValue = new APlusModuleValueModel();
    private IDictionary<string, IBrowserFile> ImagesToAdd = new Dictionary<string, IBrowserFile>();
    private IList<string> ImagesToDelete = new List<string>();
    private MetricsInfoModel MetricsInfo = new MetricsInfoModel();

    private IList<BrandModel> Brands;
    private IList<InstanceModel> Instances;
    private IList<APlusContentModel> Contents;
    private IList<ProductModel> Products = new List<ProductModel>();
    private IList<APlusModuleModel> Modules;

    private bool ProductDisabled = true;
    private bool OrderDisabled = true;
    private bool FormButtonsDisabled = false;
    private bool ShowProgressIcon = false;
    private string One = "1";
    private string Two = "2";

    private Dictionary<string, object> EditorConfiguration = new Dictionary<string, object>{
        { "toolbar", "undo redo | bold italic underline | numlist bullist" },
        { "plugins", "lists" },
        { "menubar", false }
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll(true);
        Instances = InstanceService.GetAllNormal(true);
        Contents = ContentService.GetAll(true);
        Modules = ModuleService.GetAll();

        if (IsEdit || AddingSimilar)
        {
            SetInitialValues();
        }
        else
        {
            if (UserService.IsSpecificBrand())
            {
                SetValuesForCurrentBrand();
            }
            if (UserService.IsSpecificInstance())
            {
                SetValuesForCurrentInstance();
            }
        }
    }

    private void SetInitialValues()
    {
        OrderDisabled = false;

        ModuleValue = ModuleValueService.Get(ModuleValueId);
        if (AddingSimilar)
        {
            ModuleValue.Id = 0;
            ModuleValue.Order++;
        }

        Brand = Brands.Single(b => b.Id == ModuleValue.Content.Product.Brand.Id);
        ActivateProduct(Brand.Id);
        Product = Products.Single(p => p.Id == ModuleValue.Content.Product.Id);
        Instance = Instances.Single(i => i.Id == ModuleValue.Content.Instance.Id);

        ModuleValue.Content = Contents.Single(c => c.Id == ModuleValue.Content.Id);
        ModuleValue.Module = Modules.Single(s => s.Id == ModuleValue.Module.Id);
    }

    private void SetValuesForCurrentBrand()
    {
        BrandModel currentBrand = Brands.Single(b => b.Id == UserService.GetCurrentBrand().Id);

        HandleBrandChanged(currentBrand);
    }

    private void SetValuesForCurrentInstance()
    {
        InstanceModel currentInstance = Instances.Single(i => i.Id == UserService.GetCurrentInstance().Id);

        HandleInstanceChanged(currentInstance);
    }

    private void GetContents()
    {
        ModuleValue.Content = null;
        ModuleValue.Order = 0;
        OrderDisabled = true;
        Contents = ContentService.GetAllFor(Brand, Product, Instance);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetProduct();
        ActivateProduct(brand.Id);

        GetContents();
    }

    private void ResetProduct()
    {
        Product = null;
        ProductDisabled = true;
        Products = new List<ProductModel>();
    }

    private void ActivateProduct(long brandId)
    {
        ProductDisabled = false;
        Products = ProductService.GetAllForBrand(brandId);
    }

    private void HandleProductChanged(ProductModel product)
    {
        Product = product;

        GetContents();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        Instance = instance;

        GetContents();
    }

    private void HandleContentChanged(APlusContentModel content)
    {
        ModuleValue.Content = content;

        OrderDisabled = false;
        ModuleValue.Order = ModuleValueService.GetNextOrder(content.Id);
    }

    private void HandleModuleChanged(APlusModuleModel module)
    {
        ModuleValue.Module = module;

        UpdateElements(module);
    }

    private void UpdateElements(APlusModuleModel module)
    {
        ModuleValue.Elements.Clear();
        ImagesToAdd.Clear();

        foreach (var element in module.Elements)
        {
            APlusElementValueModel elementValue = new() { Element = element };
            if (element.Type.SystemName == APlusElementTypeEnum.BodyText)
            {
                elementValue.BodyText = element.Name;
            }

            if (module.SystemName == APlusModuleEnum.StandardTechnicalSpecifications && element.Name.Equals("Number of columns", StringComparison.OrdinalIgnoreCase))
            {
                elementValue.SingleLineText = "1";
            }

            ModuleValue.Elements.Add(elementValue);
        }
    }

    private async void HandleValidSubmit()
    {
         ValidationResult result = ModuleValueValidator.Validate(ModuleValue, MetricsInfo.MetricsCount);

        if (result.IsValid)
        {
            FormButtonsDisabled = true;
            ShowProgressIcon = true;

            foreach (var image in ImagesToAdd)
            {
                MemoryStream imageStream = new MemoryStream();
                await image.Value.OpenReadStream(Standard.UploadPhotoSizeLimit).CopyToAsync(imageStream);
                imageStream.Seek(0, SeekOrigin.Begin);

                APlusElementValueModel elementValue = ModuleValue.Elements.Single(e => e.Element.Name == image.Key);

                string extension = image.Value.Name.Substring(image.Value.Name.LastIndexOf('.') + 1);
                string shortName = $"{ModuleValue.Order}_{ModuleValue.Module.Name.Replace("&", string.Empty).WithoutSpaces()}_{elementValue.Element.Name.WithoutSpaces()}.{extension}";
                string fullName = $"{ModuleValue.Content.Name.WithoutSpaces()}/{shortName}";

                APlusImageUploadResult uploadResult = ImageCloudService.Upload(imageStream, fullName);

                elementValue.Image = new APlusImageModel
                    {
                        CloudId = uploadResult.CloudId,
                        Version = uploadResult.Version,
                        Url = uploadResult.Url,
                        FileName = shortName
                    };
            }

            if (IsEdit)
            {
                ModuleValueService.Update(ModuleValue, ImagesToDelete);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("A+ Module"));
            }
            else
            {
                ModuleValueService.Add(ModuleValue);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("A+ Module"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}