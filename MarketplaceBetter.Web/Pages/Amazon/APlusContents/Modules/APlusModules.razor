@using MarketplaceBetter.Domain.Entities.Amazon.APlusContents;
@using MarketplaceBetter.Domain.Model.Amazon.APlusContents;
@using MarketplaceBetter.Services.Domain.Amazon.APlusContents.Interfaces;
@using MarketplaceBetter.Services.Model;

@page "/a-plus-modules"
<PageTitle>A+ Modules</PageTitle>

@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IAPlusModuleValueService ModuleValueService

<MudText Typo="Typo.h4" Class="mt-2">A+ Modules</MudText>

<MainBody>
    <MudTable T="APlusModuleValueModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<APlusModuleValueModel>>>(Reload))" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="Add" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Module</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="APlusModuleValueModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="content" T="APlusModuleValueModel">Content</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="product" T="APlusModuleValueModel">Product</MudTableSortLabel></MudTh>
            <MudTh>Variant</MudTh>
            <MudTh><MudTableSortLabel SortLabel="name" T="APlusModuleValueModel">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="elements" T="APlusModuleValueModel">Elements</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="order" T="APlusModuleValueModel">Order</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="APlusContentModel">Instance</MudTableSortLabel></MudTh>
            <MudTh Style="width: 250px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Content">@context.Content.Name</MudTd>
            <MudTd DataLabel="Product">@context.Content.Product.Code</MudTd>
            <MudTd DataLabel="Variant"><APlusContentVariantsDisplay Variants="@context.Content.Variants.Select(v => v.Variant).OrderBy(v => v.Sku).ToList()" /></MudTd>
            <MudTd DataLabel="Name">@context.Module.Name</MudTd>
            <MudTd DataLabel="Elements">
                @if (context.Module.SystemName == APlusModuleEnum.StandardComparisonChart)
                {
                    <span @onclick="() => ShowComparisonChart(context)" class="ml-3" style="color: @(BetterTheme.PaletteLight.Primary); font-weight: bold; cursor: pointer;">.. show elements ..</span>
                }
                else
                {
                    <APlusElementsDisplay Elements="context.Elements" />
                }
            </MudTd>
            <MudTd DataLabel="Order">@context.Order</MudTd>
            <MudTd DataLabel="Instance">@context.Content.Instance.Name</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context))">Delete</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" OnClick="@(() => AddSimilar(context.Id))">Add</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" OnClick="@(() => Edit(context.Id))">Edit</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [CascadingParameter] private MudTheme BetterTheme { get; set; }
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }
    [Parameter][SupplyParameterFromQuery] public string ContentName { get; set; }
    [Parameter][SupplyParameterFromQuery] public string VariantSku { get; set; }

    private MudTable<APlusModuleValueModel> Table;
    private ListRequest ListRequest = new();

    private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
        if (!String.IsNullOrWhiteSpace(VariantSku))
        {
            ListRequest.SearchString = $"variant: {VariantSku}";
        }
        else if (!String.IsNullOrWhiteSpace(ContentName))
        {
            ListRequest.SearchString = $"content: {ContentName}";
        }
    }

    private Task<TableData<APlusModuleValueModel>> Reload(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<APlusModuleValueModel> module = ModuleValueService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<APlusModuleValueModel>() { TotalItems = ModuleValueService.CountForListRequest(ListRequest), Items = module });
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        CurrentRowsPerPageValue = rowsPerPage;
    }

    private void Filter(string searchString)
    {
        ListRequest.SearchString = searchString;

        string newUrl = Navigation.GetUriWithQueryParameter(Standard.SearchQueryParamater, String.IsNullOrWhiteSpace(searchString) ? null : searchString);
        Navigation.NavigateTo(newUrl, replace: true);

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void Add()
    {
        DialogOptions options = new DialogOptions() { BackdropClick = false };

        DialogResult result = await DialogService.Show<APlusModuleDialog>(null, new DialogParameters { ["Title"] = "Add A+ Module" }, options).Result;

        ProcessDialogResult(result);
    }

    private async void AddSimilar(long id)
    {
        DialogOptions options = new DialogOptions() { BackdropClick = false };

        DialogResult result = await DialogService.Show<APlusModuleDialog>(null, new DialogParameters { ["Title"] = "Add A+ Module", ["AddingSimilar"] = true, ["ModuleValueId"] = id }, options).Result;

        ProcessDialogResult(result);
    }

    private async void Edit(long id)
    {
        DialogOptions options = new DialogOptions() { BackdropClick = false };

        DialogResult result = await DialogService.Show<APlusModuleDialog>(null, new DialogParameters { ["Title"] = "Edit A+ Module", ["IsEdit"] = true, ["ModuleValueId"] = id }, options).Result;

        ProcessDialogResult(result);
    }

    private async void Delete(APlusModuleValueModel moduleValue)
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = $"Are you sure you want to delete module <b>{moduleValue.Module.Name}</b> for content <b>{moduleValue.Content.Name}</b> ?" }).Result;

        if (!result.Canceled)
        {
            ModuleValueService.Delete(moduleValue.Id);

            await Table.ReloadServerData();

            Snackbar.AddSuccess(OperationMessages.SuccessfullyDeleted("Module"));
        }
    }

    private void ProcessDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }

    private async void ShowComparisonChart(APlusModuleValueModel module)
    {
        DialogOptions options = new DialogOptions() { CloseButton = true };

        await DialogService.Show<ComparisonChartDisplay>(null, new DialogParameters { ["Module"] = module }, options).Result;
    }
}
