@using MarketplaceBetter.Domain.Model.Amazon.APlusContents;
@using MarketplaceBetter.Services.Domain.Amazon.APlusContents.Interfaces;
@using MarketplaceBetter.Services.Specialized.Interfaces;

@inject IAPlusImageCloudService ImageCloudService
@inject IAPlusModuleValueService ModuleService

<MudDialog Style="min-width: 1800px;">
    <TitleContent>
        <MudText Typo="Typo.h6" Inline="true">@Module.Module.Name - @Module.Content.Name</MudText>
        <span class="ml-2">Module @(Index + 1) / @ProductModules.Count</span>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.NavigateBefore" Color="Color.Default" Disabled="ProductModules.Count < 2" Class="ml-16 mr-4" OnClick="Previous">previous</MudButton>
        <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.NavigateNext" Color="Color.Default" Disabled="ProductModules.Count < 2" Class="mr-4" OnClick="Next">next</MudButton>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-grow-1">
            <div class="d-flex mr-4" style="min-width: 200px;">
            </div>
            <div class="d-flex flex-auto">
                <MudGrid>
                    @for (int i = 1; i <= 6; i++)
                    {
                        int index = i;
                        APlusElementValueModel imageElement = ProductsElements.Single(e => e.Element.Name.Equals($"Image (product {index})"));
                        APlusElementValueModel highlightElement = ProductsElements.Single(e => e.Element.Name.Equals($"Highlight Column (product {index})"));
                        <MudItem xs="2">
                            <MudText Typo="Typo.subtitle1" Align="Align.Center">Product @index</MudText>
                            <MudCheckBox Label="Highlight Column" Checked="highlightElement.TrueOrFalse" ReadOnly="true" />
                            @if (imageElement.Image != null)
                            {
                                <MudTooltip Placement="Placement.Right">
                                    <ChildContent>
                                        <MudLink Typo="Typo.body2" Href="@ImageCloudService.GetOriginalUrl(imageElement.Image.CloudId, imageElement.Image.Version)" Target="_blank">
                                            <MudImage Src="@ImageCloudService.GetSmallerUrlForDisplay(imageElement.Image.CloudId, imageElement.Image.Version)" />
                                        </MudLink>
                                    </ChildContent>
                                    <TooltipContent>Click to open in new window</TooltipContent>
                                </MudTooltip>
                            }
                        </MudItem>
                    }

                    @for (int i = 1; i <= 6; i++)
                    {
                        int index = i;
                        APlusElementValueModel keywordsElement = ProductsElements.Single(e => e.Element.Name.Equals($"Image Keywords (product {index})"));
                        APlusElementValueModel titleElement = ProductsElements.Single(e => e.Element.Name.Equals($"Title (product {index})"));
                        APlusElementValueModel asinElement = ProductsElements.Single(e => e.Element.Name.Equals($"ASIN (product {index})"));
                        <MudItem xs="2">
                            <MudTextField Label="Image Keywords" Value="keywordsElement.SingleLineText" ReadOnly="true" />
                            <MudTextField Label="Title" Value="titleElement.SingleLineText" ReadOnly="true" />
                            <MudTextField Label="ASIN" Value="asinElement.SingleLineText" ReadOnly="true" />
                        </MudItem>
                    }
                </MudGrid>
            </div>
        </div>
        <div class="mt-10"></div>
        @for (int i = 1; i <= 10; i++)
        {
            int metricIndex = i;
            APlusElementValueModel metricElement = MetricsElements.Single(e => e.Element.Name.Equals($"Metric {metricIndex}"));
            <div class="d-flex flex-grow-1">
                <div class="d-flex mr-4" style="min-width: 200px;">
                    <MudTextField Label="@String.Concat("Metric ", metricIndex)" Value="metricElement.SingleLineText" ReadOnly="true" />
                </div>
                <div class="d-flex flex-auto">
                    <MudGrid>
                        @for (int j = 1; j <= 6; j++)
                        {
                            int productIndex = j;
                            APlusElementValueModel productMetricCheckboxElement = ProductsMetricsElements.Single(e => e.Element.Name.Equals($"Checked? (metric {metricIndex}, product {productIndex})"));
                            APlusElementValueModel productMetricTextElement = ProductsMetricsElements.Single(e => e.Element.Name.Equals($"Text (metric {metricIndex}, product {productIndex})"));
                            <MudItem xs="2">
                                @if (productMetricCheckboxElement.TrueOrFalse.HasValue)
                                {
                                    <div class="d-flex flex-grow">
                                        <div class="d-flex flex-1"></div>
                                        <div class="d-flex"><MudCheckBox Checked="productMetricCheckboxElement.TrueOrFalse" ReadOnly="true" /></div>
                                        <div class="d-flex flex-1"></div>
                                    </div>
                                }
                                else
                                {
                                    <MudTextField Label="Text" Value="productMetricTextElement.SingleLineText" ReadOnly="true" />
                                }
                            </MudItem>
                        }
                    </MudGrid>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public APlusModuleValueModel Module { get; set; }

    private IList<APlusElementValueModel> MetricsElements;
    private IList<APlusElementValueModel> ProductsElements;
    private IList<APlusElementValueModel> ProductsMetricsElements;

    private IList<APlusModuleValueModel> ProductModules { get; set; }
    private int Index;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        InitializeElements(Module);

        ProductModules = ModuleService.GetAllChartsForProduct(Module.Content.Product.Id, Module.Order);

        Index = ProductModules.IndexOf(ProductModules.Single(m => m.Content.Name == Module.Content.Name && m.Order == Module.Order));
    }

    private void InitializeElements(APlusModuleValueModel module)
    {
        Module = module;
        MetricsElements = module.Elements.Where(e => e.Element.Name.StartsWith("Metric")).OrderBy(e => e.Element.Order).ToList();
        ProductsElements = module.Elements.Where(e => !e.Element.Name.StartsWith("Metric") && !e.Element.Name.StartsWith("Checked?") && !e.Element.Name.StartsWith("Text")).OrderBy(e => e.Element.Order).ToList();
        ProductsMetricsElements = module.Elements.Where(e => e.Element.Name.StartsWith("Checked?") || e.Element.Name.StartsWith("Text")).OrderBy(e => e.Element.Order).ToList();
    }

    private void Previous()
    {
        Index--;
        if (Index < 0)
        {
            Index = ProductModules.Count - 1;
        }

        InitializeElements(ProductModules[Index]);
        MudDialog.StateHasChanged();
    }

    private void Next()
    {
        Index++;
        if (Index >= ProductModules.Count)
        {
            Index = 0;
        }

        InitializeElements(ProductModules[Index]);
        MudDialog.StateHasChanged();
    }

    private void Close() => MudDialog.Cancel();
}