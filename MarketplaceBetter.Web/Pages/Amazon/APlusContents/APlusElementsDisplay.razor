@using MarketplaceBetter.Domain.Entities.Amazon.APlusContents;
@using MarketplaceBetter.Domain.Model.Amazon.APlusContents;
@using MarketplaceBetter.Services.Specialized.Interfaces

@inject IAPlusImageCloudService ImageCloudService
@inject IJSRuntime JS

@foreach (var elementValue in Elements)
{
    bool hasValue = !string.IsNullOrWhiteSpace(elementValue.SingleLineText) || !string.IsNullOrWhiteSpace(elementValue.BodyText)
        || elementValue.Image != null || elementValue.TrueOrFalse.HasValue;

    if (!hasValue)
    {
        continue;
    }

    string elementName = elementValue.Element.Name;

    switch (elementValue.Element.Type.SystemName)
    {
        case APlusElementTypeEnum.SingleLineText:
            <div>
                <MudTooltip Placement="Placement.Right">
                    <ChildContent><span @onclick="() => CopyElement(elementName)" @onmouseenter="() => ShowElement(elementName)" @onmouseleave="() => HideElement(elementName)" class="ml-3" style="color: @(BetterTheme.PaletteLight.Primary); font-weight: bold; cursor: pointer;">@elementValue.Element.Name</span></ChildContent>
                    <TooltipContent>Click to copy</TooltipContent>
                </MudTooltip>
                <MudPopover Class="pa-4" Open="OpenInfo[elementName]" AnchorOrigin="Origin.CenterLeft" TransformOrigin="Origin.CenterRight">
                    <span>@elementValue.SingleLineText</span>
                </MudPopover>
            </div>
            break;
        case APlusElementTypeEnum.BodyText:
            <div>
                <MudTooltip Placement="Placement.Right">
                    <ChildContent><span @onclick="() => CopyElement(elementName)" @onmouseenter="() => ShowElement(elementName)" @onmouseleave="() => HideElement(elementName)" class="ml-3" style="color: @(BetterTheme.PaletteLight.Primary); font-weight: bold; cursor: pointer;">@elementValue.Element.Name</span></ChildContent>
                    <TooltipContent>Click to copy</TooltipContent>
                </MudTooltip>
                <MudPopover Class="pa-4" Open="OpenInfo[elementName]" AnchorOrigin="Origin.CenterLeft" TransformOrigin="Origin.CenterRight">
                    <div id="BodyText_@(elementName.Replace(' ', '_'))" class="body-text-display">
                        @((MarkupString)elementValue.BodyText)
                    </div>
                </MudPopover>
            </div>
            break;
        case APlusElementTypeEnum.Image:
            <div>
                <MudTooltip Placement="Placement.Right">
                    <ChildContent>
                        <MudLink Typo="Typo.body2" Href="@ImageCloudService.GetOriginalUrl(elementValue.Image.CloudId, elementValue.Image.Version)" Target="_blank" @onmouseenter="() => ShowElement(elementName)" @onmouseleave="() => HideElement(elementName)" Class="ml-3" Style="font-weight: bold; text-decoration: none;">
                            @elementValue.Element.Name
                        </MudLink>
                    </ChildContent>
                    <TooltipContent>Click to open in new window</TooltipContent>
                </MudTooltip>
                <MudPopover Open="OpenInfo[elementName]" AnchorOrigin="Origin.CenterLeft" TransformOrigin="Origin.CenterRight">
                    <MudImage Src="@ImageCloudService.GetBiggerUrlForLists(elementValue.Image.CloudId, elementValue.Image.Version)" />
                </MudPopover>
            </div>
            break;
        case APlusElementTypeEnum.TrueOrFalse:
            <div>
                <span @onmouseenter="() => ShowElement(elementName)" @onmouseleave="() => HideElement(elementName)" class="ml-3" style="color: @(BetterTheme.PaletteLight.Primary); font-weight: bold; cursor: pointer;">@elementValue.Element.Name</span>
                <MudPopover Class="pa-4" Open="OpenInfo[elementName]" AnchorOrigin="Origin.CenterLeft" TransformOrigin="Origin.CenterRight">
                    @if (elementValue.TrueOrFalse.Value)
                    {
                        <span>Yes (checked)</span>
                    }
                    else
                    {
                        <span>No (unchecked)</span>
                    }
                </MudPopover>
            </div>
            break;
        default:
            throw new UnrecognizedEnumValueException<APlusElementTypeEnum>(elementValue.Element.Type.SystemName);
    }
}

@code {
    [CascadingParameter] private MudTheme BetterTheme { get; set; }
    [Parameter] public IList<APlusElementValueModel> Elements { get; set; }

    private IDictionary<string, bool> OpenInfo = new Dictionary<string, bool>();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        foreach (var elementValue in Elements)
        {
            OpenInfo.Add(elementValue.Element.Name, false);
        }
    }

    private void ShowElement(string elementName)
    {
        OpenInfo[elementName] = true;
    }

    private void HideElement(string elementName)
    {
        OpenInfo[elementName] = false;
    }

    private async void CopyElement(string elementName)
    {
        APlusElementValueModel elementValue = Elements.Single(e => e.Element.Name == elementName);
        switch (elementValue.Element.Type.SystemName)
        {
            case APlusElementTypeEnum.SingleLineText:
                await JS.InvokeVoidAsync("CopyTextToClipboard", elementValue.SingleLineText);
                break;
            case APlusElementTypeEnum.BodyText:
                await JS.InvokeVoidAsync("CopyRichTextToClipboard", $"BodyText_{elementValue.Element.Name.Replace(' ', '_')}");
                break;
            default:
                throw new UnrecognizedEnumValueException<APlusElementTypeEnum>(elementValue.Element.Type.SystemName);
        }
    }
}
