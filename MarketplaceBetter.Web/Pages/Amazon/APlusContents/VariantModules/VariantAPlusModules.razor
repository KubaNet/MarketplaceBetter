@using MarketplaceBetter.Domain.Model.Amazon.APlusContents;
@using MarketplaceBetter.Services.Domain.Amazon.APlusContents.Interfaces;
@using MarketplaceBetter.Services.Model;

@page "/variant-a-plus-modules"
@inject ISnackbar Snackbar
@inject IAPlusVariantModulesService VariantModulesService
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mt-2">Variant A+ Modules</MudText>

<MainBody>
    <MudTable T="APlusVariantModulesModel" @ref="Table" ServerData="@(new Func<TableState, Task<TableData<APlusVariantModulesModel>>>(Reload))" MultiSelection="true" SelectedItemsChanged="OnSelectedItemsChanged" Dense="true" Hover="true" RowsPerPage=CurrentRowsPerPageValue RowsPerPageChanged="OnRowsPerPageChanged">
        <ToolBarContent>
            <MudTextField Value="ListRequest.SearchString" Placeholder="Search" T="string" ValueChanged="Filter" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="ChangeStatusOfSelected" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PublishedWithChanges" Color="Color.Info" Disabled="NoneSelected" Class="ml-2">Change Status</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="content" T="APlusVariantModulesModel">Content</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="status" T="APlusVariantModulesModel">Status</MudTableSortLabel></MudTh>
            <MudTh>Variant</MudTh>
            <MudTh><MudTableSortLabel SortLabel="instance" T="APlusVariantModulesModel">Instance</MudTableSortLabel></MudTh>
            @for (int i = 1; i <= 8; i++)
            {
                int index = i;
                <MudTh>Module @index</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Content">
                <MudLink Href="@(string.Concat("a-plus-modules?ContentName=", context.Content.Name))" Style="text-decoration: none;">@context.Content.Name</MudLink>
            </MudTd>
            <MudTd DataLabel="Status"><EntityStatusDisplay Status="@context.Content.Status" /></MudTd>
            <MudTd DataLabel="Variant">
                @if (context.Content.AllVariants)
                {
                    <span>All variants</span>
                }
                else
                {
                    <APlusContentVariantsDisplay Variants="@context.Variants.OrderBy(v => v.Sku).ToList()" />
                }
            </MudTd>
            <MudTd DataLabel="Instance">@context.Content.Instance.Name</MudTd>
            @for (int i = 1; i <= 8; i++)
            {
                int index = i;
                <MudTd>
                    @if (context.Modules.Any(m => m.Order == index))
                    {
                        APlusModuleValueModel module = context.Modules.Single(m => m.Order == index);

                        <span>@module.Module.Name</span>
                        <APlusElementsDisplay Elements="module.Elements" />
                    }
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            @if (!ShowAll.HasValue || ShowAll == false)
            {
                <MudTablePager PageSizeOptions="new int[] { Standard.SmallestRowsPerPage, Standard.MediumRowsPerPage, Standard.LargestRowsPerPage }" />
            }
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    [Parameter][SupplyParameterFromQuery] public string SearchString { get; set; }
    [Parameter][SupplyParameterFromQuery] public long? ProductId { get; set; }
    [Parameter][SupplyParameterFromQuery] public bool? ShowAll { get; set; }

    private MudTable<APlusVariantModulesModel> Table;
    private ListRequest ListRequest = new();

    private HashSet<APlusVariantModulesModel> SelectedVariantModules = new HashSet<APlusVariantModulesModel>();
    private bool NoneSelected = true;
    private int CurrentRowsPerPageValue = Standard.InitialRowsPerPage;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProcessQueryParameters();
    }

    private void ProcessQueryParameters()
    {
        if (!String.IsNullOrWhiteSpace(SearchString))
        {
            ListRequest.SearchString = SearchString;
        }
        if (ProductId.HasValue)
        {
            ListRequest.SearchString = $"product_id: {ProductId.Value}";
        }
        if (ShowAll.HasValue)
        {
            ListRequest.ShowAll = ShowAll.Value;
        }
    }

    private Task<TableData<APlusVariantModulesModel>> Reload(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<APlusVariantModulesModel> variantModules = VariantModulesService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<APlusVariantModulesModel>() { TotalItems = VariantModulesService.CountForListRequest(ListRequest), Items = variantModules });
    }

    private void OnRowsPerPageChanged(int rowsPerPage)
    {
        CurrentRowsPerPageValue = rowsPerPage;
    }

    private void Filter(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private void ProcessDialogResult(DialogResult result)
    {
        if (!result.Canceled)
        {
            Table.ReloadServerData();
        }
    }

    private async void ChangeStatusOfSelected()
    {
        var result = await DialogService.Show<APlusContentsSetStatusDialog>(null, new DialogParameters { ["Contents"] = SelectedVariantModules.Select(m => m.Content).ToList() }).Result;

        ProcessDialogResult(result);
    }

    private void OnSelectedItemsChanged(HashSet<APlusVariantModulesModel> selectedVariantModules)
    {
        SelectedVariantModules = selectedVariantModules;

        if (SelectedVariantModules.Any())
        {
            NoneSelected = false;
        }
        else
        {
            NoneSelected = true;
        }
    }
}
