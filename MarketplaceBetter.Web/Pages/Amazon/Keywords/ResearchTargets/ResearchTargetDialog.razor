@using MarketplaceBetter.Domain.Model.Amazon.Keywords
@using MarketplaceBetter.Services.Domain.Amazon.Keywords.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Keywords.Interfaces

@inject IResearchTargetService ResearchTargetService
@inject IResearchTargetValidator ResearchTargetValidator
@inject IResearchService ResearchService
@inject ISnackbar Snackbar

<EditForm Model="ResearchTarget" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudSelect Label="Research" T="ResearchModel" @bind-Value="ResearchTarget.Research" For="() => ResearchTarget.Research">
            @foreach (var research in Researches)
            {
                <MudSelectItem Value="research">@($"{research.Name} ({research.Instance.ShortName})")</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="Name" @bind-Value="ResearchTarget.Name" For="() => ResearchTarget.Name" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long ResearchTargetId { get; set; }

    private CustomValidation CustomValidation = new();
    private ResearchTargetModel ResearchTarget = new();
    private IList<ResearchModel> Researches = new List<ResearchModel>();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Researches = ResearchService.GetAll();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        ResearchTarget = ResearchTargetService.Get(ResearchTargetId);
        ResearchTarget.Research = Researches.Single(r => r.Id == ResearchTarget.Research.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ResearchTargetValidator.Validate(ResearchTarget);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ResearchTargetService.Update(ResearchTarget);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Research Target"));
            }
            else
            {
                ResearchTargetService.Add(ResearchTarget);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Research Target"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}