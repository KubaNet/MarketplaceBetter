@using MarketplaceBetter.Domain.Model.Amazon.Keywords
@using MarketplaceBetter.Services.Domain.Amazon.Keywords.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Keywords.Interfaces
@using System.IO

@inject IResearchTargetOperationsService ResearchTargetOperationsService
@inject IResearchService ResearchService
@inject ISnackbar Snackbar

<EditForm Model="AddTargetsModel" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title="Add Research Targets from file">
        <DataAnnotationsValidator />
        <MudSelect Label="Research" T="ResearchModel" @bind-Value="AddTargetsModel.Research" For="() => AddTargetsModel.Research">
            @foreach (var research in Researches)
            {
                <MudSelectItem Value="research">@research.Name</MudSelectItem>
            }
        </MudSelect>
        <InputFile id="FileInput" OnChange="UploadFile" hidden />
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Filled.CloudUpload" for="FileInput" Class="mt-4">
            Upload File
        </MudButton>
        @if (File != null)
        {
            <MudList>
                <MudListItem Icon="@Icons.Filled.AttachFile">
                    @File.Name <code>@File.Size bytes</code>
                </MudListItem>
            </MudList>
        }
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }

    private CustomValidation CustomValidation = new();
    private IList<ResearchModel> Researches = new List<ResearchModel>();
    private AddAdvertisingReportResearchTargetsModel AddTargetsModel = new ();
    private IBrowserFile File;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Researches = ResearchService.GetAll();
    }

    private void UploadFile(InputFileChangeEventArgs e)
    {
        File = e.File;
    }

    private async void HandleValidSubmit()
    {
        MemoryStream memoryStream = new MemoryStream();
        await File.OpenReadStream(maxAllowedSize:100000000).CopyToAsync(memoryStream);
        memoryStream.Seek(0, SeekOrigin.Begin);

        AddAdvertisingReportResearchTargetsModel model = ResearchTargetOperationsService.CreateTargetsFromAdvertisingReport(AddTargetsModel.Research, memoryStream);

        MudDialog.Close(model);
    }
}