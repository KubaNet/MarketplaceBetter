@using MarketplaceBetter.Domain.Model.Amazon.Keywords
@using MarketplaceBetter.Services.Domain.Amazon.Keywords.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Keywords.Interfaces
@using System.IO

@inject IResearchService ResearchService
@inject IResearchTargetService ResearchTargetService
@inject IResearchTargetSourceService ResearchTargetSourceService
@inject ISnackbar Snackbar

<EditForm Model="AddTargetsModel" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title="Add Research Targets from file">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Research" T="ResearchModel" @bind-Value="AddTargetsModel.Research" For="() => AddTargetsModel.Research">
            @foreach (var research in Researches)
            {
                <MudSelectItem Value="research">@($"{research.Name} ({research.Instance.Name})")</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Source" T="ResearchTargetSourceModel" @bind-Value="AddTargetsModel.Source" For="() => AddTargetsModel.Source">
            @foreach (var source in Sources)
            {
                <MudSelectItem Value="source">@source.Name</MudSelectItem>
            }
        </MudSelect>
        <InputFile id="FileInput" OnChange="UploadFile" hidden />
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" for="FileInput" Class="mt-4">
            Upload File
        </MudButton>
        @if (File != null)
        {
            <MudList>
                <MudListItem Icon="@Icons.Material.Filled.AttachFile">
                    @File.Name <code>@File.Size bytes</code>
                </MudListItem>
            </MudList>
        }
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }

    private CustomValidation CustomValidation = new();
    private IList<ResearchModel> Researches = new List<ResearchModel>();
    private IList<ResearchTargetSourceModel> Sources = new List<ResearchTargetSourceModel>();
    private AddResearchTargetsModel AddTargetsModel = new();
    private IBrowserFile File;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Researches = ResearchService.GetAll();
        Sources = ResearchTargetSourceService.GetAll();
    }

    private void UploadFile(InputFileChangeEventArgs e)
    {
        File = e.File;
    }

    private async void HandleValidSubmit()
    {
        ValidationResult validationResult = new();

        if (File == null)
        {
            validationResult = new ValidationResult();
            validationResult.AddError("Please upload a file");
        }

        if (validationResult.IsValid)
        {
            MemoryStream memoryStream = new MemoryStream();
            await File.OpenReadStream(maxAllowedSize: 100000000).CopyToAsync(memoryStream);
            memoryStream.Seek(0, SeekOrigin.Begin);

            ResearchTargetService.AddFromFile(memoryStream, AddTargetsModel);

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(validationResult.Errors);
        }
    }
}