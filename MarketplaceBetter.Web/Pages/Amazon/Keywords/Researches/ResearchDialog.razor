@using MarketplaceBetter.Domain.Model.Amazon.Keywords
@using MarketplaceBetter.Services.Domain.Amazon.Keywords.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Keywords.Interfaces

@inject IResearchService ResearchService
@inject IResearchValidator ResearchValidator
@inject ISnackbar Snackbar

<EditForm Model="Research" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <MudTextField Label="Name" @bind-Value="Research.Name" For="() => Research.Name" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long ResearchId { get; set; }

    private CustomValidation CustomValidation = new();
    private ResearchModel Research = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        Research = ResearchService.Get(ResearchId);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = ResearchValidator.Validate(Research);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                ResearchService.Update(Research);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Research"));
            }
            else
            {
                ResearchService.Add(Research);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Research"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}