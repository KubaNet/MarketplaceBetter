@using MarketplaceBetter.Domain.Model.Amazon.Keywords
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces
@using MarketplaceBetter.Services.Domain.Amazon.Keywords.Interfaces
@using MarketplaceBetter.Services.Model

@page "/keywordresearchtargets"
@inject IKeywordTargetService KeywordResearchTargetService
@inject IDialogService DialogService

<MudText Typo="Typo.h3" Class="mt-2">Research Targets</MudText>

<MainBody>
    <MudTable @ref="Table" ServerData="@(new Func<TableState, Task<TableData<KeywordTargetModel>>>(ReloadKeywordResearchTarget))" Dense="true" Hover="true" RowsPerPage="15">
        <ToolBarContent>
            <MudTextField Placeholder="Search" T="string" ValueChanged="FilterKeywordResearchTarget" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudButton OnClick="AddFromFile" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add from file</MudButton>
            <MudButton OnClick="AddResearchTarget" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="ml-2">Add Research Target</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="id" T="KeywordTargetModel">Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="name" T="KeywordTargetModel">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="research" T="KeywordTargetModel">Research</MudTableSortLabel></MudTh>
            <MudTh Style="width: 100px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Research">@context.Research.Name</MudTd>
            <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => EditKeywordResearchTarget(context.Id))">Edit</MudButton></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MainBody>

@code {
    private MudTable<KeywordTargetModel> Table;
    private ListRequest ListRequest = new();

    private Task<TableData<KeywordTargetModel>> ReloadKeywordResearchTarget(TableState state)
    {
        state.PopulateListRequest(ListRequest);

        IList<KeywordTargetModel> parents = KeywordResearchTargetService.GetForListRequest(ListRequest);

        return Task.FromResult(new TableData<KeywordTargetModel>() { TotalItems = KeywordResearchTargetService.CountForListRequest(ListRequest), Items = parents });
    }

    private void FilterKeywordResearchTarget(string searchString)
    {
        ListRequest.SearchString = searchString;

        Table.ReloadServerData();

        StateHasChanged();
    }

    private async void AddFromFile()
    {
        var result = await DialogService.Show<KeywordResearchTargetFromFileDialog>().Result;

        if (!result.Cancelled)
        {
            AddAdvertisingReportKeywordTargetsModel fromAdvertisingReportModel = (AddAdvertisingReportKeywordTargetsModel)result.Data;

            //var fromAdvertisingReportDialogResult = await DialogService.Show<KeywordResearchTargetsFromAdvertisingReportDialog>(null, new DialogOptions { FullScreen = true }).Result;

            //if (!fromAdvertisingReportDialogResult.Cancelled)
            //{
            //    Table.ReloadServerData();
            //}
        }
    }

    private async void AddResearchTarget()
    {
        var result = await DialogService.Show<KeywordResearchTargetDialog>(null, new DialogParameters { ["Title"] = "Add Research Target" }).Result;

        ProcessKeywordResearchTargetDialogResult(result);
    }

    private async void EditKeywordResearchTarget(long id)
    {
        var result = await DialogService.Show<KeywordResearchTargetDialog>(null, new DialogParameters { ["Title"] = "Edit Research Target", ["IsEdit"] = true, ["KeywordResearchTargetId"] = id }).Result;

        ProcessKeywordResearchTargetDialogResult(result);
    }

    private void ProcessKeywordResearchTargetDialogResult(DialogResult result)
    {
        if (!result.Cancelled)
        {
            Table.ReloadServerData();
        }
    }
}
