@using MarketplaceBetter.Domain.Entities.Sales
@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Domain.Model.Catalog
@using MarketplaceBetter.Domain.Model.Sales
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces
@using MarketplaceBetter.Services.Domain.Catalog.Interfaces
@using MarketplaceBetter.Services.Domain.Sales.Interfaces
@using MarketplaceBetter.Services.Validation.Amazon.Interfaces

@inject IAmazonChildInstanceService AmazonChildInstanceService
@inject IAmazonChildInstanceValidator AmazonChildInstanceValidator
@inject IBrandService BrandService
@inject IAmazonParentService ParentService
@inject IAmazonChildService ChildService
@inject IInstanceService InstanceService
@inject ISnackbar Snackbar

<EditForm Model="AmazonChildInstance" OnValidSubmit="@HandleValidSubmit">
    <CustomValidation @ref="CustomValidation" />
    <FormDialog Title=@Title>
        <DataAnnotationsValidator />
        <ValidationSummary />
        <MudSelect Label="Brand" T="BrandModel" Value="Brand" ValueChanged="HandleBrandChanged">
            @foreach (var brand in Brands)
            {
                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Parent" T="AmazonParentModel" Value="Parent" ValueChanged="HandleParentChanged" Disabled="ParentSelectDisabled">
            @foreach (var parent in Parents)
            {
                <MudSelectItem Value="parent">@parent.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Child" T="AmazonChildModel" Value="AmazonChildInstance.Child" For="() => AmazonChildInstance.Child" ValueChanged="HandleChildChanged" Disabled="ChildSelectDisabled">
            @foreach (var parent in Childs)
            {
                <MudSelectItem Value="parent">@parent.Sku</MudSelectItem>
            }
        </MudSelect>
        <MudSelect Label="Instance" T="InstanceModel" Value="AmazonChildInstance.Instance" For="() => AmazonChildInstance.Instance" ValueChanged="HandleInstanceChanged">
            @foreach (var instance in Instances)
            {
                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField Label="SKU" @bind-Value="AmazonChildInstance.Sku" For="() => AmazonChildInstance.Sku" />
    </FormDialog>
</EditForm>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public long AmazonChildInstanceId { get; set; }

    private CustomValidation CustomValidation = new();
    private AmazonChildInstanceModel AmazonChildInstance = new();
    private BrandModel Brand;
    private AmazonParentModel Parent;

    private IList<BrandModel> Brands;
    private IList<AmazonParentModel> Parents = new List<AmazonParentModel>();
    private IList<InstanceModel> Instances;
    private IList<AmazonChildModel> Childs = new List<AmazonChildModel>();

    private bool ParentSelectDisabled = true;
    private bool ChildSelectDisabled = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Brands = BrandService.GetAll();
        Instances = InstanceService.GetAllForAmazon();

        if (IsEdit)
        {
            SetInitialValues();
        }
    }

    private void SetInitialValues()
    {
        AmazonChildInstance = AmazonChildInstanceService.Get(AmazonChildInstanceId);

        ActivateParent(AmazonChildInstance.Child.Parent.Product.Brand.Id);
        ActivateChild(AmazonChildInstance.Child.Parent.Id);

        Brand = Brands.Single(b => b.Id == AmazonChildInstance.Child.Parent.Product.Brand.Id);
        Parent = Parents.Single(b => b.Id == AmazonChildInstance.Child.Parent.Id);
        AmazonChildInstance.Child = Childs.Single(p => p.Id == AmazonChildInstance.Child.Id);
        AmazonChildInstance.Instance = Instances.Single(i => i.Id == AmazonChildInstance.Instance.Id);
    }

    private void HandleBrandChanged(BrandModel brand)
    {
        Brand = brand;

        ResetParent();
        ActivateParent(brand.Id);
        SetChildInstanceSku();
    }

    private void HandleInstanceChanged(InstanceModel instance)
    {
        AmazonChildInstance.Instance = instance;
        SetChildInstanceSku();
    }

    private void HandleParentChanged(AmazonParentModel parent)
    {
        Parent = parent;

        ResetChild();
        ActivateChild(parent.Id);
        SetChildInstanceSku();
    }

    private void HandleChildChanged(AmazonChildModel child)
    {
        AmazonChildInstance.Child = child;
        SetChildInstanceSku();
    }

    private void ResetParent()
    {
        Parent = null;
        ParentSelectDisabled = true;
        Parents = new List<AmazonParentModel>();
    }

    private void ResetChild()
    {
        AmazonChildInstance.Child = null;
        ChildSelectDisabled = true;
        Childs = new List<AmazonChildModel>();
    }

    private void ActivateParent(long brandId)
    {
        ParentSelectDisabled = false;
        Parents = ParentService.GetAllForBrand(brandId);
    }

    private void ActivateChild(long parentId)
    {
        ChildSelectDisabled = false;
        Childs = ChildService.GetAllForParent(parentId);
    }

    private void SetChildInstanceSku()
    {
        AmazonChildInstance.Sku = AmazonChildInstanceService.GetSkuFor(AmazonChildInstance.Child?.Id, AmazonChildInstance.Instance?.Id);
    }

    private void HandleValidSubmit()
    {
        ValidationResult result = AmazonChildInstanceValidator.Validate(AmazonChildInstance);

        if (result.IsValid)
        {
            if (IsEdit)
            {
                AmazonChildInstanceService.Update(AmazonChildInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyUpdated("Amazon Child Instance"));
            }
            else
            {
                AmazonChildInstanceService.Add(AmazonChildInstance);
                Snackbar.AddSuccess(OperationMessages.SuccessfullyAdded("Amazon Child Instance"));
            }

            MudDialog.Close();
        }
        else
        {
            CustomValidation.DisplayErrors(result.Errors);
        }
    }
}