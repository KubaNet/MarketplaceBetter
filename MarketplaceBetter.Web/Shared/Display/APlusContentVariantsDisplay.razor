@using MarketplaceBetter.Domain.Model.Catalog.Products;

@if (Variants.Any())
{
    if (Variants.Count < 5)
    {
        IList<VariantModel> variantsOrdered = Variants.OrderBy(v => v.Color.Name).ThenBy(v => v.Size.Id).ToList();
        for (int i = 0; i < variantsOrdered.Count; i++)
        {
            <div>@variantsOrdered[i].Sku (@variantsOrdered[i].Asin)</div>
        }
    }
    else
    {
        <div>
            <MudTooltip Visible="TooltipVisible">
                <ChildContent>
                    <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="OpenPopover">@Variants.Count variants</MudButton>
                </ChildContent>
                <TooltipContent>
                    @foreach (var variant in Variants.OrderBy(v => v.Color.Name).ThenBy(v => v.Size.Id))
                    {
                        <span>@variant.Sku (@variant.Asin); </span>
                    }
                </TooltipContent>
            </MudTooltip>
            <MudPopover Open="PopoverOpened" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="px-4 pt-4">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h6" Class="mb-3">@Variants.Count variants</MudText>
                    <MudIconButton OnClick="ClosePopover" Icon="@Icons.Material.Filled.Close" style="position: absolute; top: 4px; right: 2px;"></MudIconButton>
                    @foreach (var variant in Variants.OrderBy(v => v.Color.Name).ThenBy(v => v.Size.Id))
                    {
                        <div>@variant.Sku (@variant.Asin);</div>
                    }
                    <MudButton OnClick="ClosePopover" Class="ml-auto mr-n3 mb-1" Color="Color.Error">Close</MudButton>
                </div>
            </MudPopover>
        </div>
    }
}

@code {
    [Parameter] public IList<VariantModel> Variants { get; set; }

    private bool TooltipVisible = false;
    private bool PopoverOpened = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private void OpenPopover()
    {
        PopoverOpened = true;
    }

    private void ClosePopover()
    {
        PopoverOpened = false;
    }
}
