@using MarketplaceBetter.Domain.Entities.Amazon
@using MarketplaceBetter.Domain.Model.Amazon
@using MarketplaceBetter.Services.Domain.Amazon.Interfaces

@inject IAmazonTargetingService TargetingService
@inject IAmazonTargetingTypeService TargetingTypeService

@{
    switch (Targeting.Type.SystemName)
    {
        case AmazonTargetingTypeEnum.Keyword:
            <text>
                <MudChip Color="Color.Info">@Targeting.Type.Name</MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.ShoppingBag" Color="@Color.Secondary" OnClick="SetAsProduct"></MudIconButton>
            </text>
            break;
        case AmazonTargetingTypeEnum.Product:
            <text>
                <MudIconButton Icon="@Icons.Material.Filled.Keyboard" Color="Color.Info" OnClick="SetAsKeyword"></MudIconButton>
                <MudChip Color="Color.Secondary">@Targeting.Type.Name</MudChip>
            </text>
            break;
    }
}

@code {
    [Parameter] public AmazonTargetingModel Targeting { get; set; }

    private void SetAsKeyword()
    {
        TargetingService.SetAsKeyword(Targeting);

        Targeting.Type = TargetingTypeService.GetBySystemName(AmazonTargetingTypeEnum.Keyword);
    }

    private void SetAsProduct()
    {
        TargetingService.SetAsProduct(Targeting);

        Targeting.Type = TargetingTypeService.GetBySystemName(AmazonTargetingTypeEnum.Product);
    }
}
