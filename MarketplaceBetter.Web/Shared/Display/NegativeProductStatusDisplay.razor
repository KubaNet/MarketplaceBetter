@using MarketplaceBetter.Domain.Entities.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces

@inject INegativeProductService NegativeProductService

<MudSwitch T="bool" Checked="Checked" Color="Color.Tertiary" CheckedChanged="OnCheckedChanged" />

@code {
    [Parameter] public NegativeProductModel NegativeProduct { get; set; }

    private bool Checked = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (NegativeProduct.Status.SystemName == AdEntityStatusEnum.Enabled)
        {
            Checked = true;
        }
    }

    private void OnCheckedChanged(bool status)
    {
        Checked = status;

        if (status == true)
        {
            NegativeProductService.UpdateStatus(NegativeProduct.Id, AdEntityStatusEnum.Enabled);
        }
        else
        {
            NegativeProductService.UpdateStatus(NegativeProduct.Id, AdEntityStatusEnum.Paused);
        }
    }
}
