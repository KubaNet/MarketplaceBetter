@using MarketplaceBetter.Domain.Entities.Amazon.Inventory;
@using MarketplaceBetter.Domain.Model.Amazon.Inventory;

@{
    switch (Status.SystemName)
    {
        case AmazonEntityStatusEnum.Draft:
            <MudChip>@Status.Name</MudChip>
            break;
        case AmazonEntityStatusEnum.ToAdd:
            <MudChip Color="Color.Info">@Status.Name</MudChip>
            break;
        case AmazonEntityStatusEnum.Active:
            <MudChip Color="Color.Success">@Status.Name</MudChip>
            break;
        case AmazonEntityStatusEnum.ToWithdrawn:
            <MudChip Color="Color.Warning">@Status.Name</MudChip>
            break;
        case AmazonEntityStatusEnum.Withdrawn:
            <MudChip Color="Color.Error">@Status.Name</MudChip>
            break;
        default:
            throw new UnrecognizedEnumValueException<AmazonEntityStatusEnum>(Status.SystemName);
    }
}

@code {
    [Parameter] public AmazonEntityStatusModel Status { get; set; }
}
