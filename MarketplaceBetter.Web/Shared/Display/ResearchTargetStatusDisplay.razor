@using MarketplaceBetter.Domain.Entities.Amazon.Keywords
@using MarketplaceBetter.Domain.Model.Amazon.Keywords
@using MarketplaceBetter.Services.Domain.Amazon.Keywords.Interfaces

@inject IResearchTargetService TargetService
@inject IResearchTargetStatusService TargetStatusService

@{
    switch (Target.Status.SystemName)
    {
        case ResearchTargetStatusEnum.Included:
            <text>
                <MudChip Color="Color.Success">@Target.Status.Name</MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.Block" Color="@Color.Error" OnClick="SetAsExcluded"></MudIconButton>
            </text>
            break;
        case ResearchTargetStatusEnum.Excluded:
            <text>
                <MudIconButton Icon="@Icons.Material.Filled.Check" Color="@Color.Success" OnClick="SetAsIncluded"></MudIconButton>
                <MudChip Color="Color.Error">@Target.Status.Name</MudChip>
            </text>
            break;
    }
}

@code {
    [Parameter] public ResearchTargetModel Target { get; set; }

    private void SetAsIncluded()
    {
        TargetService.SetAsIncluded(Target);

        Target.Status = TargetStatusService.GetBySystemName(ResearchTargetStatusEnum.Included);
    }

    private void SetAsExcluded()
    {
        TargetService.SetAsExcluded(Target);

        Target.Status = TargetStatusService.GetBySystemName(ResearchTargetStatusEnum.Excluded);
    }
}
