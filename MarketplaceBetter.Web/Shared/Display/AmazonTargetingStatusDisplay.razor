@using MarketplaceBetter.Domain.Entities.Amazon
@using MarketplaceBetter.Domain.Entities.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces

@inject IAmazonTargetingService TargetingService
@inject IAmazonTargetingStatusService TargetingStatusService

@{
    switch (Targeting.Status.SystemName)
    {
        case AmazonTargetingStatusEnum.New:
            <text>
                <MudIconButton Icon="@Icons.Material.Filled.Check" Color="@Color.Success" OnClick="SetAsActive"></MudIconButton>
                <MudChip>@Targeting.Status.Name</MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.Block" Color="@Color.Error" OnClick="SetAsNegative"></MudIconButton>
            </text>
            break;
        case AmazonTargetingStatusEnum.Active:
            <text>
                <MudChip Color="Color.Success">@Targeting.Status.Name</MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.Block" Color="@Color.Error" OnClick="SetAsNegative"></MudIconButton>
            </text>
            break;
        case AmazonTargetingStatusEnum.Negative:
            <text>
                <MudIconButton Icon="@Icons.Material.Filled.Check" Color="@Color.Success" OnClick="SetAsActive"></MudIconButton>
                <MudChip Color="Color.Error">@Targeting.Status.Name</MudChip>
            </text>
            break;
    }
}

@code {
    [Parameter] public AmazonTargetingModel Targeting { get; set; }

    private void SetAsActive()
    {
        TargetingService.SetAsActive(Targeting);

        Targeting.Status = TargetingStatusService.GetBySystemName(AmazonTargetingStatusEnum.Active);
    }

    private void SetAsNegative()
    {
        TargetingService.SetAsNegative(Targeting);

        Targeting.Status = TargetingStatusService.GetBySystemName(AmazonTargetingStatusEnum.Negative);
    }
}
