@using MarketplaceBetter.Domain.Model.Base;

@if (!string.IsNullOrWhiteSpace(Asin))
{
    <MudIconButton Icon="@Icons.Material.Filled.Link" Href="@InstanceHelper.GetUrlForProductPage(Instance.SystemName, Asin)" Target="_black" Color="Color.Warning" Size="Size.Small" Title="View product on Amazon"></MudIconButton>
}

@code {
    [Parameter] public InstanceModel Instance { get; set; }
    [Parameter] public string Asin { get; set; }
}
