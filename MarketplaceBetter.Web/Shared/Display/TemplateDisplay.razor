@using MarketplaceBetter.Domain.Model.Amazon.Inventory;
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces;
@using System.IO;
@using System.Threading;

@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ITemplateService TemplateService

@if (Parent.Template != null)
{
    <MudLink OnClick="Download" Style="cursor:pointer; text-decoration: none;" title="Click to download">@Parent.Template.FileName</MudLink>
    <MudIconButton OnClick="Delete" Icon="@Icons.Material.Filled.Clear" Color="Color.Error" Size="Size.Small" title="Delete"></MudIconButton>
}

@code {
    [Parameter] public ParentModel Parent { get; set; }

    private async void Download()
    {
        Stream file = TemplateService.Download(Parent.Template.Id);

        DotNetStreamReference streamReference = new DotNetStreamReference(file);

        await JS.InvokeVoidAsync("DownloadFileFromStream", CancellationToken.None, Parent.Template.FileName, streamReference);
    }

    private async void Delete()
    {
        DialogResult result = await DialogService.Show<ConfirmDialog>(null, new DialogParameters { ["Question"] = $"Are you sure you want to delete template <b>{Parent.Template.FileName}</b> ?" }).Result;

        if (!result.Canceled)
        {
            TemplateService.Delete(Parent.Template.Id);
            Parent.Template = null;

            StateHasChanged();
        }
    }
}
