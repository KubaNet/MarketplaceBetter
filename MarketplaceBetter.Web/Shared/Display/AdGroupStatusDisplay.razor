@using MarketplaceBetter.Domain.Entities.Amazon.Campaigns
@using MarketplaceBetter.Domain.Model.Amazon.Campaigns
@using MarketplaceBetter.Services.Domain.Amazon.Campaigns.Interfaces

<MudSwitch T="bool" Checked="Checked" Color="Color.Tertiary" ReadOnly="true" />

@code {
    [Parameter] public AdGroupModel AdGroup { get; set; }

    private bool Checked = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (AdGroup.Status.SystemName == AdEntityStatusEnum.Enabled)
        {
            Checked = true;
        }
    }
}
