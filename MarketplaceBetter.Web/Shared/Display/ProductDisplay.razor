@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Web.Pages.Catalog.Products.Products;

@inject IDialogService Dialog

<MudButton Variant="Variant.Text" Color="Color.Primary" Style="text-transform:none" OnClick="OpenProductGoToDialog">@Product.Name</MudButton>

@code {
    [Parameter] public ProductModel Product { get; set; }

    private void OpenProductGoToDialog()
    {
        DialogOptions options = new DialogOptions() { CloseButton = true };

        Dialog.Show<ProductGoToDialog>(null, new DialogParameters { ["Product"] = Product }, options);
    }
}
