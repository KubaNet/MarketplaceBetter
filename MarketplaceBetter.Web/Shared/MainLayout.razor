@inherits LayoutComponentBase

@using MarketplaceBetter.Domain.Entities.Base;
@using MarketplaceBetter.Domain.Model.Base;
@using MarketplaceBetter.Domain.Model.Catalog.ColorsAndSizes;
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Amazon.APlusContents.Interfaces;
@using MarketplaceBetter.Services.Domain.Amazon.Inventory.Interfaces;
@using MarketplaceBetter.Services.Domain.Base.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.Attributes.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.ColorsAndSizes.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces;
@using MarketplaceBetter.Services.Model;
@using MarketplaceBetter.Services.Specialized.Interfaces;
@using MarketplaceBetter.Services.Domain.Amazon.CopyAndMedia.Interfaces;

@inject NavigationManager Navigation
@inject IEntityStatusService StatusService
@inject IBrandCollectionService BrandCollectionService
@inject IStandardSizeService StandardSizeService
@inject IInstanceService InstanceService
@inject IUserService UserService
@inject IProductService ProductService
@inject IVariantService VariantService
@inject ICopywritingService CopywritingService
@inject IPhotoService PhotoService
@inject IVariantPhotosService VariantPhotosService
@inject IColorService ColorService
@inject IProductColorService ProductColorService
@inject IColorTranslationService ColorTranslationService
@inject IProductDimensionsService ProductDimensionsService
@inject IParentService ParentService
@inject IChildService ChildService
@inject IAPlusContentService APlusContentService

<AuthorizeView>
    <Authorized>
        <MudThemeProvider Theme="BetterTheme" />
        <MudDialogProvider />
        <MudSnackbarProvider />

        <MudLayout>
            <MudAppBar Dense="true" Elevation="1">
                <div class="d-flex flex-grow-1">
                    <MudImage Src="images/mb-logo.png" Height="45"></MudImage>
                    <div id="GlobalSearch" style="width: 350px;" class="ml-8">
                        <MudTextField T="string" Placeholder="Search" ValueChanged="SearchGlobally" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0"></MudTextField>
                        <MudPopover Open="GlobalSearchResultsOpen" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="pa-3" Style="margin-top: -12px; width: 350px;">
                            @GlobalSearchResults
                        </MudPopover>
                    </div>
                    <div class="flex-grow-1"></div>
                    <div>
                        <MudSelect T="EntityStatusModel" Value="Status" Label="Status" DisableUnderLine="true" MaxHeight="500" Style="width: 180px;" Class="ml-6" ValueChanged="OnSelectedStatusChange">
                            @foreach (var status in Statuses)
                            {
                                <MudSelectItem Value="status">@status.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div>
                        <MudCheckBox T="bool" Checked="HideDrafts" Label="Hide Drafts" Style=@($"color: {BetterTheme.Palette.TextPrimary}") Class="mt-1 ml-3" CheckedChanged="OnHideDraftsChange" Disabled="DraftsAndWithdrawnDisabled"></MudCheckBox>
                    </div>
                    <div>
                        <MudCheckBox T="bool" Checked="HideWithdrawn" Label="Hide Withdrawn" Style=@($"color: {BetterTheme.Palette.TextPrimary}") Class="mt-1 ml-3" CheckedChanged="OnHideWithdrawnChange" Disabled="DraftsAndWithdrawnDisabled"></MudCheckBox>
                    </div>
                    <div>
                        <MudSelect T="BrandCollectionModel" Value="BrandCollection" Label="Brand -- Collection" DisableUnderLine="true" Style="width: 180px;" MaxHeight="800" Class="ml-6" ValueChanged="OnSelectedBrandChange">
                            @foreach (var brand in BrandsAndCollections)
                            {
                                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div>
                        <MudSelect T="StandardSizeModel" Value="Size" Label="Size" DisableUnderLine="true" MaxHeight="500" Style="width: 180px;" Class="ml-6" ValueChanged="OnSelectedSizeChange">
                            @foreach (var size in Sizes)
                            {
                                <MudSelectItem Value="size">@size.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div>
                        <MudSelect T="InstanceModel" Value="Instance" Label="Instance" DisableUnderLine="true" Style="width: 180px;" MaxHeight="600" Class="ml-4" ValueChanged="OnSelectedInstanceChange">
                            @foreach (var instance in Instances)
                            {
                                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>
            </MudAppBar>
            <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2">
                <Menu />
            </MudDrawer>
            <MudMainContent>
                <CascadingValue Value="@BetterTheme">
                    <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
                        @Body
                    </MudContainer>
                </CascadingValue>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>

@code {
    private EntityStatusModel AllStatuses = new EntityStatusModel { Name = "All" };
    private EntityStatusModel Status;
    private List<EntityStatusModel> Statuses;

    private BrandCollectionModel AllBrandsAndCollections = new BrandCollectionModel() { Name = "All" };
    private BrandCollectionModel BrandCollection;
    private List<BrandCollectionModel> BrandsAndCollections;

    private StandardSizeModel AllSizes = new StandardSizeModel { Name = "All" };
    private StandardSizeModel Size;
    private List<StandardSizeModel> Sizes;

    private InstanceModel Instance;
    private IList<InstanceModel> Instances;

    private bool HideDrafts = false;
    private bool HideWithdrawn = false;
    private bool DraftsAndWithdrawnDisabled = false;
    private bool GlobalSearchResultsOpen = false;
    private RenderFragment GlobalSearchResults;

    MudTheme BetterTheme = new MudTheme()
        {
            Palette = new PaletteLight()
            {
                Primary = "#32ae70",
                AppbarBackground = Colors.Grey.Lighten3,
            }
        };

    protected override void OnInitialized()
    {
        base.OnInitialized();

        InitializeCurrentStatus();
        InitializeCurrentBrandCollection();
        InitializeCurrentSize();
        InitializeCurrentInstance();
        InitializeDraftsSetting();
        InitializeWithdrawnSetting();
    }

    private void InitializeCurrentStatus()
    {
        Statuses = new List<EntityStatusModel>();
        Statuses.Add(AllStatuses);
        Statuses.AddRange(StatusService.GetAll());

        if (UserService.IsSpecificStatus())
        {
            Status = Statuses.Single(b => b.Id == UserService.GetCurrentStatus().Id);
        }
        else
        {
            Status = Statuses.First();
        }

        DraftsAndWithdrawnDisabled = Status.Name != "All";
    }

    private void InitializeCurrentBrandCollection()
    {
        BrandsAndCollections = new List<BrandCollectionModel>();
        BrandsAndCollections.Add(AllBrandsAndCollections);
        BrandsAndCollections.AddRange(BrandCollectionService.GetAll());

        if (UserService.IsSpecificBrand())
        {
            BrandCollection = BrandsAndCollections.Single(b => b.IsBrand && b.Brand.Id == UserService.GetCurrentBrand().Id);
        }
        else if (UserService.IsSpecificCollection())
        {
            BrandCollection = BrandsAndCollections.Single(c => c.IsCollection && c.Collection.Id == UserService.GetCurrentCollection().Id);
        }
        else
        {
            BrandCollection = BrandsAndCollections.First();
        }
    }

    private void InitializeCurrentSize()
    {
        Sizes = new List<StandardSizeModel>();
        Sizes.Add(AllSizes);
        Sizes.AddRange(StandardSizeService.GetAll());

        if (UserService.IsSpecificSize())
        {
            Size = Sizes.Single(s => s.Id == UserService.GetCurrentSize().Id);
        }
        else
        {
            Size = Sizes.First();
        }
    }

    private void InitializeCurrentInstance()
    {
        Instances = InstanceService.GetAll();

        if (UserService.IsSpecificInstance())
        {
            Instance = Instances.Single(i => i.Id == UserService.GetCurrentInstance().Id);
        }
        else
        {
            Instance = Instances.Single(i => i.SystemName == InstanceEnum.All);
        }
    }

    private void InitializeDraftsSetting()
    {
        HideDrafts = UserService.HideDrafts();
    }

    private void InitializeWithdrawnSetting()
    {
        HideWithdrawn = UserService.HideWithdrawn();
    }

    private void OnSelectedStatusChange(EntityStatusModel status)
    {
        Status = status;
        UserService.SetCurrentStatus(status);

        DraftsAndWithdrawnDisabled = Status.Name != "All";

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void OnSelectedBrandChange(BrandCollectionModel brandCollection)
    {
        BrandCollection = brandCollection;
        if (brandCollection.IsBrand)
        {
            UserService.SetCurrentBrand(brandCollection.Brand);
            UserService.SetCurrentCollection(null);
        }
        else if (brandCollection.IsCollection)
        {
            UserService.SetCurrentCollection(brandCollection.Collection);
            UserService.SetCurrentBrand(null);
        }
        else
        {
            UserService.SetCurrentBrand(null);
            UserService.SetCurrentCollection(null);
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void OnSelectedSizeChange(StandardSizeModel size)
    {
        Size = size;
        UserService.SetCurrentSize(size);

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void OnSelectedInstanceChange(InstanceModel instance)
    {
        Instance = instance;
        UserService.SetCurrentInstance(instance);

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void OnHideDraftsChange(bool hideDrafts)
    {
        UserService.SetHideDrafts(hideDrafts);

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void OnHideWithdrawnChange(bool hideWithdrawn)
    {
        UserService.SetHideWithdrawn(hideWithdrawn);

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void SearchGlobally(string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
        {
            GlobalSearchResultsOpen = false;
            return;
        }

        ListRequest searchRequest = new ListRequest { SearchString = searchString };

        IList<SearchResult> searchResults = new List<SearchResult>();
        searchResults.Add(new SearchResult { EntityName = "Products", BaseUrl = "products", ResultsCount = ProductService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.ShoppingBasket });
        searchResults.Add(new SearchResult { EntityName = "Variants", BaseUrl = "variants", ResultsCount = VariantService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.ShoppingBasket });
        searchResults.Add(new SearchResult { EntityName = "Colors", BaseUrl = "colors", ResultsCount = ColorService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.Palette });
        searchResults.Add(new SearchResult { EntityName = "Product Colors", BaseUrl = "product-colors", ResultsCount = ProductColorService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.Palette });
        searchResults.Add(new SearchResult { EntityName = "Color Translations", BaseUrl = "color-translations", ResultsCount = ColorTranslationService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.Palette });
        searchResults.Add(new SearchResult { EntityName = "Product Dimensions", BaseUrl = "product-dimensions", ResultsCount = ProductDimensionsService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.BorderColor });
        searchResults.Add(new SearchResult { EntityName = "Parents", BaseUrl = "parents", ResultsCount = ParentService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.Inventory });
        searchResults.Add(new SearchResult { EntityName = "Childs", BaseUrl = "childs", ResultsCount = ChildService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.Inventory });
        searchResults.Add(new SearchResult { EntityName = "Copywriting", BaseUrl = "copywriting", ResultsCount = CopywritingService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.PhotoLibrary });
        searchResults.Add(new SearchResult { EntityName = "Photos", BaseUrl = "photos", ResultsCount = PhotoService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.PhotoLibrary });
        searchResults.Add(new SearchResult { EntityName = "Variant Photos", BaseUrl = "variant-photos", ResultsCount = VariantPhotosService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.PhotoLibrary });
        searchResults.Add(new SearchResult { EntityName = "A+ Content", BaseUrl = "a-plus-content", ResultsCount = APlusContentService.CountForListRequest(searchRequest), Icon = Icons.Material.Filled.AddPhotoAlternate });

        GlobalSearchResults = __builder =>
        {
            <MudList Clickable="true">
                @foreach (var searchResult in searchResults)
                {
                    <MudListItem Avatar="@searchResult.Icon" IconColor="(searchResult.ResultsCount > 0 ? Color.Dark : Color.Inherit)" OnClick="(() => GoToResults(searchResult.BaseUrl, searchString))">
                        @if (searchResult.ResultsCount > 0)
                        {
                            <text>
                                @searchResult.EntityName - <b>@searchResult.ResultsCount results</b>
                            </text>
                        }
                        else
                        {
                            <text>
                                @searchResult.EntityName - @searchResult.ResultsCount results
                            </text>
                        }
                    </MudListItem>
                }
            </MudList>
        };
        GlobalSearchResultsOpen = true;
    }

    private void GoToResults(string baseUrl, string searchString)
    {
        Navigation.NavigateTo($"{baseUrl}?SearchString={searchString}", true);
    }

    private class SearchResult
    {
        public string EntityName { get; set; }

        public string BaseUrl { get; set; }

        public int ResultsCount { get; set; }

        public string Icon { get; set; }
    }
}