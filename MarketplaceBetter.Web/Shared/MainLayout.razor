@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <MudThemeProvider Theme="BetterTheme" />
        <MudDialogProvider />
        <MudSnackbarProvider />

        <MudLayout>
            <MudAppBar Dense="true" Elevation="1">
                <MudText Typo="Typo.h5" Class="ml-3">Marketplace Better</MudText>
                <MudSpacer />
            </MudAppBar>
            <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2">
                <Menu />
            </MudDrawer>
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>

@code{
    MudTheme BetterTheme = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = "#32ae70",
            AppbarBackground = "32ae70",
        }
    };
}