@inherits LayoutComponentBase

@using MarketplaceBetter.Domain.Entities.Base;
@using MarketplaceBetter.Domain.Model.Base;
@using MarketplaceBetter.Domain.Model.Catalog.Products
@using MarketplaceBetter.Services.Domain.Base.Interfaces;
@using MarketplaceBetter.Services.Domain.Catalog.Products.Interfaces;
@using MarketplaceBetter.Services.Specialized.Interfaces;

@inject IBrandService BrandService
@inject IInstanceService InstanceService
@inject ICurrentBrandService CurrentBrandService
@inject ICurrentInstanceService CurrentInstanceService
@inject IDraftsSettingService DraftsSettingService
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        <MudThemeProvider Theme="BetterTheme" />
        <MudDialogProvider />
        <MudSnackbarProvider />

        <MudLayout>
            <MudAppBar Dense="true" Elevation="1">
                <div class="d-flex flex-grow-1">
                    <MudImage Src="images/mb-logo.png" Height="45"></MudImage>
                    <div class="flex-grow-1"></div>
                    <div>
                        <MudCheckBox T="bool" Checked="ShowDrafts" Label="Show Drafts" Style=@($"color: {BetterTheme.Palette.TextPrimary}") Class="mt-1" CheckedChanged="OnShowDraftsChange"></MudCheckBox>
                    </div>
                    <div>
                        <MudSelect T="BrandModel" Value="Brand" Label="Brand" DisableUnderLine="true" Style="width: 180px;" Class="ml-5" ValueChanged="OnSelectedBrandChange">
                            @foreach (var brand in Brands)
                            {
                                <MudSelectItem Value="brand">@brand.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div>
                        <MudSelect T="InstanceModel" Value="Instance" Label="Instance" DisableUnderLine="true" Style="width: 180px;" MaxHeight="600" Class="ml-4" ValueChanged="OnSelectedInstanceChange">
                            @foreach (var instance in Instances)
                            {
                                <MudSelectItem Value="instance">@instance.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>
            </MudAppBar>
            <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2">
                <Menu />
            </MudDrawer>
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>

@code {
    private BrandModel AllBrands = new BrandModel() { Name = "All" };
    private BrandModel Brand;
    private List<BrandModel> Brands;
    private InstanceModel Instance;
    private IList<InstanceModel> Instances;
    private bool ShowDrafts = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        InitializeCurrentBrand();
        InitializeCurrentInstance();
        InitializeDraftsSetting();
    }

    private void InitializeCurrentBrand()
    {
        Brands = new List<BrandModel>();
        Brands.Add(AllBrands);
        Brands.AddRange(BrandService.GetAll());

        if (CurrentBrandService.IsSpecificBrand())
        {
            Brand = Brands.Single(b => b.Id == CurrentBrandService.GetCurrentBrand().Id);
        }
        else
        {
            Brand = Brands.Single(b => b.Id == 0);
        }
    }

    private void InitializeCurrentInstance()
    {
        Instances = InstanceService.GetAll();
        if (CurrentInstanceService.IsSpecificInstance())
        {
            Instance = Instances.Single(i => i.Id == CurrentInstanceService.GetCurrentInstance().Id);
        }
        else
        {
            Instance = Instances.Single(i => i.SystemName == InstanceEnum.All);
        }
    }

    private void InitializeDraftsSetting()
    {
        ShowDrafts = DraftsSettingService.GetDraftsSetting();
    }

    private void OnSelectedBrandChange(BrandModel brand)
    {
        Brand = brand;

        CurrentBrandService.SetCurrentBrand(brand);

        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private void OnSelectedInstanceChange(InstanceModel instance)
    {
        Instance = instance;

        CurrentInstanceService.SetCurrentInstance(instance);

        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private void OnShowDraftsChange(bool showDrafts)
    {
        DraftsSettingService.SetDraftsSetting(showDrafts);

        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    MudTheme BetterTheme = new MudTheme()
        {
            Palette = new Palette()
            {
                Primary = "#32ae70",
                AppbarBackground = Colors.Grey.Lighten3,
            }
        };
}