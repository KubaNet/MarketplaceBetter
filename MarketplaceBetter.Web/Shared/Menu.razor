@using MarketplaceBetter.Services.Model;
@using MarketplaceBetter.Services.Domain.Base.Interfaces;

@inject NavigationManager NavigationManager
@inject IUserService UserService

<MudNavMenu>
    <MudNavGroup Title="Catalog" Icon="@Icons.Material.Filled.Folder" Expanded="UserService.IsExpanded(MenuItemEnum.Catalog)" HideExpandIcon="true" ExpandedChanged="CatalogExpandedChanged">
        <MudNavGroup Title="Products" Icon="@Icons.Material.Filled.ShoppingBasket" Expanded="UserService.IsExpanded(MenuItemEnum.Products)" HideExpandIcon="true" ExpandedChanged="ProductsExpandedChanged">
            <MudNavLink Href="/products">Products</MudNavLink>
            <MudNavLink Href="/variants">Variants</MudNavLink>
            <MudNavLink Href="/collections">Collections</MudNavLink>
            <MudNavLink Href="/brands">Brands</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Colors & Sizes" Icon="@Icons.Material.Filled.Palette" Expanded="UserService.IsExpanded(MenuItemEnum.ColorsAndSizes)" HideExpandIcon="true" ExpandedChanged="ColorsAndSizesExpandedChanged">
            <MudNavLink Href="/colors">Colors</MudNavLink>
            <MudNavLink Href="/product-colors">Product Colors</MudNavLink>
            <MudNavLink Href="/color-translations">Color Translations</MudNavLink>
            <MudNavLink Href="/color-groups">Color Groups</MudNavLink>
            <MudNavLink Href="/sizes">Sizes</MudNavLink>
            <MudNavLink Href="/size-groups">Size Groups</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Attributes" Icon="@Icons.Material.Filled.BorderColor" Expanded="UserService.IsExpanded(MenuItemEnum.Attributes)" HideExpandIcon="true" ExpandedChanged="AttributesExpandedChanged">
            <MudNavLink Href="/product-dimensions">Product Dimensions</MudNavLink>
        </MudNavGroup>
    </MudNavGroup>
    <MudNavGroup Title="Amazon" Icon="@Icons.Material.Filled.BrightnessAuto" Expanded="UserService.IsExpanded(MenuItemEnum.Amazon)" HideExpandIcon="true" ExpandedChanged="AmazonExpandedChanged">
        <MudNavGroup Title="Inventory" Icon="@Icons.Material.Filled.Inventory" Expanded="UserService.IsExpanded(MenuItemEnum.Inventory)" HideExpandIcon="true" ExpandedChanged="InventoryExpandedChanged">
            <MudNavLink Href="/parents">Parents</MudNavLink>
            <MudNavLink Href="/childs">Childs</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Copy & Media" Icon="@Icons.Material.Filled.PhotoLibrary" Expanded="UserService.IsExpanded(MenuItemEnum.CopyAndMedia)" HideExpandIcon="true" ExpandedChanged="CopyAndMediaExpandedChanged">
            <MudNavLink Href="/copywriting">Copywriting</MudNavLink>
            <MudNavLink Href="/photos">Photos</MudNavLink>
            <MudNavLink Href="/variant-photos">Variant Photos</MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="A+ Content" Icon="@Icons.Material.Filled.AddPhotoAlternate" Expanded="UserService.IsExpanded(MenuItemEnum.APlusContent)" HideExpandIcon="true" ExpandedChanged="APlusContentExpandedChanged">
            <MudNavLink Href="/a-plus-content">Content</MudNavLink>
            <MudNavLink Href="/a-plus-modules">Modules</MudNavLink>
            <MudNavLink Href="/variant-a-plus-modules">Variant Modules</MudNavLink>
        </MudNavGroup>

    </MudNavGroup>
    <MudNavGroup Title="Sales" Icon="@Icons.Material.Filled.MonetizationOn" Expanded="UserService.IsExpanded(MenuItemEnum.Sales)" HideExpandIcon="true" ExpandedChanged="SalesExpandedChanged">
        <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.DisplaySettings" Expanded="UserService.IsExpanded(MenuItemEnum.SalesSettings)" HideExpandIcon="true" ExpandedChanged="SalesSettingsExpandedChanged">
            <MudNavLink Href="/filfillment-centers">Fulfillment Centers</MudNavLink>
        </MudNavGroup>
        <MudNavGroup Title="Input Data" Icon="@Icons.Material.Filled.TableView" Expanded="UserService.IsExpanded(MenuItemEnum.InputData)" HideExpandIcon="true" ExpandedChanged="InputDataExpandedChanged">
            <MudNavLink Href="/amazon-fulfilled-shipments">Amazon Shipments</MudNavLink>
        </MudNavGroup>
    </MudNavGroup>
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();

        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object sender, LocationChangedEventArgs e)
    {
        if (UserService.LoginExpired() || UserService.SettingsChanged())
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
    }

    private void CatalogExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.Catalog, expaned);
    }

    private void ProductsExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.Products, expaned);
    }

    private void ColorsAndSizesExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.ColorsAndSizes, expaned);
    }

    private void AttributesExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.Attributes, expaned);
    }

    private void AmazonExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.Amazon, expaned);
    }

    private void InventoryExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.Inventory, expaned);
    }

    private void CopyAndMediaExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.CopyAndMedia, expaned);
    }

    private void APlusContentExpandedChanged(bool expanded)
    {
        UserService.SetExpanded(MenuItemEnum.APlusContent, expanded);
    }

    private void SalesExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.Sales, expaned);
    }

    private void InputDataExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.InputData, expaned);
    }

    private void SalesSettingsExpandedChanged(bool expaned)
    {
        UserService.SetExpanded(MenuItemEnum.SalesSettings, expaned);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}