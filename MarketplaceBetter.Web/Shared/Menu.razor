@inject NavigationManager NavigationManager

<MudNavMenu>
	<MudNavGroup Title="Catalog" Icon="@Icons.Filled.Folder" Expanded="true" HideExpandIcon="true">
		@if (IsProductsModule())
		{
			<MudNavGroup Title="Products" Icon="@Icons.Filled.ShoppingBasket" Expanded="true" HideExpandIcon="true">
				<MudNavLink Href="/products">Products</MudNavLink>
				<MudNavLink Href="/productvariants">Variants</MudNavLink>
				<MudNavLink Href="/collections">Collections</MudNavLink>
				<MudNavLink Href="/brands">Brands</MudNavLink>
			</MudNavGroup>
		}
		else
		{
			<MudNavLink Href="/products" Icon="@Icons.Filled.ShoppingBasket">Products</MudNavLink>
		}

		@if (IsColorsOrSizesModule())
		{
			<MudNavGroup Title="Colors & Sizes" Icon="@Icons.Filled.Palette" Expanded="true" HideExpandIcon="true">
				<MudNavLink Href="/colors">Colors</MudNavLink>
				<MudNavLink Href="/colortranslations">Color Translations</MudNavLink>
				<MudNavLink Href="/colorgroups">Color Groups</MudNavLink>
				<MudNavLink Href="/sizes">Sizes</MudNavLink>
				<MudNavLink Href="/sizegroups">Size Groups</MudNavLink>
			</MudNavGroup>
		}
		else
		{
			<MudNavLink Href="/colors" Icon="@Icons.Filled.Palette">Colors & Sizes</MudNavLink>
		}
	</MudNavGroup>
	<MudNavGroup Title="Amazon" Icon="@Icons.Filled.BrightnessAuto" Expanded="true" HideExpandIcon="true">
		@if (IsAmazonInventoryModule())
		{
			<MudNavGroup Title="Inventory" Icon="@Icons.Filled.Inventory" Expanded="true" HideExpandIcon="true">
				<MudNavLink Href="/amazonparents">Parents</MudNavLink>
				<MudNavLink Href="/amazonparentinstances">Parent Instances</MudNavLink>
				<MudNavLink Href="/amazonchilds">Childs</MudNavLink>
			</MudNavGroup>
		}
		else
		{
			<MudNavLink Href="/amazonparents" Icon="@Icons.Filled.Inventory">Inventory</MudNavLink>
		}

		@if (IsAmazonCampaignsModule())
		{
			<MudNavGroup Title="Inventory" Icon="@Icons.Filled.AppRegistration" Expanded="true" HideExpandIcon="true">
				<MudNavLink Href="/amazoncampaigns">Campaigns</MudNavLink>
				<MudNavLink Href="/amazontargeting">Targeting</MudNavLink>
			</MudNavGroup>
		}
		else
		{
			<MudNavLink Href="/amazoncampaigns" Icon="@Icons.Filled.AppRegistration">Campaigns</MudNavLink>
		}
	</MudNavGroup>
</MudNavMenu>

@code {
	protected override void OnInitialized()
	{
		base.OnInitialized();

		NavigationManager.LocationChanged += HandleLocationChanged;
	}

	private void HandleLocationChanged(object sender, LocationChangedEventArgs e)
	{
		StateHasChanged();
	}

	private bool IsProductsModule()
	{
		if (NavigationManager.Uri.Contains("products")
			|| NavigationManager.Uri.Contains("productvariants")
			|| NavigationManager.Uri.Contains("collections")
			|| NavigationManager.Uri.Contains("brands"))
		{
			return true;
		}

		return false;
	}

	private bool IsColorsOrSizesModule()
	{
		if (NavigationManager.Uri.Contains("colors")
			|| NavigationManager.Uri.Contains("colortranslations")
			|| NavigationManager.Uri.Contains("colorgroups")
			|| NavigationManager.Uri.Contains("sizes")
			|| NavigationManager.Uri.Contains("sizegroups"))
		{
			return true;
		}

		return false;
	}

	private bool IsAmazonInventoryModule()
	{
		if (NavigationManager.Uri.Contains("amazonparents") ||
			NavigationManager.Uri.Contains("amazonparentinstances") ||
			NavigationManager.Uri.Contains("amazonchilds"))
		{
			return true;
		}

		return false;
	}

	private bool IsAmazonCampaignsModule()
	{
		if (NavigationManager.Uri.Contains("amazoncampaigns") ||
			NavigationManager.Uri.Contains("amazontargeting"))
		{
			return true;
		}

		return false;
	}

	public void Dispose()
	{
		NavigationManager.LocationChanged -= HandleLocationChanged;
	}
}