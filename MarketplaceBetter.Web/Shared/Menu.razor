@inject NavigationManager NavigationManager

<MudNavMenu>
    <MudNavGroup Title="Catalog" Icon="@Icons.Filled.Folder" Expanded="true" HideExpandIcon="true">
        @if (IsProductsModule())
        {
            <MudNavGroup Title="Products" Icon="@Icons.Filled.ShoppingBasket" Expanded="true" HideExpandIcon="true">
                <MudNavLink Href="/products">Products</MudNavLink>
                <MudNavLink Href="/productvariants">Variants</MudNavLink>
            </MudNavGroup>
        }
        else
        {
            <MudNavLink Href="/products" Icon="@Icons.Filled.ShoppingBasket">Products</MudNavLink>
        }
        <MudNavLink Href="/brands" Icon="@Icons.Filled.Stars">Brands</MudNavLink>
        @if (IsColorsModule())
        {
            <MudNavGroup Title="Colors" Icon="@Icons.Filled.Palette" Expanded="true" HideExpandIcon="true">
                <MudNavLink Href="/colors">Colors</MudNavLink>
                <MudNavLink Href="/colorgroups">Groups</MudNavLink>
            </MudNavGroup>
        }
        else
        {
            <MudNavLink Href="/colors" Icon="@Icons.Filled.Palette">Colors</MudNavLink>
        }
        @if (IsSizesModule())
        {
            <MudNavGroup Title="Sizes" Icon="@Icons.Filled.SettingsEthernet" Expanded="true" HideExpandIcon="true">
                <MudNavLink Href="/sizes">Sizes</MudNavLink>
                <MudNavLink Href="/sizegroups">Groups</MudNavLink>
            </MudNavGroup>
        }
        else
        {
            <MudNavLink Href="/sizes" Icon="@Icons.Filled.SettingsEthernet">Sizes</MudNavLink>
        }
    </MudNavGroup>
    <MudNavGroup Title="Amazon" Icon="@Icons.Filled.BrightnessAuto" Expanded="true" HideExpandIcon="true">
        @if (IsAmazonInventoryModule())
        {
            <MudNavGroup Title="Inventory" Icon="@Icons.Filled.Inventory" Expanded="true" HideExpandIcon="true">
                <MudNavLink Href="/amazonparents">Parents</MudNavLink>
                <MudNavLink Href="/amazonchildren">Children</MudNavLink>
            </MudNavGroup>
        }
        else
        {
            <MudNavLink Href="/amazonparents" Icon="@Icons.Filled.Inventory">Inventory</MudNavLink>
        }
        @if (IsKeywordsModule())
        {
            <MudNavGroup Title="Keywords" Icon="@Icons.Filled.VpnKey" Expanded="true" HideExpandIcon="true">
                <MudNavLink Href="/keywordanalyses">Analyses</MudNavLink>
            </MudNavGroup>
        }
        else
        {
            <MudNavLink Href="/keywordanalyses" Icon="@Icons.Filled.VpnKey">Keywords</MudNavLink>
        }
    </MudNavGroup>
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();

        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private bool IsProductsModule()
    {
        if (NavigationManager.Uri.Contains("products")
            || NavigationManager.Uri.Contains("productvariants"))
        {
            return true;
        }

        return false;
    }

    private bool IsColorsModule()
    {
        if (NavigationManager.Uri.Contains("colors")
            || NavigationManager.Uri.Contains("colorgroups"))
        {
            return true;
        }

        return false;
    }

    private bool IsSizesModule()
    {
        if (NavigationManager.Uri.Contains("sizes")
            || NavigationManager.Uri.Contains("sizegroups"))
        {
            return true;
        }

        return false;
    }

    private bool IsAmazonInventoryModule()
    {
        if (NavigationManager.Uri.Contains("amazonparents") ||
            NavigationManager.Uri.Contains("amazonchildren"))
        {
            return true;
        }

        return false;
    }

    private bool IsKeywordsModule()
    {
        if (NavigationManager.Uri.Contains("keywordanalyses"))
        {
            return true;
        }

        return false;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}