@page "/login"
@using Microsoft.Extensions.Configuration

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="BetterTheme" />

<div style="position:fixed; padding:0; margin:0; top:0; left:0; width: 100%; height: 100%; background-color:@(Colors.Grey.Lighten4);">
    <div class="d-flex justify-center pt-10" style="position: relative; top: 30%;">
        <MudCard Style="width: 400px;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Welcome</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText>You have to login to view this page.</MudText>
                <MudForm @ref="Form" @bind-IsValid="@Success" @bind-Errors="@Errors">
                    <MudTextField T="string" Label="Password" @ref="Password" InputType="InputType.Password"
                                  Validation="@(new Func<string, IEnumerable<string>>(PasswordIsValid))" Required="true"
                                  RequiredError="Password is required!" />
                </MudForm>
            </MudCardContent>
            <MudCardActions>
                <MudButton OnClick="LoginUser" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Success)">Login</MudButton>
            </MudCardActions>
        </MudCard>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool Success;
    private string[] Errors = { };
    private MudTextField<string> Password;
    private MudForm Form;

    MudTheme BetterTheme = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = "#32ae70",
        }
    };

    private void LoginUser()
    {
        if (PasswordMatches(Password.Value))
        {
            ((BetterAuthenticationStateProvider)AuthenticationStateProvider).LoginUser();

            NavigationManager.NavigateTo($"{ReturnUrl ?? "/photos"}");
        }
    }

    private IEnumerable<string> PasswordIsValid(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            yield return "Please provide a password";
            yield break;
        }

        if (!PasswordMatches(password))
        {
            yield return "Password is invalid!";
        }
    }

    private bool PasswordMatches(string password)
    {
        string appPassword = Configuration.GetValue<string>("Password");

        return appPassword == password;
    }
}