@using MarketplaceBetter.Services.Specialized.Interfaces;
@using Microsoft.Extensions.Configuration

@page "/login"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserService UserService
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="BetterTheme" />

<div style="position:fixed; padding:0; margin:0; top:0; left:0; width: 100%; height: 100%; background-color:@(Colors.Grey.Lighten4);">
    <div class="d-flex justify-center pt-10" style="position: relative; top: 30%;">
        <MudCard Style="width: 400px;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Welcome</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText>You have to login to view this page.</MudText>
                <MudForm @ref="Form" @bind-IsValid="@Success">
                    <MudTextField T="string" Label="Login" @bind-Value="LoginText" InputType="InputType.Text" Required="true" RequiredError="Login is required!" />
                    <MudTextField T="string" Label="Password" @ref="Password" InputType="InputType.Password" Validation="PasswordIsValid" Required="true" RequiredError="Password is required!" />
                </MudForm>
            </MudCardContent>
            <MudCardActions>
                <MudButton OnClick="LoginUser" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Success)">Login</MudButton>
            </MudCardActions>
        </MudCard>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool Success;
    private string LoginText;
    private MudTextField<string> Password;
    private MudForm Form;

    MudTheme BetterTheme = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = "#32ae70",
        }
    };

    private void LoginUser()
    {
        if (PasswordMatches(LoginText, Password.Value))
        {
            ((BetterAuthenticationStateProvider)AuthenticationStateProvider).LoginUser(LoginText);

            NavigationManager.NavigateTo($"{ReturnUrl ?? "/products"}");
        }
    }

    private IEnumerable<string> PasswordIsValid(string password)
    {
        if (!PasswordMatches(LoginText, password))
        {
            yield return "Password is invalid!";
        }
    }

    private bool PasswordMatches(string login, string password)
    {
        return UserService.IsCorrectPassword(login, password);
    }
}