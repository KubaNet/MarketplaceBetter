@using MarketplaceBetter.Domain.Model.Other;
@using MarketplaceBetter.Services.Domain.Base.Interfaces

@page "/login"
@inject ISnackbar Snackbar
@inject IUserService UserService
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="BetterTheme" />
<MudSnackbarProvider />

<div style="position:fixed; padding:0; margin:0; top:0; left:0; width: 100%; height: 100%; background-color:@(Colors.Gray.Lighten4);">
    <div class="d-flex justify-center pt-10" style="position: relative; top: 30%;">
        <EditForm Model="LoginModel" OnValidSubmit="LoginUser">
            <CustomValidation @ref="CustomValidation" />
            <DataAnnotationsValidator />
            <MudCard Style="width: 400px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Welcome</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText>You have to login to view this page.</MudText>
                    <MudTextField T="string" Label="Username" @bind-Value="LoginModel.Username" InputType="InputType.Text" For="() => LoginModel.Username" />
                    <MudTextField T="string" Label="Password" @bind-Value="LoginModel.Password" InputType="InputType.Password" For="() => LoginModel.Password" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Login</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private CustomValidation CustomValidation = new();
    private LoginModel LoginModel = new();

    MudTheme BetterTheme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = "#32ae70",
            }
        };

    private void LoginUser()
    {
        if (UserService.IsCorrectPassword(LoginModel.Username, LoginModel.Password))
        {
            UserService.Login(LoginModel.Username);

            NavigationManager.NavigateTo($"{ReturnUrl ?? "/products"}");
        }
        else
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
            Snackbar.Add("Username and/or password is incorrect", Severity.Error);
        }
    }
}