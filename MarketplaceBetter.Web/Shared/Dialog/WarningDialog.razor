<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Warning</MudText>
    </TitleContent>
    <DialogContent>
        @Warning
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Warning { get; set; }

    void Submit() => MudDialog.Close();
}
