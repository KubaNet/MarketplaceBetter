<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Please confirm</MudText>
    </TitleContent>
    <DialogContent>
        @((MarkupString)Question)
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="Processing" OnClick="Cancel">Cancel</MudButton>
        <MudButton @ref="SubmitButton" Disabled="Processing" OnClick="Submit" Color="Color.Primary">
            @if (Processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            Yes
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Question { get; set; }

    private MudButton SubmitButton;
    private bool Processing = false;

    protected override async void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        await SubmitButton.FocusAsync();
    }

    private async void Submit()
    {
        Processing = true;

        await Task.Delay(100);

        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
