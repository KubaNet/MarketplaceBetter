<MudDialog Style="min-width: 500px;">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @ChildContent
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="FormButtonsDisabled">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="FormButtonsDisabled">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [CascadingParameter] bool FormButtonsDisabled { get; set; }
    [Parameter] public string Title { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }

    void Cancel() => MudDialog.Cancel();
}