@using MarketplaceBetter.Domain.Model.Catalog.Products
<MudDialog Style="min-width: 500px;">
    <TitleContent>
        <MudText Typo="Typo.h6">Go to and filter for <span class="mud-primary-text">@Product.Name</span></MudText>
    </TitleContent>
    <DialogContent>
        <MudList Clickable="true">
            <MudListItem Text="Catalog" InitiallyExpanded="true">
                <NestedList>
                    <MudListItem Text="Product Colors" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@ProductColorsLink" />
                    <MudListItem Text="Variants" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@VariantsLink" />
                </NestedList>
            </MudListItem>
            <MudListItem Text="Amazon" InitiallyExpanded="true">
                <NestedList>
                    <MudListItem Text="Parents" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@ParentsLink" />
                    <MudListItem Text="Parent Instances" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@ParentInstancesLink" />
                    <MudListItem Text="Childs" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@ChildsLink" />
                    <MudListItem Text="Child Instances" Icon="@Icons.Material.Filled.Send" IconColor="Color.Primary" Href="@ChildInstancesLink" />
                </NestedList>
            </MudListItem>
        </MudList>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public ProductModel Product { get; set; }

    private string ProductColorsLink;
    private string VariantsLink;
    private string ParentsLink;
    private string ParentInstancesLink;
    private string ChildsLink;
    private string ChildInstancesLink;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProductColorsLink = $"product-colors?productId={Product.Id}";
        VariantsLink = $"variants?productId={Product.Id}";
        ParentsLink = $"parents?productId={Product.Id}";
        ParentInstancesLink = $"parent-instances?productId={Product.Id}";
        ChildsLink = $"childs?productId={Product.Id}";
        ChildInstancesLink = $"child-instances?productId={Product.Id}";
    }
}