<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <StartupObject>MarketplaceBetter.Web.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\_templates\**\*" />
    <Content Include="wwwroot\_templates\_placeholder.txt" />
  </ItemGroup>

  <ItemGroup>
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\Test_PublishProfile.pubxml" />
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\Prod_PublishProfile.pubxml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="MudBlazor" Version="6.3.1" />
    <PackageReference Include="TinyMCE" Version="6.4.2" />
    <PackageReference Include="TinyMCE.Blazor" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketplaceBetter.Domain\MarketplaceBetter.Domain.csproj" />
    <ProjectReference Include="..\MarketplaceBetter.Infrastructure\MarketplaceBetter.Infrastructure.csproj" />
    <ProjectReference Include="..\MarketplaceBetter.Services\MarketplaceBetter.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\_templates\" />
  </ItemGroup>

</Project>
